# Python Bytecode and Caches
__pycache__/
*.py[cod]
*$py.class

# Compiled Objects and Binaries
*.o
*.obj
a.out
core.[0-9]*

# Ignore compiled shared libraries
*.so

# Editor and OS Artifacts
*~
*.swp
*.swo
.#*
.DS_Store
Thumbs.db

# Workspace Runtime State (Preserve Structural .gitkeep)
workspace/rendu/*
!workspace/rendu/.gitkeep
workspace/subject/*
!workspace/subject/.gitkeep
workspace/traces/
workspace/*.json
workspace/.xp_ledger.json*
workspace/.*.lock
workspace/vogsphere.git/

# Vogsphere Runtime Bare Repositories
vogsphere/*
!vogsphere/.gitkeep
build/
