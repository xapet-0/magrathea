            "Invalid shebang format (no leading spaces, max 1 option allowed)"
        ),
        explanation="No whitespace is permitted before or between '#' and '!', and at most one interpreter option is allowed on the shebang line.",
        bad_example="  #! /bin/sh -e -u",
        good_example="#!/bin/sh",
    ),
    "MISSING_STRICT_MODE": RuleSpec(
        code="MISSING_STRICT_MODE",
