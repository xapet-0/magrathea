        summary=(
            "First line must be #!/bin/sh (or #!/bin/bash) at line 1, col 1"
        ),
        explanation="The first line of the script (line 1, column 1 with no leading whitespace) must be #!/bin/sh (or #!/bin/bash) so the operating system kernel identifies the standard command interpreter.",
        bad_example="echo 'hello'",
        good_example="#!/bin/sh\nprintf 'hello\\n'",
    ),
    "SHEBANG_FORMAT": RuleSpec(
