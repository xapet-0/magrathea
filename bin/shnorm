        summary=(
            "Unquoted variable expansion undergoes field splitting and globbing"
        ),
        explanation="Unquoted variable expansions undergo word splitting and pathname expansion (globbing). Always double-quote variables as \"$var\"",
        bad_example="cp -- $src_file $dst_file",
        good_example="cp -- \"$src_file\" \"$dst_file\"",
    ),
    "UNQUOTED_CMD_SUB": RuleSpec(
