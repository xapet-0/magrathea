        standard_ref="42 Norm v4.1 Section IV",
        summary="Function body exceeds 25 lines maximum limit",
        explanation="Functions must not exceed 25 lines. Decompose large functions into smaller modular helpers performing a single responsibility.",
        bad_example="big_func() {\n    # 30 lines of code...\n}",
