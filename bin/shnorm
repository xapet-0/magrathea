        standard_ref="POSIX.1-2024 Sec 2.6.3 / ShellCheck SC2046",
        summary="Unquoted command substitution $(...) undergoes word splitting",
        explanation="Command substitutions must be enclosed in double quotes \"$(cmd)\" to prevent field splitting on whitespace.",
        bad_example="rm -- $(find . -name '*.tmp')",
        good_example="find . -name '*.tmp' -exec rm -- {} +",
    ),
    "UNBRACED_CONCAT": RuleSpec(
