        standard_ref="Google Shell Style Guide Rule 6-2",
        summary="Unnecessary semicolon ';' at end of line",
        explanation="Semicolons at the end of lines are redundant in shell; use semicolons only before 'then' or 'do' on the same line.",
        bad_example="name='marvin';\nprintf '%s\\n' \"$name\";",
        good_example="name='marvin'\nprintf '%s\\n' \"$name\"",
