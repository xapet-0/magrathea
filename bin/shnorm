        ),
        explanation="Indentation must strictly consist of multiples of 4 spaces. Mixing tabs and spaces is strictly prohibited.",
        bad_example="if [ -f \"$1\" ]; then\n  printf 'ok\\n'\nfi",
        good_example="if [ -f \"$1\" ]; then\n    printf 'ok\\n'\nfi",
    ),
    "ASSIGN_SPACE": RuleSpec(
