        summary=(
            "Use braces \"${var}\" when concatenating variables with strings"
        ),
        explanation="When concatenating variable expansions with adjacent text or underscores, enclose the variable in braces: \"${prefix}_file\"",
        bad_example="file_name=\"$prefix_report.txt\"",
        good_example="file_name=\"${prefix}_report.txt\"",
    ),
    "POSITIONAL_NO_BRACES": RuleSpec(
