"""
sh_norminette — The Official 42/1337 Shell Norm Linter (Sh-Norm v4.2)

Built upon the 5 Authoritative International Shell & Unix Standards:
  1. IEEE Std 1003.1-2024 (POSIX.1-2024 Chapter 2: Shell Command Language)
  2. IEEE Std 1003.1-2024 (POSIX.1-2024 Chapter 12: Utility Syntax Guidelines)
  3. Dr. David A. Wheeler — Filenames and Pathnames in Shell
  4. Google Shell Style Guide (SRE Specification Rules 1-1 to 10-3)
  5. ShellCheck Static Analysis Rulebook (SC1000 - SC2315) & 42 Norm v4.1

Usage:
  python3 sh_norminette.py [options] <file_or_dir> ...
  python3 sh_norminette.py --explain <ERROR_CODE>
  python3 sh_norminette.py --list-rules
  python3 sh_norminette.py --generate-header <file.sh>
"""

import argparse
from dataclasses import dataclass
import pathlib
import re
import sys
from typing import Dict, List, Optional, Tuple


# ============================================================================ #
# 1. RULE REGISTRY & PEDAGOGICAL DOCUMENTATION (EN + AR/DARIJA)
# ============================================================================ #


@dataclass(frozen=True)
class RuleSpec:
  code: str
  chapter: str
  standard_ref: str
  summary: str
  explanation: str
  bad_example: str
  good_example: str


RULES_DB: Dict[str, RuleSpec] = {
