        explanation="The '[' utility is a command in POSIX (synonymous with test); spaces are mandatory immediately after '[' and before ']'.",
        bad_example="if [\"$a\" = \"$b\"]; then",
        good_example="if [ \"$a\" = \"$b\" ]; then",
    ),
    "USELESS_SEMICOLON": RuleSpec(
