        chapter="SH-IV.2",
        standard_ref="POSIX.1-2024 Sec 2.5.1 / ShellCheck SC1037",
        summary=(
            "Positional parameters >= 10 must use braces (e.g. \"${10}\")"
        ),
        explanation="Positional parameters greater than or equal to 10 must use braces, e.g., \"${10}\", otherwise \"$10\" expands to \"$1\" followed by literal '0'.",
        bad_example="printf '%s\\n' \"$10\"",
        good_example="printf '%s\\n' \"${10}\"",
    ),
    "UNQUOTED_AT_STAR": RuleSpec(
        code="UNQUOTED_AT_STAR",
