COOLDOWN_STATE_FILE = KIT_ROOT / "workspace" / ".moulinette_cooldown.json"
DEFAULT_COOLDOWN_STEP = int(os.environ.get("MOULINETTE_COOLDOWN_STEP", "30"))


def _load_moulinette_cooldown() -> dict[str, Any]:
    if COOLDOWN_STATE_FILE.is_file():
        try:
            data = json.loads(COOLDOWN_STATE_FILE.read_text(encoding="utf-8"))
            if isinstance(data, dict):
                data.setdefault("enabled", False)
                data.setdefault("step_sec", DEFAULT_COOLDOWN_STEP)
                return data
        except Exception:
            pass
    return {"enabled": False, "step_sec": DEFAULT_COOLDOWN_STEP, "attempts": {}, "next_grademe_ts": 0.0, "last_subject": "", "last_penalty_sec": 0}


def _save_moulinette_cooldown(state: dict[str, Any]) -> None:
    try:
        COOLDOWN_STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
        tmp = COOLDOWN_STATE_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps(state, indent=2), encoding="utf-8")
        os.replace(tmp, COOLDOWN_STATE_FILE)
    except OSError:
        pass


def get_moulinette_cooldown_remaining() -> tuple[int, dict[str, Any]]:
    st = _load_moulinette_cooldown()
    if os.environ.get("MOULINETTE_DISABLE_COOLDOWN") == "1":
        return 0, st
    force_on = os.environ.get("MOULINETTE_ENABLE_COOLDOWN") == "1"
    if not st.get("enabled", False) and not force_on:
        return 0, st
    rem = float(st.get("next_grademe_ts", 0.0)) - time.time()
    return max(0, int(round(rem))), st


def record_moulinette_attempt_result(rel_subj: str, passed: bool, status_str: str, *, is_self_test: bool = False, is_practice: bool = False) -> int:
    """Update Moulinette cooldown state after grading ONLY when cooldown is enabled via `cooldown on` / `--cooldown`."""
    if is_self_test or os.environ.get("MOULINETTE_DISABLE_COOLDOWN") == "1":
        return 0
    if "Nothing turned in" in status_str:
        return 0
    st = _load_moulinette_cooldown()
    force_on = os.environ.get("MOULINETTE_ENABLE_COOLDOWN") == "1"
    if not st.get("enabled", False) and not force_on:
        return 0
    step_s = int(st.get("step_sec") or DEFAULT_COOLDOWN_STEP)
    attempts_map = st.setdefault("attempts", {})
    if passed:
        attempts_map[rel_subj] = 0
        st["next_grademe_ts"] = 0.0
        st["last_penalty_sec"] = 0
        st["last_subject"] = rel_subj
        _save_moulinette_cooldown(st)
        return 0
    cur_att = int(attempts_map.get(rel_subj, 0)) + 1
    attempts_map[rel_subj] = cur_att
    pen = cur_att * step_s
    st["next_grademe_ts"] = time.time() + pen
    st["last_penalty_sec"] = pen
    st["last_subject"] = rel_subj
    _save_moulinette_cooldown(st)
    return pen



DEFAULT_LOGIN = os.environ.get("USER") or os.environ.get("LOGNAME") or "student"
_YAML_LOADER = getattr(yaml, "CSafeLoader", yaml.SafeLoader)

# Regex matching non-printing ANSI SGR/control sequences
_ANSI_SEQ_RE = re.compile(r"(\x1b\[[0-9;?]*[a-zA-Z])+")
# Regex to strip module prefixes from directory names (e.g. c00_ft_putchar -> ft_putchar)
_MODULE_PREFIX_RE = re.compile(r"^(?:c\d{2}|shell\d{2}|rush\w*)_")
# Temporary editor swap files to ignore during --watch
_IGNORED_WATCH_SUFFIXES = (".swp", ".swo", ".swn", ".tmp", ".bak", "~")


def fast_load_yaml(path: Path) -> dict[str, Any]:
    if not path.is_file():
        return {}
    try:
        data = yaml.load(path.read_text(encoding="utf-8", errors="replace"), Loader=_YAML_LOADER)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def tilde_path(p: Path | str) -> str:
    """Format an absolute path using UNIX '~' shorthand for $HOME (e.g. ~/Downloads/...)."""
    try:
        resolved = str(Path(p).expanduser().resolve())
    except Exception:
        resolved = str(p)
    home = str(Path.home())
    if resolved == home:
        return "~"
    if resolved.startswith(home + "/"):
        return "~" + resolved[len(home):]
    return resolved


def rl_safe_prompt(prompt_text: str) -> str:
    """Wrap ANSI escape sequences in \x01 and \x02 using a callable (Python 3.14 safe) so GNU Readline calculates width accurately."""
    if not sys.stdin.isatty() or readline is None:
        return prompt_text
    return _ANSI_SEQ_RE.sub(lambda m: "\x01" + m.group(0) + "\x02", prompt_text)


@contextlib.contextmanager
def interactive_terminal_screen(enabled: bool = True) -> Iterator[None]:
    """
    Use Alternate Screen Buffer (\033[?1049h / \033[?1049l) for interactive sessions unless disabled.
    Guarantees a 100% clean viewport locked at Row 1 without wiping prior shell scrollback history.
    """
    use_alt = (
        enabled
        and sys.stdout.isatty()
        and not os.environ.get("MOULINETTE_NO_CLEAR")
        and os.environ.get("TERM", "dumb") != "dumb"
    )
    if use_alt:
        sys.stdout.write(
            "\033[?1049h\033[?1007l\033[H\033[2J"
            "\033]0;moulinette — 42 / 1337 Deepthought Grader\007"
        )
        sys.stdout.flush()
    try:
        yield
    finally:
        if use_alt:
            sys.stdout.write("\033[?1007h\033[?1049l\033]0;\007")
            sys.stdout.flush()


def clear_viewport() -> None:
    """Clear current visible screen viewport cleanly and move cursor home (Row 1, Col 1)."""
    if sys.stdout.isatty() and not os.environ.get("MOULINETTE_NO_CLEAR"):
        sys.stdout.write("\033[H\033[2J")
        sys.stdout.flush()


def parse_subject_disk_metadata(subject_file: Path) -> dict[str, str]:
    """Extract expected_files, allowed_functions, and prototype directly from subject.en.txt header lines."""
    info: dict[str, str] = {
        "assignment_name": subject_file.parent.name,
        "expected_files": f"{_MODULE_PREFIX_RE.sub('', subject_file.parent.name)}.c",
        "allowed_functions": "None",
        "prototype": "None",
    }
    if not subject_file.is_file():
        return info

    text = subject_file.read_text(encoding="utf-8", errors="replace")
    for line in text.splitlines():
        stripped = line.strip()
        m_assign = re.match(r"^Assignment name\s*:\s*(.+)$", stripped, re.IGNORECASE)
        if m_assign:
            info["assignment_name"] = m_assign.group(1).strip()
            continue
        m_files = re.match(r"^(?:Expected files|Files to turn in)\s*:\s*(.+)$", stripped, re.IGNORECASE)
        if m_files:
            info["expected_files"] = m_files.group(1).strip()
            continue
        m_funcs = re.match(r"^Allowed (?:functions|commands)\s*:\s*(.+)$", stripped, re.IGNORECASE)
        if m_funcs:
            info["allowed_functions"] = m_funcs.group(1).strip()
            continue
        if info["prototype"] == "None" and re.match(
            r"^(?:void|int|char|unsigned|size_t|long|short|float|double|struct\s+\w+|t_\w+)\s+[\*\s]*\w+\s*\([^;]*\)\s*;$",
            stripped,
        ):
            info["prototype"] = " ".join(stripped.split())
    return info


def build_42_header(filename: str, login: str = DEFAULT_LOGIN) -> str:
    now_s = dt.datetime.now().strftime("%Y/%m/%d %H:%M:%S")
    fn_pad = f"{filename[:41]:<41}"
    lg_pad = f"{login[:8]:<8}"
    by_pad = f"By: {login} <{login}@student.1337.ma>"
    by_line = f"/*   {by_pad:<47}+#+  +:+       +#+        */"
    cr_line = f"/*   Created: {now_s} by {lg_pad}          #+#    #+#             */"
    up_line = f"/*   Updated: {now_s} by {lg_pad}         ###   ########.fr       */"
    return "\n".join(
        [
            "/* ************************************************************************** */",
            "/*                                                                            */",
            "/*                                                        :::      ::::::::   */",
            f"/*   {fn_pad}          :+:      :+:    :+:   */",
            "/*                                                    +:+ +:+         +:+     */",
            by_line,
            "/*                                                +#+#+#+#+#+   +#+           */",
            cr_line,
            up_line,
            "/*                                                                            */",
            "/* ************************************************************************** */",
            "",
        ]
    )


def get_piscine_modules() -> set[str]:
    piscine_dir = KIT_ROOT / "pools" / "piscine"
    if not piscine_dir.is_dir():
        return set()
    return {p.stem for p in piscine_dir.glob("*.yml")}


def resolve_piscine_or_exam_subject(subject: str, prefer_exam: bool = False) -> tuple[str, bool]:
    """Resolve bare exercise names (e.g. 'ft_strlen' or 'c01/ft_strlen') to Piscine first by default, or Exam first when prefer_exam=True."""
    clean_subj = subject.strip().strip("/")
    if (KIT_ROOT / "subjects" / clean_subj).exists():
        is_exam = clean_subj.startswith("exams/")
        return clean_subj, is_exam
    if prefer_exam and (KIT_ROOT / "subjects" / "exams" / clean_subj).exists():
        return f"exams/{clean_subj}", True
    if (KIT_ROOT / "subjects" / "piscine" / clean_subj).exists():
        return f"piscine/{clean_subj}" if not clean_subj.startswith("piscine/") else clean_subj, False

    piscine_root = KIT_ROOT / "subjects" / "piscine"
    if "/" in clean_subj:
        mod_part, ex_part = clean_subj.split("/", 1)
        prefixed_candidate = piscine_root / mod_part / f"{mod_part}_{ex_part}"
        if prefixed_candidate.exists():
            return str(prefixed_candidate.relative_to(KIT_ROOT / "subjects")), False

    piscine_matches = sorted(piscine_root.glob(f"*/{clean_subj}"))
    if not piscine_matches:
        piscine_matches = sorted(piscine_root.glob(f"*/*_{clean_subj}"))
    if piscine_matches:
        rel = piscine_matches[0].relative_to(KIT_ROOT / "subjects")
        return str(rel), False

    if (KIT_ROOT / "subjects" / "exams" / clean_subj).exists():
        return f"exams/{clean_subj}", True
    return clean_subj, False


def resolve_submission_dir(explicit_dir: str | None, slug_leaf: str, resolved_subject: str = "") -> Path:
    if explicit_dir is not None:
        return Path(explicit_dir).expanduser().resolve()
    cwd = Path.cwd().resolve()
    is_kit_root = (cwd == KIT_ROOT.resolve())

    if not is_kit_root:
        if (cwd / f"{slug_leaf}.c").exists() or (cwd / f"{slug_leaf}.sh").exists() or (cwd / f"{slug_leaf}.h").exists():
            return cwd
        if (cwd / slug_leaf).is_dir():
            return (cwd / slug_leaf).resolve()
        for ex_dir in sorted(cwd.glob("ex[0-9][0-9]")):
            if (ex_dir / f"{slug_leaf}.c").exists() or (ex_dir / f"{slug_leaf}.sh").exists() or (ex_dir / f"{slug_leaf}.h").exists():
                return ex_dir.resolve()

    if resolved_subject:
        ws_piscine = KIT_ROOT / "workspace" / resolved_subject
        if ws_piscine.is_dir():
            return ws_piscine.resolve()
        parts = Path(resolved_subject).parts
        if len(parts) >= 3 and parts[0] == "piscine":
            mod_ws = KIT_ROOT / "workspace" / "piscine" / parts[1]
            if mod_ws.is_dir():
                for ex_dir in sorted(mod_ws.glob("ex[0-9][0-9]")):
                    if (ex_dir / f"{slug_leaf}.c").exists() or (ex_dir / f"{slug_leaf}.sh").exists() or (ex_dir / f"{slug_leaf}.h").exists():
                        return ex_dir.resolve()

    exam_rendu = Path.home() / "exam-basedir" / "rendu" / slug_leaf
    if exam_rendu.is_dir():
        return exam_rendu.resolve()
    ws_rendu = KIT_ROOT / "workspace" / "rendu" / slug_leaf
    if ws_rendu.is_dir():
        return ws_rendu.resolve()

    if is_kit_root:
        target_rel = resolved_subject if resolved_subject else f"rendu/{slug_leaf}"
        return (KIT_ROOT / "workspace" / target_rel).resolve()
    return cwd


def render_five_gate_scorecard(report: GradeReport, theme: ThemeEngine, is_exam: bool = False, norm_enabled: bool = False) -> str:
    st = report.status
    g1_fail = "Nothing turned in" in st or "main() in function" in st or "Extraneous file" in st
    g2_fail = "Cheating" in st or "Norme error" in st
    g3_fail = st == "Does not compile" or "Makefile" in st
    g4_fail = any(k in st for k in ("Segmentation fault", "Bus error", "Abort", "Floating point", "Timeout", "Output limit", "Redzone KO", "Leak KO", "Free KO", "Strict KO", "Exit 42", "Exit 43"))
    g5_fail = not report.passed and not (g1_fail or g2_fail or g3_fail or g4_fail)

    norm_tag = " + norminette" if (not is_exam or norm_enabled) else ""
    gates = [
        ("gate 1", "turn-in files & entry point", not g1_fail, g1_fail),
        ("gate 2", f"elf symbol whitelist (nm -u){norm_tag}", not (g1_fail or g2_fail), g2_fail),
        ("gate 3", "strict compilation (cc -Wall -Wextra -Werror)", not (g1_fail or g2_fail or g3_fail), g3_fail),
        ("gate 4", "process sandbox & signal isolation", not (g1_fail or g2_fail or g3_fail or g4_fail), g4_fail),
        ("gate 5", "deepthought torture matrix & cat -e diff", report.passed, g5_fail),
    ]
    lines = [f"{theme.c('===>', 'accent', 'bold')} {theme.bold('5-gate moulinette pipeline')}"]
    stopped = False
    for g_id, g_desc, is_ok, is_fail in gates:
        dots = "." * max(2, 48 - len(g_desc))
        if stopped:
            status_s = theme.c("SKIP", "muted")
        elif is_fail:
            status_s = f"{theme.c('KO', 'err', 'bold')} ({st})"
            stopped = True
        elif is_ok:
            status_s = theme.c("OK", "ok", "bold")
        else:
            status_s = theme.c("SKIP", "muted")
        lines.append(f"  {theme.c(g_id, 'muted')}  {g_desc} {theme.c(dots, 'muted')} {status_s}")
    return "\n".join(lines)


def colorize_trace(trace_text: str, theme: ThemeEngine) -> str:
    if theme.name == "plain":
        return trace_text
    out: list[str] = []
    for line in trace_text.splitlines():
        if line.startswith("= ") and line.endswith("="):
            if "Final grade: 100" in line:
                out.append(theme.c(line, "ok", "bold"))
            elif "Final grade: 0" in line or "Final grade: -42" in line:
                out.append(theme.c(line, "err", "bold"))
            else:
                out.append(theme.c(line, "primary", "bold"))
        elif line.startswith(">>>>>>>>>> FAILURE") or "Cheating (-42)" in line or "Diff KO :(" in line or "Norme error" in line:
            out.append(theme.c(line, "err", "bold"))
        elif "Diff OK :D" in line or line == "OK" or line.endswith(": OK!"):
            out.append(theme.c(line, "ok", "bold"))
        elif line.startswith("$> "):
            out.append(theme.c(line, "accent"))
        elif line.startswith("+") and not line.startswith("+++"):
            out.append(theme.c(line, "ok"))
        elif line.startswith("-") and not line.startswith("---"):
            out.append(theme.c(line, "err"))
        else:
            out.append(line)
    return "\n".join(out)


def _format_preview_exercises(exs: list[str], max_width: int = 62) -> str:
    cleaned = [_MODULE_PREFIX_RE.sub("", e) for e in exs]
    shown: list[str] = []
    cur_len = 0
    for idx, name in enumerate(cleaned):
        rem = len(cleaned) - idx
        suffix = f" (+{rem} more)" if rem > 0 else ""
        add_len = len(name) + (2 if shown else 0)
        if shown and (cur_len + add_len + len(suffix) > max_width or len(shown) >= 4):
            return ", ".join(shown) + f" (+{rem} more)"
        shown.append(name)
        cur_len += add_len
    return ", ".join(shown)


_EXAM_TRACK_ALIASES = {
    "exam00": "c_piscine_exam_00",
    "exam_00": "c_piscine_exam_00",
    "exam01": "c_piscine_exam_01",
    "exam_01": "c_piscine_exam_01",
    "exam02": "c_piscine_exam_02",
    "exam_02": "c_piscine_exam_02",
    "examfinal": "c_piscine_final_exam",
    "exam_final": "c_piscine_final_exam",
    "final": "c_piscine_final_exam",
    "rank2": "rank02",
    "rank3": "rank03",
    "rank4": "rank04",
    "rank5": "rank05",
    "rank6": "rank06",
    "exam_rank_02": "rank02",
    "exam_rank_03": "rank03",
    "exam_rank_04": "rank04",
    "exam_rank_05": "rank05",
    "exam_rank_06": "rank06",
}


def resolve_exam_track_name(name: str) -> str | None:
    low = name.strip().lower()
    mapped = _EXAM_TRACK_ALIASES.get(low, low)
    if (KIT_ROOT / "pools" / "exams" / f"{mapped}.yml").is_file():
        return mapped
    return None


