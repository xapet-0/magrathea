DEFAULT_LOGIN = os.environ.get("USER") or os.environ.get("LOGNAME") or "student"

# Regex matching non-printing ANSI SGR/control sequences
_ANSI_SEQ_RE = re.compile(r"(\x1b\[[0-9;?]*[a-zA-Z])+")
# Regex to strip module prefixes from directory names (e.g. c00_ft_putchar -> ft_putchar)
_MODULE_PREFIX_RE = re.compile(r"^(?:c\d{2}|shell\d{2}|rush\w*)_")
# Temporary editor swap files to ignore during --watch
_IGNORED_WATCH_SUFFIXES = (".swp", ".swo", ".swn", ".tmp", ".bak", "~")


def fast_load_yaml(path: Path) -> dict[str, Any]:
    """Load a YAML file into a dictionary with size/depth/alias guards."""
    data = _safe_load_yaml(path)
    if "__yaml_error__" in data:
        return {}
    return data


def rl_safe_prompt(prompt_text: str) -> str:
    r"""Wrap ANSI escape sequences in \x01 and \x02 using a callable (Python 3.14 safe) so GNU Readline calculates width accurately."""
    if not sys.stdin.isatty() or readline is None:
        return prompt_text
    return _ANSI_SEQ_RE.sub(lambda m: "\x01" + m.group(0) + "\x02", prompt_text)


def interactive_terminal_screen(enabled: bool = True) -> ViewportSession:
    """Return an examshell-style bounded alternate-screen viewport session."""
    return ViewportSession(enabled=enabled)


def clear_viewport() -> None:
    """Clear current viewport via ANSI home+erase when stdout is an interactive non-dumb TTY."""
    if (
        not sys.stdout.isatty()
        or os.environ.get("TERM", "dumb") == "dumb"
        or os.environ.get("MOULINETTE_NO_CLEAR")
    ):
        return
    sys.stdout.write("\033[H\033[2J")
    sys.stdout.flush()


def _run_subprocess(cmd: list[str]) -> int:
    """Run a child process directly, or capture its output when stdout is redirected into the viewport."""
    if sys.stdout is sys.__stdout__:
        return subprocess.call(cmd)
    proc = subprocess.run(
        cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, check=False
    )
    if proc.stdout:
        sys.stdout.write(proc.stdout)
    return proc.returncode


def _emit_with_pager(text: str, use_pager: bool = False) -> None:
    """Print text directly, or pipe through $PAGER ('less -FR') when use_pager=True on a live uncaptured TTY."""
    if (
        use_pager
        and sys.stdin.isatty()
        and sys.stdout is sys.__stdout__
        and sys.stdout.isatty()
        and os.environ.get("TERM", "dumb") != "dumb"
    ):
        pager = shlex.split(os.environ.get("PAGER", "").strip() or "less -FR")
        if pager and shutil.which(pager[0]):
            try:
                subprocess.run(pager, input=text, text=True, check=False)
                return
            except OSError:
                pass
    if text:
        print(text, end="" if text.endswith("\n") else "\n")


def parse_subject_disk_metadata(subject_file: Path) -> dict[str, str]:
    """Extract expected_files, allowed_functions, and prototype directly from subject.en.txt header lines."""
    info: dict[str, str] = {
        "assignment_name": subject_file.parent.name,
        "expected_files": f"{_MODULE_PREFIX_RE.sub('', subject_file.parent.name)}.c",
        "allowed_functions": "None",
        "prototype": "None",
    }
    if not subject_file.is_file():
        return info

    text = subject_file.read_text(encoding="utf-8", errors="replace")
    for line in text.splitlines():
        stripped = line.strip()
        m_assign = re.match(r"^Assignment name\s*:\s*(.+)$", stripped, re.IGNORECASE)
        if m_assign:
            info["assignment_name"] = m_assign.group(1).strip()
            continue
        m_files = re.match(
            r"^(?:Expected files|Files to turn in)\s*:\s*(.+)$", stripped, re.IGNORECASE
        )
        if m_files:
            info["expected_files"] = m_files.group(1).strip()
            continue
        m_funcs = re.match(
            r"^Allowed (?:functions|commands)\s*:\s*(.+)$", stripped, re.IGNORECASE
        )
        if m_funcs:
            info["allowed_functions"] = m_funcs.group(1).strip()
            continue
        if info["prototype"] == "None" and re.match(
            r"^(?:void|int|char|unsigned|size_t|long|short|float|double|struct\s+\w+|t_\w+)\s+[\*\s]*\w+\s*\([^;]*\)\s*;$",
            stripped,
        ):
            info["prototype"] = " ".join(stripped.split())
    return info


def _norm_visual_width(line: str) -> int:
    """Width of a line as the Norm counts it: a tab goes to the next multiple of 4."""
    width = 0
    for ch in line:
        width = (width // 4 + 1) * 4 if ch == "\t" else width + 1
    return width


def norm_function_stubs(prototype: str) -> str:
    """Empty functions for a meta.yml prototype, written the way the norminette accepts them.

    One tab before the function name, nothing inside the body, a line break after a parameter when
    the line would pass 80 columns, and one function per prototype ('int match(...); int nmatch(...);').
    """
    stubs: list[str] = []
    for one in (part.strip() for part in prototype.split(";")):
        if not one:
            continue
        m = re.match(r"^(.+?)[ \t]+(\**[A-Za-z_]\w*\s*\(.*)$", one)
        lines = [f"{m.group(1)}\t{m.group(2)}" if m else one]
        while _norm_visual_width(lines[-1]) > 80:
            line, depth, cut = lines[-1], 0, -1
            for idx, ch in enumerate(line):
                depth += (ch == "(") - (ch == ")")
                if (
                    ch == ","
                    and depth == 1
                    and _norm_visual_width(line[: idx + 1]) <= 80
                ):
                    cut = idx
            if cut < 0:
                break
            lines[-1:] = [line[: cut + 1], "\t\t" + line[cut + 1 :].lstrip()]
        stubs.append("\n".join(lines) + "\n{\n}\n")
    return "\n".join(stubs)


def build_42_header(filename: str, login: str = DEFAULT_LOGIN) -> str:
    """Generate a 42-formatted C comment header for filename and login."""
    now_s = dt.datetime.now().strftime("%Y/%m/%d %H:%M:%S")
    fn_pad = f"{filename[:41]:<41}"
    lg_pad = f"{login[:8]:<8}"
    by_login = login[
        :12
    ]  # a longer login would push the line past 80 columns (Norm: INVALID_HEADER)
    by_pad = f"By: {by_login} <{by_login}@student.1337.ma>"
    by_line = f"/*   {by_pad:<47}+#+  +:+       +#+        */"
    cr_line = f"/*   Created: {now_s} by {lg_pad}          #+#    #+#             */"
    up_line = f"/*   Updated: {now_s} by {lg_pad}         ###   ########.fr       */"
    return "\n".join(
        [
            "/* ************************************************************************** */",
            "/*                                                                            */",
            "/*                                                        :::      ::::::::   */",
            f"/*   {fn_pad}          :+:      :+:    :+:   */",
            "/*                                                    +:+ +:+         +:+     */",
            by_line,
            "/*                                                +#+#+#+#+#+   +#+           */",
            cr_line,
            up_line,
            "/*                                                                            */",
            "/* ************************************************************************** */",
            "",
        ]
    )


def get_piscine_modules() -> set[str]:
    """Return the set of available Piscine module slugs."""
    piscine_dir = KIT_ROOT / "pools" / "piscine"
    if not piscine_dir.is_dir():
        return set()
    return {p.stem for p in piscine_dir.glob("*.yml")}


def ensure_workspace_directories() -> None:
    """Create empty workspace directories + exNN symlinks for all piscine exercises (no files copied)."""
    piscine_dir = KIT_ROOT / "pools" / "piscine"
    if not piscine_dir.is_dir():
        return
    ws_piscine = KIT_ROOT / "workspace" / "piscine"
    for pool_file in sorted(piscine_dir.glob("*.yml")):
        mod = pool_file.stem
        mod_dir = ws_piscine / mod
        try:
            mod_dir.mkdir(parents=True, exist_ok=True)
            data = fast_load_yaml(pool_file)
            for idx, ex in enumerate(data.get("exercises") or []):
                raw_id = (
                    (ex.get("subject_id") or ex.get("id") or "")
                    if isinstance(ex, dict)
                    else str(ex)
                )
                ex_id = Path(raw_id).name
                ex_code = (
                    ex.get("ex", f"ex{idx:02d}")
                    if isinstance(ex, dict)
                    else f"ex{idx:02d}"
                )
                (mod_dir / ex_id).mkdir(parents=True, exist_ok=True)
                ex_link = mod_dir / ex_code
                if not ex_link.exists():
                    ex_link.symlink_to(ex_id)
        except OSError:
            pass


class ExerciseLookupError(Exception):
    """An exercise name that cannot be honoured as typed. str(exc) is the message shown to the student."""


_FORBIDDEN_NAME_CHARS = frozenset("*?[]\\\x00\n\r")


def _is_exercise_dir(path: Path) -> bool:
    """An exercise is a subject directory that carries a meta.yml; module folders, PDFs and stray files are not."""
    return (path / "meta.yml").is_file()


def normalise_exercise_name(subject: str) -> str:
    """Canonical form of what the student typed: no empty parts, no '.', no '..', no glob characters."""
    raw = str(subject).strip()
    parts = [part for part in raw.split("/") if part]
    if not parts:
        raise ExerciseLookupError("Empty exercise name.")
    if any(part in {".", ".."} for part in parts) or any(
        ch in _FORBIDDEN_NAME_CHARS for ch in raw
    ):
        raise ExerciseLookupError(
            f"Invalid exercise name '{raw}'. Names are literal: no '..', no wildcards."
        )
    return "/".join(parts)


def short_exercise_label(resolved: str) -> str:
    """'piscine/c01/c01_ft_strlen' -> 'c01/ft_strlen'; 'exams/ft_range' -> 'exams/ft_range'."""
    parts = Path(resolved).parts
    if len(parts) == 3 and parts[0] == "piscine":
        return f"{parts[1]}/{_MODULE_PREFIX_RE.sub('', parts[2])}"
    return resolved


def _piscine_candidates(name: str) -> tuple[list[str], list[str]]:
    """(exact, prefixed) piscine exercises for a bare name: '<mod>/<name>' and '<mod>/<mod>_<name>'."""
    piscine_root = KIT_ROOT / "subjects" / "piscine"
    exact: list[str] = []
    prefixed: list[str] = []
    if piscine_root.is_dir():
        for mod_dir in sorted(p for p in piscine_root.iterdir() if p.is_dir()):
            if _is_exercise_dir(mod_dir / name):
                exact.append(f"piscine/{mod_dir.name}/{name}")
            elif _is_exercise_dir(mod_dir / f"{name}.sh"):
                exact.append(f"piscine/{mod_dir.name}/{name}.sh")
            elif _is_exercise_dir(mod_dir / f"{mod_dir.name}_{name}"):
                prefixed.append(f"piscine/{mod_dir.name}/{mod_dir.name}_{name}")
    return exact, prefixed


def resolve_piscine_or_exam_subject(
    subject: str, prefer_exam: bool = False
) -> tuple[str, bool]:
    """Resolve what the student typed to exactly one exercise.

    Accepted forms: 'piscine/<mod>/<ex>', 'exams/<ex>', '<mod>/<ex>', or a bare '<ex>'.
    A bare name goes to the Piscine first (Exam first when prefer_exam=True). Names are matched whole:
    no partial match, no wildcard. Two exercises with an equal claim on a bare name raise
    ExerciseLookupError instead of one being picked silently. An unknown name is returned unchanged
    (callers check it with _is_exercise_dir).
    """
    clean = normalise_exercise_name(subject)
    subj_root = KIT_ROOT / "subjects"
    parts = clean.split("/")

    if parts[0] == "exams" and len(parts) >= 2:
        return clean, True
    if parts[0] == "piscine" and len(parts) >= 2:
        parts = parts[1:]
        if len(parts) != 2:
            return clean, False
    if len(parts) == 2:
        mod, ex = parts
        for cand in (ex, f"{ex}.sh", f"{mod}_{ex}"):
            if _is_exercise_dir(subj_root / "piscine" / mod / cand):
                return f"piscine/{mod}/{cand}", False
        return clean, False
    if len(parts) > 2:
        return clean, False

    has_exam = _is_exercise_dir(subj_root / "exams" / clean)
    if prefer_exam and has_exam:
        return f"exams/{clean}", True
    for tier in _piscine_candidates(clean):
        if len(tier) == 1:
            return tier[0], False
        if len(tier) > 1:
            choices = ", ".join(short_exercise_label(c) for c in tier)
            raise ExerciseLookupError(
                f"'{clean}' is ambiguous: {choices}. Name the module."
            )
    if has_exam:
        return f"exams/{clean}", True
    return clean, False


def find_exercise_namesakes(resolved: str) -> list[str]:
    """Other exercises that share the bare name of `resolved` (short labels), e.g. c01/ft_strlen, exams/ft_strlen."""
    leaf = _MODULE_PREFIX_RE.sub("", Path(resolved).name)
    exact, prefixed = _piscine_candidates(leaf)
    others = [c for c in (*exact, *prefixed) if c != resolved]
    if (
        _is_exercise_dir(KIT_ROOT / "subjects" / "exams" / leaf)
        and resolved != f"exams/{leaf}"
    ):
        others.append(f"exams/{leaf}")
    return [short_exercise_label(c) for c in others]


def _all_exercise_names() -> list[str]:
    """Every bare exercise name the student can type (short labels)."""
    names: set[str] = set()
    subj = KIT_ROOT / "subjects"
    if (subj / "exams").is_dir():
        names.update(p.name for p in (subj / "exams").iterdir() if _is_exercise_dir(p))
    if (subj / "piscine").is_dir():
        for ex_dir in (subj / "piscine").glob("*/*"):
            if _is_exercise_dir(ex_dir):
                names.add(_MODULE_PREFIX_RE.sub("", ex_dir.name))
    return sorted(names)


def suggest_exercise(target: str, limit: int = 3) -> list[str]:
    """Closest exercise names to what was typed ('did you mean ...?')."""
    import difflib

    clean = str(target).strip().lower().split("/")[-1]
    if not clean:
        return []
    return difflib.get_close_matches(clean, _all_exercise_names(), n=limit, cutoff=0.55)


def resolve_exercise_or_report(
    target: str, theme: ThemeEngine, prefer_exam: bool = False
) -> tuple[str, bool] | None:
    """Resolve an exercise or print one precise error line and return None."""
    try:
        resolved, is_exam = resolve_piscine_or_exam_subject(
            str(target), prefer_exam=prefer_exam
        )
    except ExerciseLookupError as exc:
        print(theme.c(f"Error: {exc}", "err", "bold"))
        return None
    if not _is_exercise_dir(KIT_ROOT / "subjects" / resolved):
        print(theme.c(f"Error: Unknown exercise '{target}'.", "err", "bold"))
        suggestions = suggest_exercise(str(target))
        if suggestions:
            print(theme.c(f"       Did you mean: {', '.join(suggestions)}?", "warn"))
        print(
            theme.c("       Browse with 'list', or type 'help' for commands.", "muted")
        )
        return None
    return resolved, is_exam


def print_guide(theme: ThemeEngine, exercise: str | None = None) -> int:
    """Beginner walkthrough: the whole workflow in plain steps, with real paths."""
    print(
        f"{theme.c('===>', 'accent', 'bold')} {theme.bold('How to work with moulinette (start here)')}"
    )
    print("")
    print(
        theme.c(
            "  You write code in your own folders. Moulinette only reads and grades them.",
            "secondary",
        )
    )
    print("")
    print(theme.c("  1. Read the subject", "primary", "bold"))
    print(
        theme.c(
            "     Type:  subject <exercise>          (example: subject ft_putchar)",
            "secondary",
        )
    )
    print(
        theme.c(
            "     It shows the files to create, the allowed functions, and examples.",
            "muted",
        )
    )
    print("")
    print(theme.c("  2. Create your folder (both workflows work)", "primary", "bold"))
    print(
        theme.c(
            "     Workspace: workspace/piscine/<module>/exNN/ (ready for editing)",
            "secondary",
        )
    )
    print(
        theme.c(
            "     Manual 42: mkdir <module>/<exNN>/<file>   (example: c00/ex00/ft_putchar.c)",
            "secondary",
        )
    )
    print(theme.c("     Exam     : workspace/exams/<exercise>/", "secondary"))
    print(
        theme.c(
            "     Shortcut : init <exercise> creates starter stubs (optional).", "muted"
        )
    )
    print("")
    print(theme.c("  3. Write your code", "primary", "bold"))
    print(
        theme.c(
            "     Edit the file with your editor (vim, emacs, vscode...).", "secondary"
        )
    )
    print(
        theme.c(
            "     Tip: 'watch <exercise>' re-grades automatically every time you save.",
            "muted",
        )
    )
    print("")
    print(theme.c("  4. Grade it", "primary", "bold"))
    print(
        theme.c(
            "     Type:  <exercise>                  (example: ft_putchar)", "secondary"
        )
    )
    print(
        theme.c(
            "     The 5 gates run: files, allowed functions, compilation, safety, tests.",
            "muted",
        )
    )
    print("")
    print(theme.c("  5. Read the result", "primary", "bold"))
    print(
        theme.c(
            "     OK  = validated, XP earned once.  KO = read 'trace' for the full report,",
            "secondary",
        )
    )
    print(theme.c("     fix the first failing gate, then grade again.", "secondary"))
    print("")
    print(
        theme.c(
            "  Stuck? Type 'doctor' to check your setup, 'help' for all commands,",
            "muted",
        )
    )
    print(theme.c("  'list' to browse exercises, 'xp' to see your progress.", "muted"))
    if exercise:
        print("")
        print(theme.c(f"  Your exercise: {exercise}", "accent", "bold"))
        found = resolve_exercise_or_report(exercise, theme)
        if found is not None:
            resolved = found[0]
            leaf = _MODULE_PREFIX_RE.sub("", Path(resolved).name)
            sub_dir = resolve_submission_dir(None, leaf, resolved_subject=resolved)
            try:
                turnin = str(sub_dir.relative_to(KIT_ROOT))
            except ValueError:
                turnin = tilde_path(sub_dir)
            subj_rel = f"subjects/{resolved}/subject.en.txt"
            print(theme.c(f"  Subject : {subj_rel}", "secondary"))
            print(theme.c(f"  Turn-in : {turnin}/", "accent"))
    print("")
    return 0


DoctorCheck = tuple[bool, str, str, bool]


def _probe_tool_group(tools: tuple[str, ...]) -> tuple[list[str], list[str]]:
    """Return ``(present, missing)`` tool names checked via ``shutil.which``."""
    present: list[str] = []
    missing: list[str] = []
    for tool in tools:
        if shutil.which(tool):
            present.append(tool)
        else:
            missing.append(tool)
    return present, missing


def _probe_norminette() -> DoctorCheck:
    """Verify the bundled official 42 norminette CLI executes cleanly."""
    norm_bin = KIT_ROOT / "bin" / "norminette"
    if not norm_bin.is_file():
        return (
            False,
            "bin/norminette: not found",
            "The kit folder looks incomplete; check bin/norminette.",
            False,
        )
    try:
        proc = subprocess.run(
            [sys.executable, str(norm_bin), "--version"],
            capture_output=True,
            text=True,
            timeout=5,
        )
        ver_out = (proc.stdout or "").strip()
        note_err = (proc.stderr or "").strip()
        if proc.returncode == 0 and ver_out:
            short_ver = ver_out.split(",")[0].strip()
            return (True, f"42 {short_ver} (official AST checker)", "", False)
        reason = note_err or ver_out or "official norminette cannot run"
        return (
            False,
            f"42 norminette: {reason}",
            "Run ./install.sh: it installs Python 3.10+ so the official norminette can run.",
            True,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        return (
            False,
            f"42 norminette check failed: {exc}",
            "Verify bin/norminette permissions.",
            False,
        )


def _probe_man_environment() -> DoctorCheck:
    """Detect missing or Debian/Ubuntu-minimized man pages (see unminimize)."""
    man_path = shutil.which("man")
    minimized = (
        Path("/etc/dpkg/dpkg.cfg.d/excludes").is_file()
        or Path("/etc/dpkg/dpkg.cfg.d/excludes.dpkg-tmp").is_file()
        or Path("/usr/bin/man.REAL").exists()
    )
    if not man_path:
        return (
            False,
            "man pages: 'man' command not installed",
            "Optional: install man-db (or run 'sudo unminimize' on minimized Ubuntu).",
            False,
        )
    if minimized:
        return (
            False,
            "man pages appear stripped/minimized (dpkg excludes active)",
            "Optional: run 'sudo unminimize' (or ./bocal/unminimize_man_restore.sh) to restore offline man pages.",
            False,
        )
    return (True, f"man pages available: {man_path}", "", False)


def _probe_kernel_tools_wrapper() -> DoctorCheck | None:
    """Flag Ubuntu's kernel-matched linux-tools wrapper when perf mismatches uname -r."""
    if not sys.platform.startswith("linux"):
        return None
    perf_path = shutil.which("perf")
    if not perf_path:
        return None
    try:
        head = Path(perf_path).read_text(encoding="utf-8", errors="ignore")[:1024]
    except OSError:
        return None
    if "/usr/lib/linux-tools" not in head:
        return None
    kver = os.uname().release
    if (Path("/usr/lib/linux-tools") / kver / "perf").exists():
        return (True, f"linux-tools matched for kernel {kver}", "", False)
    return (
        False,
        f"linux-tools wrapper found ({perf_path}) without kernel {kver} binary",
        f"Optional: install 'linux-tools-{kver}' or run ./bocal/ktool_dispatch.sh if profiling.",
        False,
    )


def print_doctor(theme: ThemeEngine) -> int:
    """Plain-language environment check: what the grader needs, and whether it is there."""
    print(f"{theme.c('===>', 'accent', 'bold')} {theme.bold('Setup check (doctor)')}")
    print("")
    checks: list[DoctorCheck] = []

    python_ok = sys.version_info >= (3, 10)
    checks.append(
        (
            python_ok,
            f"Python {sys.version_info.major}.{sys.version_info.minor} (need 3.10+)",
            "Install Python 3.10 or newer (or run ./install.sh)."
            if not python_ok
            else "",
            True,
        )
    )
    checks.append(
        (
            hasattr(yaml, "safe_load"),
            f"PyYAML {getattr(yaml, '__version__', 'installed')}",
            "Install PyYAML (pip install pyyaml).",
            True,
        )
    )

    c_compilers = [(t, shutil.which(t)) for t in ("gcc", "cc", "clang")]
    found_c = [(t, p) for t, p in c_compilers if p]
    if found_c:
        primary_c, primary_c_path = found_c[0]
        checks.append((True, f"{primary_c}: {primary_c_path}", "", True))
    else:
        checks.append(
            (
                False,
                "C compiler (gcc/cc/clang): not found",
                "Install a C compiler, e.g. 'sudo apt install gcc' on Debian/Ubuntu.",
                True,
            )
        )

    has_gcc = bool(shutil.which("gcc"))
    has_clang = bool(shutil.which("clang"))
    if has_gcc and has_clang:
        checks.append(
            (True, "Dual-compiler strict check ready (gcc + clang)", "", False)
        )
    elif found_c:
        missing_alt = "clang" if has_gcc else "gcc"
        checks.append(
            (
                False,
                f"Dual-compiler check: {missing_alt} not installed (single-compiler mode)",
                f"Optional: install {missing_alt} to enable dual-compiler checks under --strict.",
                False,
            )
        )

    cxx_found = next(
        ((t, shutil.which(t)) for t in ("c++", "g++", "clang++") if shutil.which(t)),
        None,
    )
    if cxx_found:
        checks.append(
            (True, f"C++ compiler ({cxx_found[0]}): {cxx_found[1]}", "", False)
        )
    else:
        checks.append(
            (
                False,
                "C++ compiler (c++/g++/clang++): not found",
                "Optional: install g++ or clang++ for C++ exam exercises (e.g. mini_db).",
                False,
            )
        )

    _, missing_core = _probe_tool_group(("git", "nm", "diff", "make", "bc", "tar"))
    if not missing_core:
        checks.append(
            (True, "Core grader tools: git, nm, diff, make, bc, tar", "", True)
        )
    else:
        pkg_map = {"nm": "binutils", "diff": "diffutils"}
        pkgs = " ".join(dict.fromkeys(pkg_map.get(t, t) for t in missing_core))
        checks.append(
            (
                False,
                f"Core grader tools missing: {', '.join(missing_core)}",
                f"Install missing packages ({pkgs}) or run ./install.sh.",
                True,
            )
        )

    _, missing_sh = _probe_tool_group(("sh", "find", "grep", "sed", "awk", "file"))
    if not missing_sh:
        checks.append(
            (True, "Shell & POSIX utilities: sh, find, grep, sed, awk, file", "", True)
        )
    else:
        checks.append(
            (
                False,
                f"Shell utilities missing: {', '.join(missing_sh)}",
                "Install standard POSIX/GNU shell utilities (findutils, grep, sed, gawk, file).",
                True,
            )
        )

    checks.append(_probe_norminette())
    checks.append(_probe_man_environment())

    valgrind_path = shutil.which("valgrind")
    if valgrind_path:
        checks.append(
            (
                True,
                f"valgrind: {valgrind_path} (extra heap checking available)",
                "",
                False,
            )
        )
    else:
        checks.append(
            (
                False,
                "valgrind: not installed (built-in DT_CHECK_LEAKS hook active)",
                "Optional: install valgrind for extra local leak debugging.",
                False,
            )
        )

    ktool_chk = _probe_kernel_tools_wrapper()
    if ktool_chk is not None:
        checks.append(ktool_chk)

    checks.append(
        (
            (KIT_ROOT / "subjects").is_dir(),
            "Exercise subjects are present",
            "The kit folder looks incomplete; re-clone magrathea.",
            True,
        )
    )

    exec_tmp = get_executable_temp_root(KIT_ROOT)
    exec_ok = (
        exec_tmp.is_dir()
        and not exec_tmp.is_symlink()
        and os.access(exec_tmp, os.W_OK | os.X_OK)
    )
    checks.append(
        (
            exec_ok,
            f"Executable temp root (execve): {tilde_path(exec_tmp)}",
            "Ensure TMPDIR or workspace/ allows executing compiled binaries.",
            True,
        )
    )

    ns_ok, ns_msg = probe_unshare_isolation()
    checks.append(
        (
            ns_ok,
            ns_msg,
            "Userns restricted; rlimit + session fallback active.",
            False,
        )
    )

    ws = KIT_ROOT / "workspace"
    try:
        ws.mkdir(parents=True, exist_ok=True)
        ws_writable = os.access(ws, os.W_OK)
    except OSError:
        ws_writable = False
    checks.append(
        (
            ws_writable,
            f"Workspace writable: {tilde_path(ws)}",
            "Check folder permissions.",
            True,
        )
    )
    checks.append(
        (
            os.access(str(Path.home()), os.W_OK),
            f"Home folder writable: {tilde_path(Path.home())}",
            "Check $HOME permissions.",
            True,
        )
    )

    all_ok = True
    for ok, label, fix, required in checks:
        if ok:
            mark = theme.c("[OK]", "ok", "bold")
        elif required:
            mark = theme.c("[!!]", "err", "bold")
        else:
            mark = theme.c("[--]", "warn", "bold")
        print(f"  {mark} {label}")
        if not ok and fix:
            print(theme.c(f"       Fix: {fix}", "warn"))
            if required:
                all_ok = False
    print("")
    if all_ok:
        print(
            theme.c(
                "  All good. Type 'list' to browse, or 'guide' for the step-by-step.",
                "ok",
            )
        )
    else:
        print(theme.c("  Fix the items above, then run 'doctor' again.", "warn"))
    print("")
    return 0 if all_ok else 1


def expected_turnin_files(resolved_subject: str, slug_leaf: str) -> list[str]:
    """Files the subject asks for, as declared in meta.yml (falls back to '<name>.c')."""
    meta = (
        fast_load_yaml(KIT_ROOT / "subjects" / resolved_subject / "meta.yml")
        if resolved_subject
        else {}
    )
    declared = [str(f) for f in (meta.get("expected_files") or []) if str(f).strip()]
    return declared or [f"{slug_leaf}.c"]


def piscine_exercise_slot(resolved_subject: str) -> tuple[str, str] | None:
    """('c00', 'ex00') for 'piscine/c00/ft_putchar', as numbered in the module pool. None outside the Piscine."""
    parts = Path(resolved_subject).parts
    if len(parts) != 3 or parts[0] != "piscine":
        return None
    pool = fast_load_yaml(KIT_ROOT / "pools" / "piscine" / f"{parts[1]}.yml")
    for idx, ex in enumerate(pool.get("exercises") or []):
        raw_id = (
            (ex.get("subject_id") or ex.get("id") or "")
            if isinstance(ex, dict)
            else str(ex)
        )
        if Path(raw_id).name == parts[2]:
            return parts[1], str(
                ex.get("ex", f"ex{idx:02d}") if isinstance(ex, dict) else f"ex{idx:02d}"
            )
    return None


_EX_FOLDER_RE = re.compile(r"^ex\d{2}$")


def find_module_repo(mod_slug: str) -> Path:
    """The student's folder for a Piscine module, laid out as at 42: <module>/exNN/<files>.

    One module, one folder, chosen by where the student stands:
      1. the current directory, when it is named like the module          (~/piscine/c00)
      2. its parent, when the student stands in one of its exNN folders   (~/piscine/c00/ex00)
      3. '<module>/' under the current directory                          (~/piscine)
      4. a current directory that directly holds exNN folders
      5. otherwise workspace/piscine/<module>/ of the kit
    The kit's own subjects/ and corrections/ trees are never a turn-in. Nothing is created here:
    the folders are the student's to make.
    """
    cwd = Path.cwd().resolve()
    kit = KIT_ROOT.resolve()
    workspace_repo = kit / "workspace" / "piscine" / mod_slug
    if cwd == kit or any(
        tree == cwd or tree in cwd.parents
        for tree in (kit / "subjects", kit / "corrections", kit / "pools")
    ):
        return workspace_repo
    if cwd.name.lower() == mod_slug:
        return cwd
    if _EX_FOLDER_RE.match(cwd.name) and cwd.parent.name.lower() == mod_slug:
        return cwd.parent
    if (cwd / mod_slug).is_dir():
        return (cwd / mod_slug).resolve()
    if cwd.name.lower() not in get_piscine_modules() and any(
        d.is_dir() for d in cwd.glob("ex[0-9][0-9]")
    ):
        return cwd
    return workspace_repo


def resolve_submission_dir(
    explicit_dir: str | None, slug_leaf: str, resolved_subject: str = ""
) -> Path:
    """Where the turn-in is read from.

    --dir wins. Otherwise, for a Piscine exercise, the 42 layout is the reference: the exercise lives
    in its own exNN folder of the module folder (c00/ex00/ft_putchar.c), wherever that module folder
    is (see find_module_repo). A file sitting in another exNN is not the exercise. Folders named after
    the exercise (the older scaffold) are still read. Exam exercises are read from
    workspace/exams/<ex>/, then the examshell rendu folders.

    When nothing exists, the answer is the folder the student is expected to create (never the current
    directory as a whole), so that 'Nothing turned in' names the right place.
    """
    if explicit_dir is not None:
        return Path(explicit_dir).expanduser().resolve()
    cwd = Path.cwd().resolve()
    is_kit_root = cwd == KIT_ROOT.resolve()
    names = {f"{slug_leaf}.c", f"{slug_leaf}.sh", f"{slug_leaf}.h"}
    if resolved_subject:
        names.update(
            f
            for f in expected_turnin_files(resolved_subject, slug_leaf)
            if "*" not in f
        )

    def _holds_turnin(directory: Path) -> bool:
        return any((directory / name).is_file() for name in names)

    slot = piscine_exercise_slot(resolved_subject) if resolved_subject else None

    # The student stands inside the exercise folder itself (c00/ex00/). Another exNN is another exercise.
    if not is_kit_root and _holds_turnin(cwd):
        if slot is None or cwd.name == slot[1] or not _EX_FOLDER_RE.match(cwd.name):
            return cwd

    if slot is not None:
        mod_slug, ex_code = slot
        repo = find_module_repo(mod_slug)
        # Keep the exNN name the subject asks for ("Turn-in directory : ex00/"): never dereference
        # an ex00 -> ft_putchar link, or the path shown contradicts the subject.
        repo = repo.resolve()
        for sub_name in (ex_code, Path(resolved_subject).name, slug_leaf):
            if (repo / sub_name).is_dir():
                return repo / sub_name
        return repo / ex_code

    if not is_kit_root and (cwd / slug_leaf).is_dir():
        return (cwd / slug_leaf).resolve()
    if resolved_subject and (KIT_ROOT / "workspace" / resolved_subject).is_dir():
        return (KIT_ROOT / "workspace" / resolved_subject).resolve()
    exam_rendu = Path.home() / "exam-basedir" / "rendu" / slug_leaf
    if exam_rendu.is_dir():
        return exam_rendu.resolve()
    ws_rendu = KIT_ROOT / "workspace" / "rendu" / slug_leaf
    if ws_rendu.is_dir():
        return ws_rendu.resolve()

    target_rel = resolved_subject if resolved_subject else f"rendu/{slug_leaf}"
    return (KIT_ROOT / "workspace" / target_rel).resolve()


def colorize_trace(trace_text: str, theme: ThemeEngine) -> str:
    """Apply theme colors to a Deepthought grading trace."""
    if theme.name == "plain":
        return trace_text
    out: list[str] = []
    for line in trace_text.splitlines():
        if line.startswith("= ") and line.endswith("="):
            if "Final grade: 100" in line:
                out.append(theme.c(line, "ok", "bold"))
            elif "Final grade: 0" in line or "Final grade: -42" in line:
                out.append(theme.c(line, "err", "bold"))
            else:
                out.append(theme.c(line, "primary", "bold"))
        elif (
            line.startswith(">>>>>>>>>> FAILURE")
            or "Cheating (-42)" in line
            or "Diff KO :(" in line
            or "Norme error" in line
        ):
            out.append(theme.c(line, "err", "bold"))
        elif "Diff OK :D" in line or line == "OK" or line.endswith(": OK!"):
            out.append(theme.c(line, "ok", "bold"))
        elif line.startswith("$> "):
            out.append(theme.c(line, "accent"))
        elif line.startswith("+") and not line.startswith("+++"):
            out.append(theme.c(line, "ok"))
        elif line.startswith("-") and not line.startswith("---"):
            out.append(theme.c(line, "err"))
        else:
            out.append(line)
    return "\n".join(out)


def _format_preview_exercises(
    exs: list[str],
    max_width: int = 56,
    max_items: int = 4,
) -> str:
    """Format an exercise preview list bounded by character budget and item count.

    Args:
        exs: Exercise directory or slug names in display order.
        max_width: Maximum visible width in characters for the preview cell.
        max_items: Maximum number of leading exercise names before collapsing.

    Returns:
        A comma-separated preview string with a trailing ``(+N more)`` suffix
        when truncated.
    """
    cleaned = [_MODULE_PREFIX_RE.sub("", e) for e in exs]
    shown: list[str] = []
    cur_len = 0
    for idx, name in enumerate(cleaned):
        rem = len(cleaned) - idx
        suffix = f" (+{rem} more)" if rem > 0 else ""
        add_len = len(name) + (2 if shown else 0)
        if shown and (
            cur_len + add_len + len(suffix) > max_width or len(shown) >= max_items
        ):
            return ", ".join(shown) + f" (+{rem} more)"
        shown.append(name)
        cur_len += add_len
    return ", ".join(shown)


def _fit_three_columns(
    budget: int,
    mins: tuple[int, int, int],
    natural: tuple[int, int, int],
    caps: tuple[int, int, int],
) -> tuple[int, int, int]:
    """Allocate widths for three flexible columns within an integer budget.

    Args:
        budget: Total column budget shared across all three columns.
        mins: Minimum allowed widths for ``(ASSIGNMENT, FILES, ALLOWED)``.
        natural: Unclipped content widths for each column.
        caps: Maximum allowed widths for each column.

    Returns:
        Allocated ``(width_0, width_1, width_2)`` column widths.
    """
    widths = [max(mins[i], min(natural[i], caps[i])) for i in range(3)]
    while sum(widths) > budget:
        reducible = [i for i in (2, 1, 0) if widths[i] > mins[i]]
        if not reducible:
            break
        widest = max(reducible, key=lambda idx: (widths[idx] - mins[idx], idx))
        widths[widest] -= 1
    return widths[0], widths[1], widths[2]


def _print_table(
    headers: tuple[str, ...],
    rows: list[tuple[str, ...]],
    widths: tuple[int, ...],
    aligns: tuple[str, ...],
    styles: tuple[tuple[str, ...], ...],
    theme: ThemeEngine,
) -> None:
    """Render an ANSI-aware aligned column table.

    Args:
        headers: Column header labels.
        rows: Table body tuples aligned one-to-one with ``headers``.
        widths: Column widths in characters.
        aligns: Alignment specifier (``"<"`` or ``">"``) per column.
        styles: Theme style role tuples per column (``("_done",)`` maps OK/dim).
        theme: Active theme engine used to style headers, rules, and cells.
    """
    last_idx = len(headers) - 1
    hdr_cells = [
        h
        if (i == last_idx and a == "<")
        else (f"{h:>{w}}" if a == ">" else f"{h:<{w}}")
        for i, (h, w, a) in enumerate(zip(headers, widths, aligns))
    ]
    print(theme.c("  ".join(hdr_cells), "primary", "bold"))
    print(theme.c("  ".join("-" * w for w in widths), "secondary"))
    for row in rows:
        cells: list[str] = []
        for idx, (val, w, a, st) in enumerate(zip(row, widths, aligns, styles)):
            is_last = idx == len(row) - 1
            text = clip_cell(val, w)
            padded = (
                text
                if (is_last and a == "<")
                else (f"{text:>{w}}" if a == ">" else f"{text:<{w}}")
            )
            if st == ("_done",):
                st = ("ok", "bold") if val == "OK" else ("muted",)
            cells.append(theme.c(padded, *st) if st else padded)
        print("  ".join(cells))


def _print_exercise_table(
    rows: list[tuple[str, str, str, str, str, str]],
    first_hdr: str,
    first_min: int,
    score_hdr: str,
    table_max: int,
    theme: ThemeEngine,
) -> None:
    """Render a compact 6-column exercise table capped at 79 columns.

    Args:
        rows: Tuples of ``(slot, assignment, files, allowed, score, done)``.
        first_hdr: Header label for column 0 (``"EX"`` or ``"#"``).
        first_min: Minimum width for column 0.
        score_hdr: Header label for column 4 (``"XP"`` or ``"PTS"``).
        table_max: Upper column bound requested by caller.
        theme: Active theme engine for styling output.
    """
    effective_max = min(79, max(40, table_max))
    first_w = max([first_min, *(len(r[0]) for r in rows)])
    score_w = max([3, *(len(r[4]) for r in rows)])
    done_w = 2
    overhead = first_w + score_w + done_w + 10
    natural = tuple(
        max([m, *(len(r[i]) for r in rows)]) for i, m in ((1, 10), (2, 12), (3, 7))
    )
    caps = (
        max(38, effective_max // 2),
        max(52, effective_max // 2),
        max(52, effective_max // 2),
    )
    name_w, files_w, allow_w = _fit_three_columns(
        max(29, effective_max - overhead),
        (10, 12, 7),
        natural,  # type: ignore[arg-type]
        caps,
    )
    _print_table(
        (first_hdr, "ASSIGNMENT", "FILES", "ALLOWED", score_hdr, "OK"),
        rows,
        (first_w, name_w, files_w, allow_w, score_w, done_w),
        ("<", "<", "<", "<", ">", "<"),
        (
            ("accent", "bold"),
            ("primary", "bold"),
            (),
            ("secondary",),
            ("warn",),
            ("_done",),
        ),
        theme,
    )


_EXAM_TRACK_ALIASES = {
    "exam00": "c_piscine_exam_00",
    "exam_00": "c_piscine_exam_00",
    "exam01": "c_piscine_exam_01",
    "exam_01": "c_piscine_exam_01",
    "exam02": "c_piscine_exam_02",
    "exam_02": "c_piscine_exam_02",
    "examfinal": "c_piscine_final_exam",
    "exam_final": "c_piscine_final_exam",
    "final": "c_piscine_final_exam",
    "rank2": "rank02",
    "rank3": "rank03",
    "rank4": "rank04",
    "rank5": "rank05",
    "rank6": "rank06",
    "exam_rank_02": "rank02",
    "exam_rank_03": "rank03",
    "exam_rank_04": "rank04",
    "exam_rank_05": "rank05",
    "exam_rank_06": "rank06",
}


def resolve_exam_track_name(name: str) -> str | None:
    """Resolve an exam track alias to its canonical pool stem."""
    low = name.strip().lower()
    mapped = _EXAM_TRACK_ALIASES.get(low, low)
    if (KIT_ROOT / "pools" / "exams" / f"{mapped}.yml").is_file():
        return mapped
    return None


OFFICIAL_EXAM_TRACKS = [
    "c_piscine_exam_00",
    "c_piscine_exam_01",
    "c_piscine_exam_02",
    "c_piscine_final_exam",
    "rank02",
    "rank03",
    "rank04",
    "rank05",
    "rank06",
]


@functools.lru_cache(maxsize=1)
def catalog_counts() -> tuple[int, int, int, int]:
    """(piscine modules, piscine exercises, exam tracks shown, exam exercises), counted on disk."""
    subj = KIT_ROOT / "subjects"
    mods = len(get_piscine_modules())
    piscine_exs = (
        sum(1 for _ in (subj / "piscine").glob("*/*/meta.yml"))
        if (subj / "piscine").is_dir()
        else 0
    )
    tracks = sum(
        1
        for t in OFFICIAL_EXAM_TRACKS
        if (KIT_ROOT / "pools" / "exams" / f"{t}.yml").is_file()
    )
    exam_exs = (
        sum(1 for _ in (subj / "exams").glob("*/meta.yml"))
        if (subj / "exams").is_dir()
        else 0
    )
    return mods, piscine_exs, tracks, exam_exs


def load_validated_exercises() -> set[str]:
    """Exercises already validated by the student, from the default XP ledger (empty when there is none)."""
    try:
        data = json.loads(
            (KIT_ROOT / "workspace" / "xp_ledger.json").read_text(encoding="utf-8")
        )
        return set((data.get("validated_exercises") or {}).keys())
    except (OSError, ValueError, AttributeError):
        return set()


def home_note(*shown_paths: str) -> str:
    """Explain '~' only when a displayed path actually uses it."""
    return (
        f"  (~ = {Path.home()})"
        if any(str(sp).startswith("~") for sp in shown_paths)
        else ""
    )


def clip_cell(text: str, width: int) -> str:
    """Truncate text to width characters with a trailing ellipsis if needed."""
    return text if len(text) <= width else text[: max(1, width - 1)] + "…"


def _rel_or_tilde(path: Path) -> str:
    """Return a repo-relative path inside ``KIT_ROOT``, else ``tilde_path``.

    Args:
        path: Target filesystem path to format for display.

    Returns:
        Path relative to ``KIT_ROOT`` when inside the kit, otherwise tilde-shortened.
    """
    resolved = path.resolve()
    kit_resolved = KIT_ROOT.resolve()
    try:
        return str(resolved.relative_to(kit_resolved))
    except ValueError:
        return tilde_path(resolved)


def _catalog_banner(title: str, width: int, theme: ThemeEngine) -> str:
    """Format a single-line Classic 42 ``=`` section bar within ``width`` columns.

    Args:
        title: Section title shown inside the bar.
        width: Target upper width bound from the caller.
        theme: Active theme engine for styling the borders and title.

    Returns:
        Single-line banner string capped at ``min(78, max(40, width))`` columns.
    """
    cap = min(78, max(40, width))
    title_txt = clip_cell(title, cap - 6)
    fill = max(3, cap - len(title_txt) - 3)
    return (
        f"{theme.c('=', 'secondary')} "
        f"{theme.c(title_txt, 'primary', 'bold')} "
        f"{theme.c('=' * fill, 'secondary')}"
    )


def _format_catalog_meta_line(
    label: str,
    value: str,
    hint: str,
    max_width: int,
    theme: ThemeEngine,
) -> str:
    """Format an aligned metadata line with distinct label, value, and hint contrast.

    Args:
        label: Leading aligned field prefix (for example ``"  subject : "``).
        value: Primary value or path string.
        hint: Optional trailing helper text dropped if ``max_width`` is tight.
        max_width: Hard visible column cap for the rendered line.
        theme: Active theme engine for ANSI color styling.

    Returns:
        Styled single line guaranteed not to exceed ``max_width`` visible columns.
    """
    if hint and len(label) + len(value) + len(hint) <= max_width:
        return f"{theme.c(label, 'secondary')}{value}{theme.c(hint, 'muted')}"
    val = value
    home_str = str(Path.home())
    if len(label) + len(val) > max_width and val.startswith(home_str + "/"):
        val = "~" + val[len(home_str) :]
    avail = max(1, max_width - len(label))
    val = clip_cell(val, avail)
    return f"{theme.c(label, 'secondary')}{val}"


def print_sections_menu(theme: ThemeEngine, include_nav: bool = True) -> None:
    """Render the Spartan 2-section root catalog selector (1: piscine, 2: piscine exam)."""
    mods, piscine_exs, tracks, exam_exs = catalog_counts()
    term_cols, _ = theme.term_size()
    table_max = min(79, max(40, term_cols - 1))
    print(_catalog_banner("42 / 1337 catalog sections", table_max, theme))
    _print_table(
        ("#", "SECTION", "CONTENT", "DESCRIPTION"),
        [
            (
                "1",
                "piscine",
                f"{mods} modules ({piscine_exs} exs)",
                "c00..c13, shell00..01, rush, bsq",
            ),
            (
                "2",
                "piscine exam",
                f"{tracks} tracks ({exam_exs} exs)",
                "exam 00..final, rank 02..06",
            ),
        ],
        (3, 14, 22, 34),
        ("<", "<", "<", "<"),
        (("muted",), ("accent", "bold"), ("secondary",), ("muted",)),
        theme,
    )
    if include_nav:
        print(
            theme.c("nav: piscine (1) | exams (2) | <exercise> (grade) | help", "muted")
        )


def _fit_catalog_path_line(
    prefix: str,
    abs_or_tilde: str,
    suffix: str,
    max_width: int,
) -> str:
    """Format a catalog metadata path line without exceeding ``max_width`` columns.

    Args:
        prefix: Leading label prefix such as ``"     subject: "``.
        abs_or_tilde: Displayed path (already processed with ``tilde_path``).
        suffix: Optional trailing helper text (e.g. ``"(or: subject ...)"``).
        max_width: Hard column cap for the rendered line.

    Returns:
        A single line guaranteed to fit within ``max_width`` characters.
    """
    candidates = [
        f"{prefix}{abs_or_tilde}{suffix}",
        f"{prefix}{abs_or_tilde}",
    ]
    home_str = str(Path.home())
    rel_kit = tilde_path(KIT_ROOT)
    if abs_or_tilde.startswith(rel_kit + "/"):
        short_path = abs_or_tilde[len(rel_kit) + 1 :]
        candidates.append(f"{prefix}{short_path}{suffix}")
        candidates.append(f"{prefix}{short_path}")
    elif abs_or_tilde.startswith(home_str + "/"):
        short_path = "~" + abs_or_tilde[len(home_str) :]
        candidates.append(f"{prefix}{short_path}")
    for cand in candidates:
        if len(cand) <= max_width:
            return cand
    return clip_cell(candidates[-1], max_width)


def print_catalog_list(
    target: str | None, theme: ThemeEngine, max_rows: int | None = None
) -> int:
    """Print a compact 80-column catalog view bounded to at most 79 columns.

    Args:
        target: Optional module, exam track, ``"piscine"``, or ``"exams"`` filter.
        theme: Active theme engine for styled output.
        max_rows: Optional vertical row budget used by the interactive viewport.

    Returns:
        Exit status code (``0`` on success, ``1`` if the target is unknown).
    """
    term_cols, _ = theme.term_size()
    table_max = min(79, max(40, term_cols - 1))
    piscine_dir = KIT_ROOT / "pools" / "piscine"
    validated = load_validated_exercises()
    exam_dir = KIT_ROOT / "pools" / "exams"
    piscine_pools = sorted(piscine_dir.glob("*.yml"))
    target_clean = (target or "").strip().lower()

    # Case 1: Specific Exam Track (or Specific Level inside an Exam Track, e.g. "c_piscine_exam_00:0")
    selected_lvl_idx: int | None = None
    track_query = target_clean
    if ":" in target_clean:
        track_query, lvl_part = target_clean.split(":", 1)
        lvl_part = lvl_part.replace("level", "").replace("lvl", "").strip()
        if lvl_part.isdigit():
            selected_lvl_idx = int(lvl_part)

    exam_file = None
    if track_query and track_query not in {
        "piscine",
        "piscines",
        "exam",
        "exams",
        "piscine exam",
        "piscine_exam",
        "all",
        "__all__",
    }:
        resolved_trk = resolve_exam_track_name(track_query)
        candidates = [
            resolved_trk or track_query,
            track_query,
            track_query.replace("exam_", ""),
            track_query.replace("rank_", "rank0"),
            track_query.replace("exam", "c_piscine_exam_"),
        ]
        for c in candidates:
            if c and (exam_dir / f"{c}.yml").exists():
                exam_file = exam_dir / f"{c}.yml"
                break

    if exam_file:
        data = fast_load_yaml(exam_file)
        title = data.get("display_name") or data.get("name") or exam_file.stem
        dur_s = data.get("duration_seconds", 14400)
        dur_h, dur_m = dur_s // 3600, (dur_s % 3600) // 60
        levels = data.get("levels", [])
        total_candidates = sum(len(lvl.get("candidates", [])) for lvl in levels)

        # Sub-case 1A: Inside a specific level of the exam track (e.g. level0)
        if selected_lvl_idx is not None:
            matched_lvl = next(
                (
                    lvl
                    for lvl in levels
                    if int(lvl.get("level", -1)) == selected_lvl_idx
                ),
                None,
            )
            if not matched_lvl and 0 <= selected_lvl_idx < len(levels):
                matched_lvl = levels[selected_lvl_idx]
            if matched_lvl:
                lvl_num = matched_lvl.get("level", selected_lvl_idx)
                pts = matched_lvl.get("points", 100 // max(1, len(levels)))
                cands = matched_lvl.get("candidates", [])
                subj_base = _rel_or_tilde(KIT_ROOT / "subjects" / "exams")
                ws_base = _rel_or_tilde(KIT_ROOT / "workspace" / "exams")
                print(
                    _catalog_banner(
                        f"{exam_file.stem} / level{lvl_num} ({len(cands)} candidates | {pts} pts each)",
                        table_max,
                        theme,
                    )
                )
                if max_rows is None or len(cands) + 5 <= max_rows:
                    print(
                        _format_catalog_meta_line(
                            "  subject : ",
                            f"{subj_base}/<ex>/subject.en.txt",
                            "  (or: subject <ex>)",
                            table_max,
                            theme,
                        )
                    )
                    print(
                        _format_catalog_meta_line(
                            "  turn-in : ",
                            f"{ws_base}/<ex>/",
                            home_note(subj_base, ws_base),
                            table_max,
                            theme,
                        )
                    )
                ex_rows: list[tuple[str, str, str, str, str, str]] = []
                pts_s = str(pts)
                for idx, ex_id in enumerate(cands, 1):
                    m_path = KIT_ROOT / "subjects" / "exams" / ex_id / "meta.yml"
                    meta = fast_load_yaml(m_path) if m_path.exists() else {}
                    exp_raw = ", ".join(meta.get("expected_files") or [f"{ex_id}.c"])
                    allow_raw = ", ".join(meta.get("allowed_functions") or ["None"])
                    done_s = "OK" if f"exams/{ex_id}" in validated else "-"
                    ex_rows.append(
                        (str(idx), str(ex_id), exp_raw, allow_raw, pts_s, done_s)
                    )
                _print_exercise_table(ex_rows, "#", 3, "PTS", table_max, theme)
                return 0

        # Sub-case 1B: Compact Level Table (1 row per level)
        subj_base = _rel_or_tilde(KIT_ROOT / "subjects" / "exams")
        ws_base = _rel_or_tilde(KIT_ROOT / "workspace" / "exams")
        print(
            _catalog_banner(
                f"exam track: {exam_file.stem} ({title})",
                table_max,
                theme,
            )
        )
        print(
            _format_catalog_meta_line(
                "  duration: ",
                f"{dur_h:02d}h {dur_m:02d}m | levels: {len(levels)} ({total_candidates} exs)",
                "",
                table_max,
                theme,
            )
        )
        if max_rows is None or len(levels) + 6 <= max_rows:
            print(
                _format_catalog_meta_line(
                    "  subject : ",
                    f"{subj_base}/NAME/subject.en.txt",
                    "  (NAME = an exercise below)",
                    table_max,
                    theme,
                )
            )
            print(
                _format_catalog_meta_line(
                    "  turn-in : ",
                    f"{ws_base}/NAME/",
                    home_note(subj_base, ws_base),
                    table_max,
                    theme,
                )
            )
        preview_w = max(36, min(table_max - 22, 56))
        level_rows: list[tuple[str, ...]] = []
        for lvl in levels:
            lvl_num = lvl.get("level", 0)
            pts = lvl.get("points", 100 // max(1, len(levels)))
            cands = [str(c) for c in (lvl.get("candidates") or [])]
            level_rows.append(
                (
                    f"level{lvl_num}",
                    str(pts),
                    str(len(cands)),
                    _format_preview_exercises(cands, max_width=preview_w, max_items=4),
                )
            )
        rule_w = max(len("EXERCISES"), min(table_max - 22, 57))
        _print_table(
            ("LEVEL", "PTS", "COUNT", "EXERCISES"),
            level_rows,
            (7, 4, 5, rule_w),
            ("<", ">", ">", "<"),
            (("accent", "bold"), (), (), ("secondary",)),
            theme,
        )
        return 0

    # Case 2: Specific Piscine Module (with rush00..02 / bsq support)
    if target_clean in {"rush00", "rush01", "rush02", "bsq", "rush"}:
        target_clean = "rush_bsq"
    if target_clean and (piscine_dir / f"{target_clean}.yml").exists():
        pool_file = piscine_dir / f"{target_clean}.yml"
        data = fast_load_yaml(pool_file)
        title = data.get("display_name") or data.get("title") or target_clean
        exs = data.get("exercises") or []
        subj_mod = _rel_or_tilde(KIT_ROOT / "subjects" / "piscine" / target_clean)
        ws_mod = _rel_or_tilde(find_module_repo(target_clean))
        print(
            _catalog_banner(
                f"piscine module: {target_clean} ({title})",
                table_max,
                theme,
            )
        )
        if (max_rows is None or len(exs) + 5 <= max_rows) and exs:
            first_ex = (
                str(exs[0].get("ex", "ex00")) if isinstance(exs[0], dict) else "ex00"
            )
            last_default = f"ex{len(exs) - 1:02d}"
            last_ex = (
                str(exs[-1].get("ex", last_default))
                if isinstance(exs[-1], dict)
                else last_default
            )
            slot_range = first_ex if first_ex == last_ex else f"{first_ex}..{last_ex}"
            print(
                _format_catalog_meta_line(
                    "  subject : ",
                    f"{subj_mod}/<name>/subject.en.txt",
                    "  (or: subject <ex>)",
                    table_max,
                    theme,
                )
            )
            print(
                _format_catalog_meta_line(
                    "  turn-in : ",
                    f"{ws_mod}/<ex>/",
                    f"  (folders: {slot_range}){home_note(subj_mod, ws_mod)}",
                    table_max,
                    theme,
                )
            )
        rows: list[tuple[str, str, str, str, str, str]] = []
        for idx, ex in enumerate(exs):
            raw_id = (
                (ex.get("subject_id") or ex.get("id") or "")
                if isinstance(ex, dict)
                else str(ex)
            )
            ex_id = Path(raw_id).name
            ex_label = (
                ex.get("ex", f"ex{idx:02d}") if isinstance(ex, dict) else f"ex{idx:02d}"
            )
            m_path = (
                KIT_ROOT / "subjects" / "piscine" / target_clean / ex_id / "meta.yml"
            )
            meta = fast_load_yaml(m_path) if m_path.exists() else {}
            clean_leaf = _MODULE_PREFIX_RE.sub("", ex_id)
            exp = ", ".join(
                str(f) for f in (meta.get("expected_files") or [f"{clean_leaf}.c"])
            )
            allow = ", ".join(
                str(f) for f in (meta.get("allowed_functions") or ["None"])
            )
            xp = (ex.get("xp") if isinstance(ex, dict) else None) or meta.get("xp", 100)
            rows.append(
                (
                    str(ex_label),
                    clean_leaf,
                    exp,
                    allow,
                    str(xp),
                    "OK" if f"piscine/{target_clean}/{ex_id}" in validated else "-",
                )
            )
        _print_exercise_table(rows, "EX", 4, "XP", table_max, theme)
        return 0

    visible_exam_pools = [
        exam_dir / f"{trk}.yml"
        for trk in OFFICIAL_EXAM_TRACKS
        if (exam_dir / f"{trk}.yml").exists()
    ]

    # Case 3: Target is "piscine" or "piscines"
    if target_clean in {"piscine", "piscines"}:
        preview_w = max(36, min(table_max - 19, 56))
        mod_rows: list[tuple[str, ...]] = []
        for p in piscine_pools:
            data = fast_load_yaml(p)
            exs = [
                Path(
                    (e.get("subject_id") or e.get("id") or "")
                    if isinstance(e, dict)
                    else str(e)
                ).name
                for e in (data.get("exercises") or [])
            ]
            mod_rows.append(
                (
                    p.stem,
                    str(len(exs)),
                    _format_preview_exercises(exs, max_width=preview_w, max_items=4),
                )
            )
        rule_w = max(len("EXERCISES"), min(table_max - 19, 57))
        print(
            _catalog_banner(
                f"42 / 1337 c piscine catalog ({len(piscine_pools)} modules | {catalog_counts()[1]} exercises)",
                table_max,
                theme,
            )
        )
        _print_table(
            ("MODULE", "COUNT", "EXERCISES"),
            mod_rows,
            (10, 5, rule_w),
            ("<", ">", "<"),
            (("accent", "bold"), (), ("secondary",)),
            theme,
        )
        return 0

    # Case 4: Target is "exams", "exam", or "piscine exam"
    if target_clean in {"exam", "exams", "piscine exam", "piscine_exam"}:
        exam_rows: list[tuple[str, ...]] = []
        for p in visible_exam_pools:
            data = fast_load_yaml(p)
            levels = data.get("levels", [])
            dur_h = data.get("duration_seconds", 14400) // 3600
            cands = sum(len(lvl.get("candidates", [])) for lvl in levels)
            exam_rows.append(
                (
                    p.stem,
                    f"{dur_h:02d}h",
                    str(len(levels)),
                    str(cands),
                    str(data.get("display_name") or p.stem),
                )
            )
        rule_w = max(len("NAME"), min(table_max - 43, 34))
        print(
            _catalog_banner(
                f"piscine exam ({len(visible_exam_pools)} tracks | {catalog_counts()[3]} exercises)",
                table_max,
                theme,
            )
        )
        _print_table(
            ("TRACK", "DUR", "LVL", "POOL", "NAME"),
            exam_rows,
            (24, 4, 3, 4, rule_w),
            ("<", "<", ">", ">", "<"),
            (("accent", "bold"), (), (), (), ("secondary",)),
            theme,
        )
        return 0

    if target_clean and target_clean not in {"list", "__all__", "all"}:
        print(theme.c(f"moulinette: unknown catalog target '{target}'", "err", "bold"))
        return 1

    print_sections_menu(theme)
    return 0


def scaffold_exercise_workspace(
    target: str,
    dest_override: str | None,
    theme: ThemeEngine,
    prefer_exam: bool = False,
    verbose: bool = True,
) -> int:
    """Create starter workspace directories and files for an exercise or module."""
    pool_file = KIT_ROOT / "pools" / "piscine" / f"{target.strip().lower()}.yml"
    if pool_file.exists():
        mod = target.strip().lower()
        data = fast_load_yaml(pool_file)
        base_out = (
            Path(dest_override).expanduser().resolve()
            if dest_override
            else find_module_repo(mod)
        )
        base_out.mkdir(parents=True, exist_ok=True)
        exs = data.get("exercises") or []
        for idx, ex in enumerate(exs):
            raw_id = (
                (ex.get("subject_id") or ex.get("id") or "")
                if isinstance(ex, dict)
                else str(ex)
            )
            ex_id = Path(raw_id).name
            ex_code = (
                ex.get("ex", f"ex{idx:02d}") if isinstance(ex, dict) else f"ex{idx:02d}"
            )
            slot_dir = base_out / ex_code
            named_dir = base_out / ex_id
            # A fresh exercise gets <module>/<exNN>/ (the 42 layout). An older folder named after the
            # exercise is kept and reached through an exNN link.
            ex_out = (
                named_dir
                if (named_dir.is_dir() and not slot_dir.exists())
                else slot_dir
            )
            scaffold_exercise_workspace(
                f"{mod}/{ex_id}",
                str(ex_out),
                theme,
                prefer_exam=prefer_exam,
                verbose=False,
            )
            ex_code_link = base_out / ex_code
            if not ex_code_link.exists():
                try:
                    ex_code_link.symlink_to(ex_id)
                except OSError:
                    pass
        print(
            theme.c(
                f"[OK] Module '{mod}' scaffolded: {len(exs)} exercises ready in {tilde_path(base_out)}",
                "ok",
                "bold",
            )
        )
        print(
            theme.c(
                f"     Grade entire module with: ./bin/moulinette {mod} --dir {tilde_path(base_out)}",
                "muted",
            )
        )
        return 0

    found = resolve_exercise_or_report(target, theme, prefer_exam=prefer_exam)
    if found is None:
        return 1
    resolved = found[0]
    subj_dir = KIT_ROOT / "subjects" / resolved

    meta = fast_load_yaml(subj_dir / "meta.yml")
    slot = piscine_exercise_slot(resolved)
    if dest_override:
        out_dir = Path(dest_override).expanduser().resolve()
    elif slot is not None:
        # The very folder the grader reads: <module>/<exNN>/ (the 42 layout), or an older folder
        # named after the exercise when the student already has one.
        out_dir = resolve_submission_dir(
            None,
            _MODULE_PREFIX_RE.sub("", Path(resolved).name),
            resolved_subject=resolved,
        )
    else:
        out_dir = KIT_ROOT / "workspace" / resolved
    out_dir.mkdir(parents=True, exist_ok=True)

    wanted_files = [str(f) for f in (meta.get("expected_files") or [])]
    for ext_pat in ("*.h", "*.hpp"):
        for hf in sorted(subj_dir.glob(ext_pat)):
            # A header that is the whole exercise (C 08 ft_abs.h, ft_point.h) is the student's to write.
            if wanted_files == [hf.name]:
                continue
            if not (out_dir / hf.name).exists():
                shutil.copy2(hf, out_dir / hf.name)

    clean_leaf = _MODULE_PREFIX_RE.sub("", subj_dir.name)
    for extra_f in (
        "resources.tar.gz",
        "a",
        "sw.diff",
        "square.txt",
        "vbc.c",
        "tsp.c",
        "ft_scanf.c",
        f"{clean_leaf}.c",
    ):
        if (subj_dir / extra_f).exists() and not (out_dir / extra_f).exists():
            shutil.copy2(subj_dir / extra_f, out_dir / extra_f)
    if (
        clean_leaf == "mini_serv"
        and (subj_dir / "main.c").exists()
        and not (out_dir / "mini_serv.c").exists()
    ):
        shutil.copy2(subj_dir / "main.c", out_dir / "mini_serv.c")

    exp_files = meta.get("expected_files") or [f"{clean_leaf}.c"]
    proto = str(meta.get("prototype") or "")
    allowed = meta.get("allowed_functions") or []
    stype = meta.get("type", "")

    concrete_files: list[str] = []
    for fname in exp_files:
        if fname == "*.c":
            resolved_c = "vbc.c" if clean_leaf.startswith("vbc") else f"{clean_leaf}.c"
            if resolved_c not in concrete_files:
                concrete_files.append(resolved_c)
        elif "*" in fname:
            continue
        elif fname not in concrete_files:
            concrete_files.append(fname)
    if not concrete_files:
        concrete_files = [f"{clean_leaf}.c"]

    for fname in concrete_files:
        fpath = out_dir / fname
        if fpath.exists():
            continue
        fpath.parent.mkdir(parents=True, exist_ok=True)
        if fname.endswith(".sh"):
            fpath.write_text("#!/bin/sh\n\n", encoding="utf-8")
            os.chmod(fpath, 0o755)
        elif fname.endswith((".h", ".hpp")):
            guard = re.sub(r"[^A-Za-z0-9]", "_", fname).upper()
            fpath.write_text(
                build_42_header(fname)
                + f"\n#ifndef {guard}\n# define {guard}\n\n#endif\n",
                encoding="utf-8",
            )
        elif fname.endswith(".cpp"):
            hdr = build_42_header(fname) + "\n"
            hpp_name = f"{fpath.stem}.hpp"
            inc_line = (
                f'#include "{hpp_name}"\n\n'
                if f"{fpath.stem}.hpp" in concrete_files
                or (out_dir / hpp_name).exists()
                else "#include <iostream>\n\n"
            )
            fpath.write_text(hdr + inc_line, encoding="utf-8")
        elif fname.endswith(".c"):
            hdr = build_42_header(fname) + "\n"
            incs: list[str] = []
            if any(f in allowed for f in ("write", "read", "close")):
                incs.append("#include <unistd.h>")
            if any(f in allowed for f in ("malloc", "free", "exit")):
                incs.append("#include <stdlib.h>")
            inc_s = ("\n".join(incs) + "\n\n") if incs else ""
            if stype == "c_function" and proto and "main(" not in proto:
                body = norm_function_stubs(proto)
            else:
                body = "int\tmain(int argc, char **argv)\n{\n\t(void)argc;\n\t(void)argv;\n\treturn (0);\n}\n"
            fpath.write_text(hdr + inc_s + body, encoding="utf-8")

    t_out = tilde_path(out_dir)
    t_subj = f"subjects/{resolved}/subject.en.txt"
    primary_f = concrete_files[0] if concrete_files else f"{clean_leaf}.c"
    if verbose:
        print(theme.c("=" * 79, "border"))
        print(theme.c(f"  SCAFFOLDED WORKSPACE READY: {resolved}", "ok", "bold"))
        print(theme.c("-" * 79, "border"))
        print(
            f"  Turn-In Folder  : {theme.c(t_out + '/', 'accent', 'bold')}{theme.c(home_note(t_out), 'muted')}"
        )
        print(f"  Subject File    : {theme.c(t_subj, 'secondary')}")
        print(f"  Expected Files  : {', '.join(exp_files)}")
        print(f"  Allowed Funcs   : {', '.join(allowed) if allowed else 'None'}")
        print(f"  1) Edit Code    : {theme.c(f'vim {t_out}/{primary_f}', 'accent')}")
        print(
            f"  2) Grade Now    : type {theme.c(clean_leaf, 'primary', 'bold')} here in moulinette (no git push needed)"
        )
        print(theme.c("=" * 79, "border"))
    return 0


def snapshot_workspace_state(directory: Path) -> dict[str, tuple[int, int]]:
    """Capture file mtime and size pairs across a directory tree for watch mode."""
    state: dict[str, tuple[int, int]] = {}
    if not directory.exists():
        return state
    try:
        paths = list(directory.rglob("*"))
    except OSError:
        return state

    for p in paths:
        try:
            rel_parts = p.relative_to(directory).parts
        except ValueError:
            continue
        if any(part.startswith(".") or part == "__pycache__" for part in rel_parts):
            continue
        if p.name.endswith(_IGNORED_WATCH_SUFFIXES) or p.name == "4913":
            continue
        try:
            st = p.stat()
        except OSError:
            continue
        if p.is_file():
            state[str(Path(*rel_parts))] = (st.st_mtime_ns, st.st_size)
    return state


def handle_subject_inspection(
    subject_arg: str,
    *,
    show_subject: bool = True,
    show_hint: bool = False,
    theme: ThemeEngine,
    prefer_exam: bool = False,
    raw_target: str | None = None,
    use_pager: bool = False,
) -> int:
    """Display an exercise subject and turn-in path in the terminal or pager."""
    if show_hint:
        print(
            theme.status(
                "error",
                "Reference solutions and hints are strictly locked. Use 'subject <ex>' and debug from the Deepthought trace.",
            )
        )
        return 2
    found = resolve_exercise_or_report(str(subject_arg), theme, prefer_exam=prefer_exam)
    if found is None:
        return 1
    rel_subj = found[0]

    s_file = KIT_ROOT / "subjects" / rel_subj / "subject.en.txt"
    clean_leaf = _MODULE_PREFIX_RE.sub("", Path(rel_subj).name)
    turnin_dir = resolve_submission_dir(None, clean_leaf, resolved_subject=rel_subj)

    if show_subject:
        if not s_file.is_file():
            print(theme.c(f"Error: Subject file missing at {s_file}", "err", "bold"))
            return 1
        meta_s = fast_load_yaml(KIT_ROOT / "subjects" / rel_subj / "meta.yml")
        disk_s = parse_subject_disk_metadata(s_file)
        exp_s = meta_s.get("expected_files") or [disk_s["expected_files"]]
        primary_f = str(exp_s[0]) if exp_s else f"{clean_leaf}.c"
        t_subj = tilde_path(s_file)
        t_turnin = tilde_path(turnin_dir)
        out_lines: list[str] = [
            theme.render_subject(
                s_file.read_text(encoding="utf-8", errors="replace"),
                subject_id=clean_leaf,
            ),
            theme.c(f"     subject : {t_subj}", "muted"),
        ]
        internal_meta = {
            "subject.en.txt",
            "examples.txt",
            "meta.yml",
            "tests.yml",
            "scale.yml",
        }
        given_files = sorted(
            p.relative_to(s_file.parent).as_posix()
            for p in s_file.parent.rglob("*")
            if p.is_file()
            and not p.name.startswith(".")
            and p.name not in internal_meta
            and p.suffix.lower() != ".pdf"
        )
        if given_files:
            out_lines.append(
                theme.c(
                    f"     given   : {', '.join(given_files)}  (in {tilde_path(s_file.parent)})",
                    "muted",
                )
            )
        out_lines.append(
            theme.c(
                f"     turn-in : {t_turnin}/{primary_f}{home_note(t_turnin)}", "accent"
            )
        )
        out_lines.append(
            theme.c(f"     grade   : '{clean_leaf}', once that file exists", "muted")
        )
        if "/" not in str(
            raw_target if raw_target is not None else subject_arg
        ).strip().strip("/"):
            namesakes = find_exercise_namesakes(rel_subj)
            if namesakes:
                out_lines.append(
                    theme.c(
                        f"     also    : {', '.join(namesakes)}  (specify module/<ex> or --exam)",
                        "muted",
                    )
                )
        _emit_with_pager("\n".join(out_lines), use_pager=use_pager)
    return 0


def resolve_module_slug(module_id: str) -> str:
    """Resolve a Piscine module alias to its canonical pool slug."""
    slug = module_id.lower().strip()
    alias_file = KIT_ROOT / "pools/official_42_slugs.yml"
    if alias_file.exists():
        aliases = fast_load_yaml(alias_file)
        slug = (aliases.get("piscine") or {}).get(slug, slug)
    return slug


def print_student_progression(theme: ThemeEngine, xp_ledger: str | None) -> None:
    """The 'xp' view: workspace ledger totals (matching grade runs) and persistent profile totals."""
    ledger_p = (
        Path(xp_ledger) if xp_ledger else (KIT_ROOT / "workspace" / "xp_ledger.json")
    )
    prof = load_student_profile()
    prof_xp = int(getattr(prof, "total_xp", getattr(prof, "xp", 0)) or 0)
    prof_level = float(getattr(prof, "level", 0.0) or 0.0)
    ws_xp = 0
    ws_level = 0.0
    ordered: list[str] = []
    ledger_err = ""
    if ledger_p.is_file():
        try:
            ldata = json.loads(ledger_p.read_text(encoding="utf-8"))
            ws_xp = int(ldata.get("total_xp", 0) or 0)
            ws_level = float(ldata.get("level", compute_42_level(ws_xp)) or 0.0)
            validated = (
                ldata.get("validated_exercises")
                or ldata.get("validated_subjects")
                or {}
            )
            ordered = sorted(
                validated,
                key=lambda k: (
                    (validated[k] or {}).get("first_passed_at", 0)
                    if isinstance(validated[k], dict)
                    else 0
                ),
            )
        except (OSError, ValueError, AttributeError, TypeError):
            ledger_err = f"ledger unreadable ({tilde_path(ledger_p)})"

    print(
        f"{theme.c('===>', 'accent', 'bold')} {theme.bold(f'Progression ({prof.login})')}"
    )
    print(
        f"     Workspace : {ws_xp} XP  |  Level : {ws_level:.2f}  |  Validated : {len(ordered)} exercise(s)"
    )
    if prof_xp != ws_xp:
        print(
            theme.c(
                f"     Profile   : {prof_xp} XP  |  Level : {prof_level:.2f}  (~/.42_student_profile.json)",
                "muted",
            )
        )
    if ledger_err:
        print(theme.c(f"     Ledger    : {ledger_err}", "warn"))
        return
    if ordered:
        line = "     Latest    :"
        for label in (short_exercise_label(k) for k in reversed(ordered[-12:])):
            if len(line) + len(label) + 2 > 79:
                break
            line += f" {label},"
        print(line.rstrip(","))


def deepthought_theme_args(theme: ThemeEngine) -> list[str]:
    """Colour flags for bin/deepthought. 'plain' is our internal no-colour theme, not a palette it accepts."""
    return ["--no-color"] if theme.name == "plain" else ["--theme", theme.name]


@contextlib.contextmanager
def exclusive_file_lock(target: Path) -> Iterator[None]:
    """Serialise read-modify-write cycles on `target` across concurrent moulinette runs (advisory lock)."""
    handle = None
    if fcntl is not None:
        try:
            target.parent.mkdir(parents=True, exist_ok=True)
            handle = open(target.with_name(f".{target.name}.lock"), "a+")
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        except OSError:
            if handle is not None:
                handle.close()
            handle = None
    try:
        yield
    finally:
        if handle is not None:
            try:
                fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
            finally:
                handle.close()


_XP_STATUS_TEXT = {
    "FIRST_PASS_XP_AWARDED": "first pass",
    "IDEMPOTENT_ALREADY_VALIDATED": "already validated",
    "KO_ZERO_XP": "not validated",
}


def trace_archive_path(resolved_subject: str) -> Path:
    """Where the last full trace of an exercise is kept (the interactive screen cannot scroll back)."""
    return (
        KIT_ROOT
        / "workspace"
        / "traces"
        / (resolved_subject.replace("/", "__").replace(" ", "_") + ".trace")
    )


LAST_TRACE_FILE: Path | None = None


def _is_inside_corrections(dir_arg: str | None) -> bool:
    """Return True when an explicit submission path targets KIT_ROOT/corrections."""
    if not dir_arg:
        return False
    try:
        resolved = Path(dir_arg).expanduser().resolve()
        corr_root = (KIT_ROOT / "corrections").resolve()
        return resolved == corr_root or corr_root in resolved.parents
    except OSError:
        return False


def evaluate_exercise_or_module(
    subject_arg: str | None,
    module_arg: str | None,
    *,
    explicit_dir: str | None,
    exam_flag: bool,
    norm_flag: bool,
    strict_flag: bool,
    watch_flag: bool,
    is_practice: bool,
    trace_out: str | None,
    xp_ledger: str | None,
    theme: ThemeEngine,
    trace_mode: str = "real",
    on_watch_frame: Callable[[str], None] | None = None,
    allow_corrections: bool = False,
) -> int:
    """Grade a single exercise or full Piscine module, optionally in watch mode."""
    resolved_tm = trace_mode if trace_mode in TRACE_MODES else "real"
    if not allow_corrections and _is_inside_corrections(explicit_dir):
        print(
            theme.c(
                "Error: Refusing '--dir' inside corrections/ without '--self-test' (anti-spoiler policy). "
                "Grade your own workspace/ submission instead.",
                "err",
                "bold",
            )
        )
        return 2
    if module_arg:
        if explicit_dir:
            target_dir = Path(explicit_dir).expanduser().resolve()
        else:
            target_dir = find_module_repo(resolve_module_slug(module_arg))
        cmd = [
            sys.executable,
            str(KIT_ROOT / "bin" / "deepthought"),
            module_arg,
            "--dir",
            str(target_dir),
            "--trace-mode",
            resolved_tm,
            *deepthought_theme_args(theme),
        ]
        if strict_flag:
            cmd.append("--strict")
        return _run_subprocess(cmd)

    if not subject_arg:
        return 1
    if str(subject_arg).strip().lower() in {"clear", "cls"}:
        clear_viewport()
        return 0

    found = resolve_exercise_or_report(str(subject_arg), theme, prefer_exam=exam_flag)
    if found is None:
        return 1
    resolved_subject, default_is_exam = found
    is_exam = True if exam_flag else default_is_exam
    slug_leaf = _MODULE_PREFIX_RE.sub("", Path(resolved_subject).name)
    submit_dir = resolve_submission_dir(
        explicit_dir, slug_leaf, resolved_subject=resolved_subject
    )
    if "/" not in str(subject_arg).strip().strip("/"):
        namesakes = find_exercise_namesakes(resolved_subject)
        if namesakes:
            print(
                theme.c(
                    f"note: grading {short_exercise_label(resolved_subject)}. Same name elsewhere: {', '.join(namesakes)}.",
                    "warn",
                )
            )

    def run_single_grade() -> GradeReport | None:
        """Execute a single grading pass and write the trace artifact."""
        global LAST_TRACE_FILE
        try:
            res = grade_subject(
                KIT_ROOT,
                resolved_subject,
                submit_dir,
                is_exam=is_exam,
                strict=strict_flag or (not is_exam),
                enforce_norm=norm_flag,
                reveal_tests=(resolved_tm == "helpful"),
            )
        except FileNotFoundError as exc:
            # The exercise itself was validated above, so this is the environment, not the student.
            if exc.filename is None:
                print(theme.c(f"Error: cannot grade {slug_leaf}: {exc}", "err", "bold"))
                return None
            print(
                theme.c(
                    f"Error: cannot grade {slug_leaf}: '{exc.filename}' not found on this machine.",
                    "err",
                    "bold",
                )
            )
            print(
                theme.c(
                    "       The grader needs it. This is an environment problem, not your code.",
                    "muted",
                )
            )
            return None
        except OSError as exc:
            print(theme.c(f"Error: cannot grade {slug_leaf}: {exc}", "err", "bold"))
            return None

        rel_subj = resolved_subject
        meta_data = fast_load_yaml(KIT_ROOT / "subjects" / rel_subj / "meta.yml")
        try:
            configured_xp = int(meta_data.get("xp", 150))
        except (TypeError, ValueError):
            configured_xp = 150

        # XP rules: the default ledger is the only one that feeds the student profile. A reference
        # solution (self-test) or an alternative --xp-ledger is recorded apart and never credits it.
        is_corr_eval = (KIT_ROOT / "corrections").resolve() in [
            submit_dir.resolve(),
            *submit_dir.resolve().parents,
        ]
        if xp_ledger:
            ledger_path = Path(xp_ledger)
        elif is_corr_eval:
            ledger_path = KIT_ROOT / "workspace" / ".selftest_xp_ledger.json"
        else:
            ledger_path = KIT_ROOT / "workspace" / "xp_ledger.json"
        credits_profile = not is_corr_eval and not xp_ledger
        xp_res = None
        xp_error = ""
        try:
            with exclusive_file_lock(ledger_path):
                xp_res = XPTracker(ledger_path).record_evaluation(
                    resolved_subject,
                    passed=res.passed,
                    grade=res.grade,
                    configured_xp=configured_xp,
                )
                if xp_res.awarded_xp > 0 and credits_profile:
                    p_prof = load_student_profile()
                    p_prof.award_xp(xp_res.awarded_xp)
                    # Second source of truth: deleting workspace/xp_ledger.json
                    # must not let this exercise be credited again.
                    p_prof.mark_validated(resolved_subject)
                    p_prof.save()
        except (OSError, ValueError, TypeError, AttributeError) as exc:
            xp_error = f"{type(exc).__name__}: {exc}"

        print(colorize_trace(res.trace, theme))
        print("")
        print(
            render_five_gate_scorecard(
                res, theme, is_exam=is_exam, norm_enabled=norm_flag
            )
        )
        if not res.passed and (
            res.is_infrastructure_error or (is_practice and res.trap_diagnostic)
        ):
            summary_block = res.format_exam_trace_summary(include_coaching=is_practice)
            if summary_block:
                print(summary_block)
        status_colored = theme.c(
            f"{res.status} ({res.grade}/100)", "ok" if res.passed else "err", "bold"
        )
        print(f"\nSummary: {res.subject_id} -> {status_colored}")
        if xp_res is None:
            print(
                theme.c(
                    f"XP Progression: not recorded ({xp_error}) [{ledger_path}]", "warn"
                )
            )
        elif is_corr_eval:
            print(
                theme.c(
                    "XP Progression: self-test of the reference solution, student XP unchanged",
                    "muted",
                )
            )
        else:
            note = _XP_STATUS_TEXT.get(
                xp_res.status_code, str(xp_res.status_code).lower()
            )
            if xp_ledger:
                note += ", alternative ledger: student profile unchanged"
            print(
                f"XP Progression: +{xp_res.awarded_xp} XP (Total: {xp_res.total_xp} XP | Level {xp_res.level:.2f}) - {note}"
            )

        if "Nothing turned in" in res.status:
            wanted = ", ".join(expected_turnin_files(rel_subj, slug_leaf))
            print(theme.c(f"     expected : {wanted}", "accent"))
            print(theme.c(f"     in       : {tilde_path(submit_dir)}/", "accent"))
            print(
                theme.c(
                    "     rule     : the folders are yours to create. Elsewhere: --dir <path>",
                    "muted",
                )
            )

        try:
            archive = trace_archive_path(resolved_subject)
            archive.parent.mkdir(parents=True, exist_ok=True)
            trace_out_text = (
                res.trace if res.trace.endswith("\n") else (res.trace + "\n")
            )
            archive.write_text(trace_out_text, encoding="utf-8")
            LAST_TRACE_FILE = archive
            print(theme.c(f"     trace    : {tilde_path(archive)}", "muted"))
        except OSError:
            pass
        if trace_out:
            try:
                Path(trace_out).expanduser().write_text(res.trace, encoding="utf-8")
            except OSError as exc:
                print(
                    theme.c(
                        f"Error: --trace-out: cannot write '{trace_out}': {exc.strerror or exc}",
                        "err",
                        "bold",
                    )
                )
        return res

    if watch_flag:
        if on_watch_frame is None:
            print(
                theme.c(
                    f"[Watch Mode] Watching {submit_dir} for changes (Ctrl+C to stop)...",
                    "primary",
                    "bold",
                )
            )
        last_state: dict[str, tuple[int, int]] | None = None
        try:
            while True:
                cur_state = snapshot_workspace_state(submit_dir)
                if cur_state != last_state:
                    if last_state is not None:
                        time.sleep(0.15)
                        cur_state = snapshot_workspace_state(submit_dir)
                    last_state = cur_state
                    if on_watch_frame is not None:
                        wbuf = io.StringIO()
                        with (
                            contextlib.redirect_stdout(wbuf),
                            contextlib.redirect_stderr(wbuf),
                        ):
                            print(
                                theme.c(
                                    f"[Watch Mode] {tilde_path(submit_dir)} | {time.strftime('%H:%M:%S')} (Ctrl+C stops)",
                                    "accent",
                                    "bold",
                                )
                            )
                            res_w = run_single_grade()
                        on_watch_frame(wbuf.getvalue())
                        if res_w is None:
                            return 1
                    else:
                        print(theme.c("\n" + "=" * 80, "border"))
                        print(
                            theme.c(
                                f"[Watch Mode] File change detected at {time.strftime('%H:%M:%S')} — Running Moulinette...",
                                "accent",
                                "bold",
                            )
                        )
                        if run_single_grade() is None:
                            return 1
                time.sleep(0.5)
        except KeyboardInterrupt:
            if on_watch_frame is None:
                print("\nStopped watch mode.")
            return 0

    res = run_single_grade()
    if res is None:
        return 1
    return 0 if res.passed else 1


def build_completion_vocab(piscine_mods: set[str]) -> list[str]:
    """Return sorted command, module, exam-track, and exercise names for REPL Tab completion."""
    exam_tracks = (
        {p.stem for p in (KIT_ROOT / "pools" / "exams").glob("*.yml")}
        if (KIT_ROOT / "pools" / "exams").is_dir()
        else set()
    )
    commands = {
        "piscine",
        "exams",
        "piscine_exam",
        "back",
        "forward",
        "home",
        "list",
        "subject",
        "init",
        "watch",
        "grade",
        "trace",
        "trace-mode",
        "more",
        "less",
        "xp",
        "guide",
        "doctor",
        "clear",
        "cls",
        "help",
        "quit",
        "exit",
        "--back",
        "--forward",
        "--list",
        "--init",
        "--show-subject",
        "--watch",
        "--strict",
        "--exam",
        "--alt-screen",
        "--scrollback",
    }
    exercises: set[str] = set()
    subj_root = KIT_ROOT / "subjects"
    if (subj_root / "exams").is_dir():
        for ex_dir in (subj_root / "exams").iterdir():
            if ex_dir.is_dir():
                exercises.add(ex_dir.name)
    if (subj_root / "piscine").is_dir():
        for ex_dir in (subj_root / "piscine").glob("*/*"):
            if ex_dir.is_dir():
                exercises.add(ex_dir.name)
                exercises.add(_MODULE_PREFIX_RE.sub("", ex_dir.name))
    return sorted(commands | piscine_mods | exam_tracks | exercises)


def setup_readline_completer(piscine_mods: set[str]) -> list[str]:
    """Configure GNU Readline tab completion for Moulinette REPL commands."""
    vocab = build_completion_vocab(piscine_mods)
    if readline is None or not sys.stdin.isatty():
        return vocab

    def _completer(text: str, state: int) -> str | None:
        matches = [w for w in vocab if w.startswith(text)]
        return matches[state] if state < len(matches) else None

    readline.set_completer_delims(" \t\n;")
    readline.set_completer(_completer)
    if "libedit" in (getattr(readline, "__doc__", "") or ""):
        readline.parse_and_bind("bind ^I rl_complete")
    else:
        readline.parse_and_bind("tab: complete")
    return vocab


def resolve_exercise_in_nav_context(target: str, nav_stack: list[str]) -> str:
    """Resolve an exercise name, 'exNN' code, or row number relative to the active navigation stack."""
    clean = target.strip().strip("/")
    if not clean or any(part in {".", ".."} for part in clean.split("/")):
        return clean
    if len(nav_stack) >= 2 and nav_stack[0] == "piscine":
        mod = nav_stack[1]
        pool_file = KIT_ROOT / "pools" / "piscine" / f"{mod}.yml"
        if pool_file.is_file():
            data = fast_load_yaml(pool_file)
            norm_clean = f"ex{int(clean):02d}" if clean.isdigit() else clean.lower()
            for idx, ex in enumerate(data.get("exercises") or []):
                raw_id = (
                    (ex.get("subject_id") or ex.get("id") or "")
                    if isinstance(ex, dict)
                    else str(ex)
                )
                ex_id = Path(raw_id).name
                ex_code = (
                    ex.get("ex", f"ex{idx:02d}")
                    if isinstance(ex, dict)
                    else f"ex{idx:02d}"
                ).lower()
                clean_leaf = _MODULE_PREFIX_RE.sub("", ex_id)
                if norm_clean in {ex_code, ex_id.lower(), clean_leaf.lower()}:
                    return f"piscine/{mod}/{ex_id}"
    if nav_stack and nav_stack[0] == "piscine exam":
        if len(nav_stack) == 3 and clean.isdigit():
            trk_file = KIT_ROOT / "pools" / "exams" / f"{nav_stack[1]}.yml"
            lvl_num_s = nav_stack[2].replace("level", "").strip()
            if trk_file.is_file() and lvl_num_s.isdigit():
                levels = fast_load_yaml(trk_file).get("levels") or []
                lvl_idx = int(lvl_num_s)
                matched = next(
                    (lvl for lvl in levels if int(lvl.get("level", -1)) == lvl_idx),
                    None,
                )
                cands = (
                    [str(c) for c in (matched.get("candidates") or [])]
                    if matched
                    else []
                )
                row_i = int(clean)
                if 1 <= row_i <= len(cands):
                    return f"exams/{cands[row_i - 1]}"
        if _is_exercise_dir(KIT_ROOT / "subjects" / "exams" / clean):
            return f"exams/{clean}"
    return clean


def interactive_moulinette_repl(
    args: argparse.Namespace, theme: ThemeEngine, is_practice: bool
) -> int:
    """Run the interactive Moulinette catalog explorer and grading REPL."""
    piscine_mods = get_piscine_modules()
    ensure_workspace_directories()
    completion_vocab = setup_readline_completer(piscine_mods)

    nav_stack: list[str] = []
    back_stack: list[list[str]] = []
    forward_stack: list[list[str]] = []

    explicit_scrollback = bool(
        getattr(args, "scrollback", False)
        or os.environ.get("MOULINETTE_SCROLLBACK") == "1"
        or os.environ.get("MOULINETTE_NO_CLEAR")
        or (
            os.environ.get("MOULINETTE_ALT_SCREEN") == "0"
            and not getattr(args, "alt_screen", False)
        )
    )
    use_viewport = is_viewport_tty() and not explicit_scrollback
    active_trace_mode = resolve_trace_mode(args)
    cmd_history: list[str] = []

    state: dict[str, Any] = {
        "mode": "catalog",
        "is_catalog": True,
        "output_title": "",
        "output_lines": [],
        "last_title": "catalog",
        "last_lines": [],
        "notice": "",
    }

    with interactive_terminal_screen(enabled=use_viewport) as vp:
        vp_active = isinstance(vp, ViewportSession) and vp.active

        def _view_label() -> str:
            return "/".join(nav_stack) if nav_stack else "catalog"

        def _screen_rows() -> int:
            _, lines = theme.term_size()
            return max(8, lines - 3)

        def _print_startup_line() -> None:
            mods, piscine_exs, tracks, exam_exs = catalog_counts()
            print(
                theme.c(
                    f"moulinette — {mods} piscine ({piscine_exs} exs) | {tracks} exams ({exam_exs} exs) | '1' piscine | '2' exams | 'help' | 'q'",
                    "muted",
                )
            )

        def _default_nav_hint() -> str:
            """Return the context-appropriate bottom navigation hint within 79 columns."""
            if state["mode"] == "output":
                return "nav: back/list (catalog) | more/less (page) | trace | help | q"
            if not nav_stack:
                return "nav: piscine (1) | exams (2) | <exercise> (grade) | help"
            if nav_stack == ["piscine"]:
                return "nav: <module> (c00) opens it | grade <module> evaluates it | back | help"
            if len(nav_stack) == 2 and nav_stack[0] == "piscine":
                return f"nav: <ex> grades | subject <ex> | init <ex> | grade ({nav_stack[1]}) | back"
            if nav_stack == ["piscine exam"]:
                return "nav: <track> (rank02, exam00) opens it | back | help"
            if len(nav_stack) == 2 and nav_stack[0] == "piscine exam":
                return (
                    "nav: level<N> opens a level | <exercise> grades it | back | help"
                )
            return "nav: <exercise> grades | subject <ex> | init <ex> | back | help"

        def _current_prompt(for_readline: bool | None = None) -> str:
            """Build the interactive prompt reflecting the current navigation path."""
            label = (
                "moulinette> "
                if not nav_stack
                else f"moulinette ({'/'.join(nav_stack)})> "
            )
            styled = theme.c(label, "primary", "bold")
            use_rl = (not vp_active) if for_readline is None else for_readline
            return rl_safe_prompt(styled) if use_rl else styled

        def _viewport_header(_cols: int) -> list[str]:
            """Return empty top chrome so catalog subviews and command output start cleanly."""
            return []

        def _emit_catalog_for_context(rows_budget: int | None) -> None:
            """Emit the catalog listing corresponding to the current navigation stack."""
            if not nav_stack:
                print_sections_menu(theme, include_nav=not vp_active)
            elif nav_stack == ["piscine"]:
                print_catalog_list("piscine", theme, max_rows=rows_budget)
            elif len(nav_stack) == 2 and nav_stack[0] == "piscine":
                print_catalog_list(nav_stack[1], theme, max_rows=rows_budget)
            elif nav_stack == ["piscine exam"]:
                print_catalog_list("piscine exam", theme, max_rows=rows_budget)
            elif len(nav_stack) == 2 and nav_stack[0] == "piscine exam":
                print_catalog_list(nav_stack[1], theme, max_rows=rows_budget)
            elif len(nav_stack) == 3 and nav_stack[0] == "piscine exam":
                lvl_num = nav_stack[2].replace("level", "").strip()
                print_catalog_list(
                    f"{nav_stack[1]}:{lvl_num}", theme, max_rows=rows_budget
                )

        def _home_banner_lines(
            cols: int,
            max_body: int,
            section_lines: list[str],
        ) -> list[str]:
            """Prepend the 42 emblem banner on the root catalog screen when space permits.

            Args:
                cols: Terminal column count.
                max_body: Available body row budget inside the viewport.
                section_lines: Pre-rendered catalog section rows.

            Returns:
                Lines combining the 42 emblem banner and section rows when they fit,
                or ``section_lines`` alone on compact heights.
            """
            w = min(79, max(40, cols - 1))
            banner = theme.tool_banner(
                "moulinette",
                w,
                tagline="42 / 1337 Deepthought Grader (v0.1.1)",
            )
            if banner and len(banner) + 1 + len(section_lines) <= max_body:
                return [*banner, "", *section_lines]
            return section_lines

        def _render_viewport() -> None:
            """Render the current catalog or output view inside the bounded terminal viewport."""
            if not vp_active or vp is None:
                return
            cols, rows = theme.term_size()
            hdr = _viewport_header(cols)
            max_body = max(2, rows - len(hdr) - 2)
            if state["mode"] == "catalog":
                cbuf = io.StringIO()
                with contextlib.redirect_stdout(cbuf):
                    _emit_catalog_for_context(max_body)
                raw_body = cbuf.getvalue().rstrip("\n").splitlines()
                if (
                    not nav_stack
                    and raw_body
                    and _ANSI_SEQ_RE.sub("", raw_body[-1]).lstrip().startswith("nav:")
                ):
                    raw_body.pop()
                while raw_body and not raw_body[-1].strip():
                    raw_body.pop()
                if not nav_stack:
                    raw_body = _home_banner_lines(cols, max_body, raw_body)
                state["last_lines"] = raw_body
                state["last_title"] = _view_label()
            else:
                raw_body = list(state["output_lines"])

            if len(raw_body) <= max_body:
                visible_body = list(raw_body)
                default_footer = theme.c(_default_nav_hint(), "muted")
            else:
                keep = max(1, max_body - 1)
                overflow = theme.c(
                    f"[Showing {keep}/{len(raw_body)} lines — type 'more' to page, or 'less']",
                    "warn",
                    "bold",
                )
                visible_body = [*raw_body[:keep], overflow]
                hidden_summary = next(
                    (
                        ln
                        for ln in reversed(raw_body[keep:])
                        if ln.lstrip().startswith("Summary:")
                    ),
                    None,
                )
                if hidden_summary:
                    default_footer = (
                        f"{hidden_summary} {theme.c('| more | list', 'muted')}"
                    )
                else:
                    default_footer = theme.c(_default_nav_hint(), "muted")

            notice_str = str(state["notice"] or "")
            footer = clip_visible(
                notice_str if notice_str else default_footer, min(79, cols - 1)
            )
            vp.write_frame(
                [*hdr, *visible_body, footer],
                _current_prompt(for_readline=False),
                cols,
                rows,
            )

        def _render_current_context(clear: bool = False) -> None:
            state["mode"] = "catalog"
            state["is_catalog"] = True
            state["notice"] = ""
            if vp_active:
                _render_viewport()
                return
            if clear:
                clear_viewport()
                if not nav_stack:
                    _print_startup_line()
            _emit_catalog_for_context(_screen_rows())
            if nav_stack:
                print(theme.c(_default_nav_hint(), "muted"))

        def _set_notice(msg: str) -> None:
            if vp_active:
                state["notice"] = msg
                _render_viewport()
            else:
                print(msg)

        def _run_captured(title: str, fn: Callable[[], Any]) -> Any:
            if not vp_active:
                return fn()
            obuf = io.StringIO()
            with contextlib.redirect_stdout(obuf), contextlib.redirect_stderr(obuf):
                res = fn()
            raw_out = obuf.getvalue().rstrip("\n")
            lines = raw_out.splitlines() if raw_out else []
            if lines:
                state["mode"] = "output"
                state["is_catalog"] = False
                state["output_title"] = title
                state["output_lines"] = lines
                state["last_title"] = title
                state["last_lines"] = lines
                state["notice"] = ""
                _render_viewport()
            return res

        def _complete_viewport_input(buf_str: str, cursor_pos: int) -> tuple[str, int]:
            left = buf_str[:cursor_pos]
            right = buf_str[cursor_pos:]
            match = re.search(r"(\S+)$", left)
            prefix = match.group(1) if match else ""
            start_idx = match.start(1) if match else len(left)
            if not prefix:
                top_cmds = [
                    "piscine",
                    "exams",
                    "subject",
                    "init",
                    "grade",
                    "watch",
                    "more",
                    "less",
                    "trace",
                    "xp",
                ]
                state["notice"] = theme.c("commands: " + "  ".join(top_cmds), "info")
                _render_viewport()
                return buf_str, cursor_pos
            matches = [w for w in completion_vocab if w.startswith(prefix)]
            if not matches:
                state["notice"] = theme.c(f"no completion for '{prefix}'", "muted")
                _render_viewport()
                return buf_str, cursor_pos
            if len(matches) == 1:
                suffix = "" if right.startswith(" ") else " "
                new_left = left[:start_idx] + matches[0] + suffix
                state["notice"] = ""
                _render_viewport()
                return new_left + right, len(new_left)
            common = os.path.commonprefix(matches)
            extended = common if len(common) > len(prefix) else prefix
            new_left = left[:start_idx] + extended
            extra_s = f" (+{len(matches) - 8} more)" if len(matches) > 8 else ""
            state["notice"] = theme.c(
                f"completions: {'  '.join(matches[:8])}{extra_s}", "info"
            )
            _render_viewport()
            return new_left + right, len(new_left)

        def _navigate_to(target_path: list[str]) -> None:
            if target_path != nav_stack:
                back_stack.append(list(nav_stack))
                forward_stack.clear()
                nav_stack[:] = list(target_path)
            _render_current_context(clear=False)

        def _go_back() -> None:
            if vp_active and state["mode"] == "output":
                _render_current_context(clear=False)
                return
            if back_stack:
                forward_stack.append(list(nav_stack))
                nav_stack[:] = back_stack.pop()
            elif nav_stack:
                forward_stack.append(list(nav_stack))
                nav_stack.pop()
            _render_current_context(clear=False)

        def _go_forward() -> None:
            if forward_stack:
                back_stack.append(list(nav_stack))
                nav_stack[:] = forward_stack.pop()
                _render_current_context(clear=False)
            else:
                _set_notice(theme.c("Already at the latest forward view.", "muted"))

        def _guarded(func: Any, *f_args: Any, **f_kwargs: Any) -> Any:
            """Run one command; a failure ends that command, not the session."""
            try:
                return func(*f_args, **f_kwargs)
            except ExerciseLookupError as exc:
                print(theme.c(f"Error: {exc}", "err", "bold"))
            except Exception as exc:  # noqa: BLE001 - the session must survive a faulty command
                if os.environ.get("MOULINETTE_DEBUG"):
                    raise
                print(
                    theme.c(
                        f"Internal error: {type(exc).__name__}: {exc}", "err", "bold"
                    )
                )
                print(
                    theme.c(
                        "Session kept alive. Set MOULINETTE_DEBUG=1 for the traceback.",
                        "muted",
                    )
                )
            return 1

        def _show_last_trace(use_pager: bool = False) -> None:
            state["is_catalog"] = False
            if LAST_TRACE_FILE is None or not LAST_TRACE_FILE.is_file():
                msg = theme.c("No trace yet: grade an exercise first.", "warn", "bold")
                if vp_active:
                    _set_notice(msg)
                else:
                    print(msg)
                return
            try:
                trace_raw = LAST_TRACE_FILE.read_text(
                    encoding="utf-8", errors="replace"
                ).rstrip("\n")
            except OSError as exc:
                msg = theme.c(f"Cannot read trace: {exc}", "err", "bold")
                if vp_active:
                    _set_notice(msg)
                else:
                    print(msg)
                return
            colored = colorize_trace(trace_raw, theme) if trace_raw else "(empty trace)"
            file_line = theme.c(f"trace file: {tilde_path(LAST_TRACE_FILE)}", "muted")
            if vp_active:
                trace_lines = [*colored.splitlines(), file_line]
                state["mode"] = "output"
                state["output_title"] = f"trace: {LAST_TRACE_FILE.name}"
                state["output_lines"] = trace_lines
                state["last_title"] = state["output_title"]
                state["last_lines"] = trace_lines
                state["notice"] = ""
                if use_pager and vp is not None:
                    vp.run_pager(
                        state["output_title"], trace_lines, _viewport_header, theme
                    )
                _render_viewport()
                return
            _emit_with_pager(colored if trace_raw else "", use_pager=use_pager)
            print(file_line)

        def _print_help() -> None:
            """Display interactive moulinette commands in the classic 42 Bocal format."""
            ws_tilde = _fit_catalog_path_line(
                "", tilde_path(KIT_ROOT / "workspace"), "", 44
            )
            subj_tilde = _fit_catalog_path_line(
                "", tilde_path(KIT_ROOT / "subjects"), "", 44
            )
            print(
                f"{theme.c('===>', 'accent', 'bold')} {theme.bold('moulinette commands')}"
            )
            print(
                theme.status(
                    "status",
                    "New here? : guide [ex] (step-by-step) | doctor (check setup)",
                )
            )
            print(
                theme.status(
                    "status",
                    "Browse    : piscine | exams | <module> (c00) | <track> | level<N>",
                )
            )
            print(
                theme.status(
                    "status",
                    "Move      : back (b, ..) | forward (f) | home | list | clear | q",
                )
            )
            print(
                theme.status(
                    "status",
                    "42 way    : read subject, mkdir <module>/<exNN>, write, <ex>",
                )
            )
            print(
                theme.status(
                    "status",
                    "Grade     : <ex> grades | watch <ex> (on save) | grade <module>",
                )
            )
            print(
                theme.status(
                    "status",
                    "Shortcut  : subject <ex> prints it | init <ex> (optional folder)",
                )
            )
            print(
                theme.status(
                    "status",
                    "Options   : --strict --norm --exam --self-test --dir <path>",
                )
            )
            print(
                theme.status(
                    "status", "            --trace-mode real|helpful --scrollback"
                )
            )
            print(
                theme.status(
                    "status",
                    "Read      : trace | more | less | trace-mode | xp (your progress)",
                )
            )
            print(
                theme.status(
                    "status",
                    _fit_catalog_path_line(
                        "Subjects  : ", f"{subj_tilde}/piscine/<module>/<ex>/", "", 75
                    ),
                )
            )
            print(
                theme.status(
                    "status",
                    _fit_catalog_path_line(
                        "Turn-in   : ",
                        f"{ws_tilde}/piscine/<module>/<exNN>/",
                        home_note(ws_tilde),
                        75,
                    ),
                )
            )
            print(
                theme.status(
                    "status",
                    "Names     : exact. 'c01/ft_strlen' disambiguates colliding names.",
                )
            )
            print(
                theme.status(
                    "status",
                    "Example   : subject ft_putchar, then ft_putchar once file exists",
                )
            )

        prev_winch = None
        if not vp_active and hasattr(signal, "SIGWINCH") and sys.stdout.isatty():

            def _on_readline_sigwinch(_signum: int, _frame: Any) -> None:
                if readline is not None:
                    try:
                        if hasattr(readline, "redisplay"):
                            readline.redisplay()
                        elif hasattr(readline, "forced_update_display"):
                            readline.forced_update_display()
                    except Exception:
                        pass

            prev_winch = signal.getsignal(signal.SIGWINCH)
            signal.signal(signal.SIGWINCH, _on_readline_sigwinch)

        try:
            if vp_active:
                _render_current_context(clear=True)
            else:
                _print_startup_line()

            while True:
                try:
                    if vp_active and vp is not None:
                        raw = vp.read_line(
                            _current_prompt(for_readline=False),
                            theme,
                            redraw_fn=lambda _b, _p: _render_viewport(),
                            clear_fn=lambda _b, _p: _render_viewport(),
                            completer_fn=_complete_viewport_input,
                            history=cmd_history,
                        ).strip()
                    else:
                        raw = input(_current_prompt(for_readline=True)).strip()
                except EOFError:
                    if not vp_active:
                        print("\n" + theme.c("Session closed.", "muted"))
                    return 0
                except KeyboardInterrupt:
                    if vp_active:
                        _set_notice(
                            theme.c(
                                "Interrupted. Type 'back', 'forward', or 'q' to exit.",
                                "warn",
                            )
                        )
                    else:
                        print(
                            "^C\n"
                            + theme.c(
                                "Interrupted. Type 'back', 'forward', or 'q' to exit.",
                                "muted",
                            )
                        )
                    continue

                if not raw:
                    if vp_active and state["notice"]:
                        state["notice"] = ""
                        _render_viewport()
                    continue

                if not cmd_history or cmd_history[-1] != raw:
                    cmd_history.append(raw)
                if vp_active:
                    state["notice"] = ""
                low_raw = raw.lower().strip()

                if low_raw in {"q", "quit", "exit"}:
                    return 0

                if low_raw in {
                    "back",
                    "--back",
                    "-b",
                    "b",
                    "..",
                    "prev",
                    "up",
                    "return",
                    "cd ..",
                }:
                    _go_back()
                    continue

                if low_raw in {"forward", "--forward", "-f", "f", "next", "redo"}:
                    _go_forward()
                    continue

                if low_raw in {"home", "root", "top"}:
                    _navigate_to([])
                    continue

                if low_raw in {"clear", "cls"}:
                    _render_current_context(clear=True)
                    continue

                if raw == "\x0c":
                    if vp_active:
                        _render_viewport()
                    else:
                        _render_current_context(clear=True)
                    continue

                if low_raw in {"more", "--more"}:
                    if vp_active and vp is not None:
                        if state["last_lines"]:
                            vp.run_pager(
                                state["last_title"] or "output",
                                state["last_lines"],
                                _viewport_header,
                                theme,
                            )
                            _render_viewport()
                        else:
                            _set_notice(
                                theme.c(
                                    "Nothing to page — type 'help' for commands.",
                                    "muted",
                                )
                            )
                    else:
                        _print_help()
                    continue

                if low_raw in {"help", "?", "--help", "-h"}:
                    _run_captured("help", _print_help)
                    continue

                if low_raw in {
                    "guide",
                    "start",
                    "howto",
                    "how-to",
                    "--guide",
                } or low_raw.startswith("guide "):
                    guide_arg = (
                        raw.strip().split(None, 1)[1].strip()
                        if (" " in raw.strip() and low_raw.startswith("guide "))
                        else None
                    )
                    _run_captured("guide", lambda: print_guide(theme, guide_arg))
                    continue

                if low_raw in {"doctor", "check", "setup", "diagnose", "--doctor"}:
                    _run_captured("doctor", lambda: print_doctor(theme))
                    continue

                # Inside piscine module list, 0..13 open c00..c13 directly.
                if nav_stack == ["piscine"] and low_raw.isdigit():
                    mod_idx = int(low_raw)
                    mod_name = f"c{mod_idx:02d}"
                    if 0 <= mod_idx <= 13 and mod_name in piscine_mods:
                        _navigate_to(["piscine", mod_name])
                        continue
                    _set_notice(
                        theme.c(
                            f"Enter module 0..13 (c00..c13) or name ({', '.join(piscine_mods[:6])}...).",
                            "warn",
                            "bold",
                        )
                    )
                    continue

                # Inside exam track list, 1..N open that track.
                visible_tracks = [
                    t
                    for t in OFFICIAL_EXAM_TRACKS
                    if (KIT_ROOT / "pools" / "exams" / f"{t}.yml").exists()
                ]
                if nav_stack == ["piscine exam"] and low_raw.isdigit():
                    trk_idx = int(low_raw)
                    if 1 <= trk_idx <= len(visible_tracks):
                        _navigate_to(["piscine exam", visible_tracks[trk_idx - 1]])
                        continue
                    _set_notice(
                        theme.c(
                            f"Enter track 1..{len(visible_tracks)} or track name.",
                            "warn",
                            "bold",
                        )
                    )
                    continue

                # Inside an exam track a number is a level ('level1', 'lvl1', or '1' at depth 2).
                if len(nav_stack) >= 2 and nav_stack[0] == "piscine exam":
                    lvl_pat = (
                        r"^(?:level\s*|lvl\s*)?(\d+)$"
                        if len(nav_stack) == 2
                        else r"^(?:level\s*|lvl\s*)(\d+)$"
                    )
                    m_lvl = re.match(lvl_pat, low_raw)
                    if m_lvl:
                        lvl_idx = int(m_lvl.group(1))
                        trk_file = KIT_ROOT / "pools" / "exams" / f"{nav_stack[1]}.yml"
                        trk_levels = (
                            (fast_load_yaml(trk_file).get("levels") or [])
                            if trk_file.is_file()
                            else []
                        )
                        valid_lvls = {
                            int(lvl.get("level", i)) for i, lvl in enumerate(trk_levels)
                        }
                        if lvl_idx in valid_lvls:
                            _navigate_to(
                                ["piscine exam", nav_stack[1], f"level{lvl_idx}"]
                            )
                            continue
                        _set_notice(
                            theme.c(
                                f"No level {lvl_idx} in {nav_stack[1]}. Levels: {', '.join(str(v) for v in sorted(valid_lvls))}.",
                                "warn",
                                "bold",
                            )
                        )
                        continue

                if (not nav_stack and low_raw == "1") or low_raw in {
                    "piscine",
                    "piscines",
                    "cd piscine",
                    "use piscine",
                }:
                    _navigate_to(["piscine"])
                    continue

                if (not nav_stack and low_raw == "2") or low_raw in {
                    "piscine exam",
                    "piscine exams",
                    "piscine_exam",
                    "exam",
                    "exams",
                    "cd exam",
                    "cd exams",
                    "use exam",
                    "use exams",
                }:
                    _navigate_to(["piscine exam"])
                    continue

                try:
                    tokens = shlex.split(raw)
                except ValueError as exc:
                    _set_notice(theme.c(f"Parse error: {exc}", "err", "bold"))
                    continue

                explicit_grade_cmd = tokens[0].lower() in {"grade", "eval"}
                if explicit_grade_cmd and len(tokens) == 1:
                    if len(nav_stack) == 2 and nav_stack[0] == "piscine":
                        _run_captured(
                            f"grade {nav_stack[1]}",
                            lambda: _guarded(
                                evaluate_exercise_or_module,
                                None,
                                nav_stack[1],
                                explicit_dir=args.dir,
                                exam_flag=False,
                                norm_flag=args.norm,
                                strict_flag=args.strict,
                                watch_flag=args.watch,
                                is_practice=is_practice,
                                trace_out=args.trace_out,
                                xp_ledger=args.xp_ledger,
                                theme=theme,
                                trace_mode=active_trace_mode,
                            ),
                        )
                        continue
                    _set_notice(
                        theme.c("Usage: grade <exercise|module>", "warn", "bold")
                    )
                    continue

                if explicit_grade_cmd and len(tokens) > 1:
                    tokens = tokens[1:]

                cmd0 = tokens[0].lower()
                arg1 = " ".join(tokens[1:]).strip() if len(tokens) > 1 else None
                in_exam_section = bool(nav_stack and nav_stack[0] == "piscine exam")

                if cmd0 in {
                    "solution",
                    "--solution",
                    "solve",
                    "--solve",
                    "hint",
                    "--hint",
                }:
                    _run_captured(
                        "locked",
                        lambda: print(
                            theme.status(
                                "error",
                                "Reference solutions and hints are strictly locked. Use 'subject <ex>' and debug from the Deepthought trace.",
                            )
                        ),
                    )
                    continue

                if cmd0 in {"list", "--list", "ls", "catalog", "--catalog"}:
                    if not arg1:
                        _render_current_context(clear=False)
                        continue
                    arg1_low = arg1.lower()
                    if arg1_low in {"piscine", "piscines", "1"}:
                        _navigate_to(["piscine"])
                        continue
                    if arg1_low in {
                        "piscine exam",
                        "piscine_exam",
                        "exam",
                        "exams",
                        "2",
                    }:
                        _navigate_to(["piscine exam"])
                        continue
                    if arg1_low in piscine_mods or arg1_low in {
                        "rush00",
                        "rush01",
                        "rush02",
                        "bsq",
                        "rush",
                    }:
                        mod_t = (
                            "rush_bsq"
                            if arg1_low in {"rush00", "rush01", "rush02", "bsq", "rush"}
                            else arg1_low
                        )
                        _navigate_to(["piscine", mod_t])
                        continue
                    trk_t = resolve_exam_track_name(arg1_low)
                    if trk_t:
                        _navigate_to(["piscine exam", trk_t])
                        continue
                    _run_captured(
                        f"list {arg1}", lambda: print_catalog_list(arg1, theme)
                    )
                    continue

                if cmd0 in {"xp", "stats", "history"}:
                    _run_captured(
                        "xp", lambda: print_student_progression(theme, args.xp_ledger)
                    )
                    continue

                if cmd0 == "trace-mode" or (
                    cmd0 == "trace" and len(tokens) >= 2 and tokens[1].lower() == "mode"
                ):
                    new_tm, err_tm = parse_trace_mode_arg(" ".join(tokens[1:]))
                    if err_tm:
                        _set_notice(theme.c(err_tm, "warn", "bold"))
                    elif new_tm:
                        active_trace_mode = new_tm
                        desc = (
                            "42 real (hidden c_function inputs/diffs)"
                            if new_tm == "real"
                            else "helpful (unified diffs shown)"
                        )
                        _set_notice(
                            theme.c(
                                f"Trace mode set to '{active_trace_mode}' — {desc}.",
                                "ok",
                                "bold",
                            )
                        )
                    else:
                        desc = (
                            "42 real (hidden c_function inputs/diffs)"
                            if active_trace_mode == "real"
                            else "helpful (unified diffs shown)"
                        )
                        _set_notice(
                            theme.c(
                                f"Current trace mode: {active_trace_mode} ({desc}). Switch: trace-mode [real|helpful]",
                                "info",
                            )
                        )
                    continue

                if cmd0 == "trace":
                    _show_last_trace(use_pager=False)
                    continue

                if cmd0 == "less":
                    if len(tokens) == 1:
                        if (
                            vp_active
                            and vp is not None
                            and state["mode"] == "output"
                            and state["last_lines"]
                        ):
                            vp.run_pager(
                                state["last_title"] or "output",
                                state["last_lines"],
                                _viewport_header,
                                theme,
                            )
                            _render_viewport()
                        else:
                            _show_last_trace(use_pager=True)
                    elif tokens[1].lower() == "trace":
                        _show_last_trace(use_pager=True)
                    elif (
                        tokens[1].lower() in {"subject", "--show-subject", "-s"}
                        and len(tokens) == 3
                    ):
                        ctx_target = resolve_exercise_in_nav_context(
                            tokens[2], nav_stack
                        )
                        if vp_active and vp is not None:
                            _run_captured(
                                f"subject: {ctx_target}",
                                lambda: _guarded(
                                    handle_subject_inspection,
                                    ctx_target,
                                    show_subject=True,
                                    show_hint=False,
                                    theme=theme,
                                    prefer_exam=in_exam_section or args.exam,
                                    raw_target=tokens[2],
                                    use_pager=False,
                                ),
                            )
                            if state["output_lines"]:
                                vp.run_pager(
                                    state["output_title"],
                                    state["output_lines"],
                                    _viewport_header,
                                    theme,
                                )
                                _render_viewport()
                        else:
                            _guarded(
                                handle_subject_inspection,
                                ctx_target,
                                show_subject=True,
                                show_hint=False,
                                theme=theme,
                                prefer_exam=in_exam_section or args.exam,
                                raw_target=tokens[2],
                                use_pager=True,
                            )
                    else:
                        _set_notice(
                            theme.c("Usage: less [trace | subject <exercise>]", "warn")
                        )
                    continue

                first_arg = tokens[1] if len(tokens) > 1 else None
                if (
                    cmd0 in {"init", "--init", "subject", "--show-subject", "-s"}
                    and len(tokens) > 2
                ):
                    _set_notice(
                        theme.c(
                            f"Usage: {cmd0} <exercise>   (one name; quote it if it contains spaces)",
                            "warn",
                            "bold",
                        )
                    )
                    continue
                if (
                    cmd0
                    in {
                        "init",
                        "--init",
                        "subject",
                        "--show-subject",
                        "-s",
                        "watch",
                        "--watch",
                    }
                    and not first_arg
                ):
                    _set_notice(theme.c(f"Usage: {cmd0} <exercise>", "warn", "bold"))
                    continue

                if cmd0 in {"init", "--init"} and first_arg:
                    ctx_target = resolve_exercise_in_nav_context(first_arg, nav_stack)
                    _run_captured(
                        f"init {ctx_target}",
                        lambda: _guarded(
                            scaffold_exercise_workspace,
                            ctx_target,
                            args.dir,
                            theme,
                            prefer_exam=in_exam_section or args.exam,
                        ),
                    )
                    continue
                if cmd0 in {"subject", "--show-subject", "-s"} and first_arg:
                    ctx_target = resolve_exercise_in_nav_context(first_arg, nav_stack)
                    _run_captured(
                        f"subject {ctx_target}",
                        lambda: _guarded(
                            handle_subject_inspection,
                            ctx_target,
                            show_subject=True,
                            show_hint=False,
                            theme=theme,
                            prefer_exam=in_exam_section or args.exam,
                            raw_target=first_arg,
                        ),
                    )
                    continue

                repl_watch = args.watch or (cmd0 in {"watch", "--watch"})
                repl_exam = args.exam or in_exam_section
                repl_norm = args.norm
                repl_strict = args.strict
                repl_trace_mode = active_trace_mode
                repl_self_test = False
                repl_dir = args.dir
                line_has_dir = False
                target_tok: str | None = (
                    first_arg if cmd0 in {"watch", "--watch"} else None
                )

                # Nothing typed is dropped silently: an unknown option or a second name is an error.
                parse_error = ""
                idx_t = 2 if cmd0 in {"watch", "--watch"} else 0
                while idx_t < len(tokens) and not parse_error:
                    tok = tokens[idx_t]
                    if tok in {"--watch", "-w"}:
                        repl_watch = True
                    elif tok == "--exam":
                        repl_exam = True
                    elif tok == "--norm":
                        repl_norm = True
                    elif tok == "--strict":
                        repl_strict = True
                    elif tok == "--self-test":
                        repl_self_test = True
                    elif tok == "--helpful":
                        repl_trace_mode = "helpful"
                    elif tok.startswith("--trace-mode="):
                        val_tm = tok.split("=", 1)[1].strip().lower()
                        if val_tm in TRACE_MODES:
                            repl_trace_mode = val_tm
                        else:
                            parse_error = (
                                f"--trace-mode must be one of: {', '.join(TRACE_MODES)}"
                            )
                    elif tok == "--trace-mode":
                        if idx_t + 1 >= len(tokens):
                            parse_error = "--trace-mode needs 'real' or 'helpful'."
                        else:
                            val_tm = tokens[idx_t + 1].strip().lower()
                            if val_tm in TRACE_MODES:
                                repl_trace_mode = val_tm
                                idx_t += 1
                            else:
                                parse_error = f"--trace-mode must be one of: {', '.join(TRACE_MODES)}"
                    elif tok in {"--dir", "--path"}:
                        if idx_t + 1 >= len(tokens):
                            parse_error = f"{tok} needs a directory."
                        else:
                            repl_dir = tokens[idx_t + 1]
                            line_has_dir = True
                            idx_t += 1
                    elif tok.startswith("-"):
                        parse_error = f"Unknown option '{tok}'. Options: --strict --norm --exam --watch --self-test --trace-mode --helpful --dir <path>"
                    elif target_tok is None:
                        target_tok = tok
                    else:
                        parse_error = f"Unexpected '{tok}' after '{target_tok}'. One exercise at a time; quote a name that contains spaces."
                    idx_t += 1
                if not parse_error and not target_tok:
                    parse_error = "Usage: <exercise> [--strict] [--norm] [--exam] [--watch] [--dir <path>]"
                if not parse_error and repl_self_test and repl_dir:
                    parse_error = "--self-test grades the reference solution; it cannot be combined with --dir."
                if parse_error:
                    _set_notice(theme.c(parse_error, "warn", "bold"))
                    if not vp_active:
                        print("")
                    continue
                assert target_tok is not None

                exam_trk = resolve_exam_track_name(target_tok)
                if exam_trk and not explicit_grade_cmd:
                    _navigate_to(["piscine exam", exam_trk])
                    continue

                is_mod = target_tok.lower() in piscine_mods
                has_extra_flags = repl_watch or repl_self_test or line_has_dir
                if (
                    is_mod
                    and not explicit_grade_cmd
                    and not has_extra_flags
                    and nav_stack != ["piscine", target_tok.lower()]
                ):
                    _navigate_to(["piscine", target_tok.lower()])
                    continue

                resolved_tok = (
                    target_tok
                    if is_mod
                    else resolve_exercise_in_nav_context(target_tok, nav_stack)
                )

                if repl_self_test and not repl_dir:
                    if is_mod:
                        if vp_active:
                            state["notice"] = theme.c(
                                f"running self-test on {target_tok.lower()}...",
                                "info",
                                "bold",
                            )
                            _render_viewport()
                        _run_captured(
                            f"self-test {target_tok.lower()}",
                            lambda: _run_subprocess(
                                [
                                    sys.executable,
                                    str(KIT_ROOT / "bin" / "deepthought"),
                                    target_tok.lower(),
                                    "--self-test",
                                    "--trace-mode",
                                    repl_trace_mode,
                                    *deepthought_theme_args(theme),
                                ]
                            ),
                        )
                        if not vp_active:
                            print("")
                        continue
                    found_s = (
                        resolve_exercise_or_report(
                            resolved_tok, theme, prefer_exam=repl_exam
                        )
                        if not vp_active
                        else None
                    )
                    if vp_active:
                        sbuf = io.StringIO()
                        with (
                            contextlib.redirect_stdout(sbuf),
                            contextlib.redirect_stderr(sbuf),
                        ):
                            found_s = resolve_exercise_or_report(
                                resolved_tok, theme, prefer_exam=repl_exam
                            )
                        if found_s is None:
                            s_lines = sbuf.getvalue().rstrip("\n").splitlines()
                            if s_lines:
                                state["mode"] = "output"
                                state["is_catalog"] = False
                                state["output_title"] = f"self-test {target_tok}"
                                state["output_lines"] = s_lines
                                state["last_title"] = state["output_title"]
                                state["last_lines"] = s_lines
                                state["notice"] = ""
                                _render_viewport()
                            continue
                    elif found_s is None:
                        print("")
                        continue
                    assert found_s is not None
                    if not (KIT_ROOT / "corrections" / found_s[0]).is_dir():
                        err_s = theme.c(
                            f"Error: no reference solution for {short_exercise_label(found_s[0])}.",
                            "err",
                            "bold",
                        )
                        if vp_active:
                            _set_notice(err_s)
                        else:
                            print(err_s)
                            print("")
                        continue
                    resolved_tok = found_s[0]
                    repl_dir = str((KIT_ROOT / "corrections" / found_s[0]).resolve())

                if vp_active and repl_watch:

                    def _on_watch_output(text: str) -> None:
                        w_lines = text.rstrip("\n").splitlines() or [
                            "(waiting for files...)"
                        ]
                        state["mode"] = "output"
                        state["is_catalog"] = False
                        state["output_title"] = f"watch: {target_tok}"
                        state["output_lines"] = w_lines
                        state["last_title"] = state["output_title"]
                        state["last_lines"] = w_lines
                        state["notice"] = theme.c(
                            "watch active — save a file to re-grade | Ctrl+C stops",
                            "muted",
                        )
                        _render_viewport()

                    _guarded(
                        evaluate_exercise_or_module,
                        None if is_mod else resolved_tok,
                        target_tok.lower() if is_mod else None,
                        explicit_dir=repl_dir,
                        exam_flag=repl_exam,
                        norm_flag=repl_norm,
                        strict_flag=repl_strict,
                        watch_flag=True,
                        is_practice=is_practice,
                        trace_out=args.trace_out,
                        xp_ledger=args.xp_ledger,
                        theme=theme,
                        trace_mode=repl_trace_mode,
                        on_watch_frame=_on_watch_output,
                        allow_corrections=repl_self_test,
                    )
                    state["notice"] = theme.c("Stopped watch mode.", "info")
                    _render_viewport()
                    continue

                if vp_active:
                    state["notice"] = theme.c(
                        f"grading {target_tok}...", "info", "bold"
                    )
                    _render_viewport()

                _run_captured(
                    f"grade {target_tok}",
                    lambda: _guarded(
                        evaluate_exercise_or_module,
                        None if is_mod else resolved_tok,
                        target_tok.lower() if is_mod else None,
                        explicit_dir=repl_dir,
                        exam_flag=repl_exam,
                        norm_flag=repl_norm,
                        strict_flag=repl_strict,
                        watch_flag=repl_watch,
                        is_practice=is_practice,
                        trace_out=args.trace_out,
                        xp_ledger=args.xp_ledger,
                        theme=theme,
                        trace_mode=repl_trace_mode,
                        allow_corrections=repl_self_test,
                    ),
                )
                if not vp_active:
                    print("")
        finally:
            if prev_winch is not None and hasattr(signal, "SIGWINCH"):
                signal.signal(signal.SIGWINCH, prev_winch)


def main() -> int:
    """CLI entrypoint for Moulinette."""
    parser = argparse.ArgumentParser(
        description="42 / 1337 Moulinette & Deepthought Grader"
    )
    parser.add_argument(
        "target",
        nargs="?",
        help="Exercise slug (e.g., ft_strlen, c01/ft_strlen), module, or command (subject, init, watch, guide, doctor, piscine, exams)",
    )
    parser.add_argument(
        "extra",
        nargs="*",
        help="Optional subcommand arguments or tokens (e.g. subject ft_strlen, init ft_strlen)",
    )
    parser.add_argument("--subject", help="Subject identifier")
    parser.add_argument("--module", help="Grade an entire Piscine module")
    parser.add_argument(
        "--dir",
        "--path",
        dest="dir",
        default=None,
        help="Directory containing user submission",
    )
    parser.add_argument(
        "--exam",
        action="store_true",
        help="Grade in exam mode (Norminette disabled unless --norm)",
    )
    parser.add_argument(
        "--norm",
        action="store_true",
        help="Force 42 Norminette check even in exam mode",
    )
    parser.add_argument(
        "--strict",
        action="store_true",
        help="Strict Piscine mode (Norminette + forbidden symbols)",
    )
    parser.add_argument(
        "--init",
        action="store_true",
        help="Scaffold a starter folder with 42 header and subject.en.txt",
    )
    parser.add_argument(
        "--show-subject",
        "-S",
        action="store_true",
        help="Display formatted subject.en.txt for the exercise",
    )
    parser.add_argument(
        "--practice", action="store_true", help="Enable special practice mode"
    )
    parser.add_argument(
        "--mode",
        choices=["real", "practice"],
        default="real",
        help="Operating mode (default: real)",
    )
    parser.add_argument(
        "--watch",
        action="store_true",
        help="Live watch mode: re-grade automatically on file save",
    )
    parser.add_argument(
        "--list",
        nargs="?",
        const="__all__",
        default=None,
        help="List Piscine modules, Exam tracks, or exercises in a module/track",
    )
    parser.add_argument("--trace-out", help="Optional path to save Deepthought trace")
    parser.add_argument(
        "--xp-ledger",
        default=None,
        help="Alternative XP ledger JSON file (kept apart: it never credits the student profile)",
    )
    parser.add_argument(
        "--theme", default="42-cluster", choices=sorted(PALETTES), help="Color palette"
    )
    parser.add_argument(
        "--catalog", action="store_true", help="Display complete Piscine & Exam catalog"
    )
    parser.add_argument(
        "--self-test",
        action="store_true",
        help="Grade reference solution in corrections/ to verify environment",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Grade one exercise and print the report as JSON (no XP recorded)",
    )
    parser.add_argument("--no-color", action="store_true", help="Disable ANSI colors")
    parser.add_argument(
        "--alt-screen",
        action="store_true",
        help="Use bounded alternate-screen viewport (default on interactive TTY)",
    )
    parser.add_argument(
        "--scrollback",
        action="store_true",
        help="Use classic scrollback REPL instead of the alternate-screen viewport",
    )
    add_trace_mode_arguments(parser)
    if any(
        arg.split("=", 1)[0].strip().lower() in {"--solution", "--solve", "--hint"}
        for arg in sys.argv[1:]
    ):
        print(
            "Error: Reference solutions and hints are strictly locked in Moulinette to preserve the 42 / 1337 peer-learning methodology. Use 'subject <ex>' and debug from the Deepthought trace."
        )
        return 2
    args = parser.parse_args()

    # Options that cannot be honoured together are refused, not silently dropped.
    if args.json and (args.watch or args.module):
        parser.error(
            "--json grades a single exercise once: it cannot be combined with --watch or --module."
        )
    if args.self_test and args.dir:
        parser.error(
            "--self-test grades the reference solution: it cannot be combined with --dir."
        )
    if args.trace_out:
        trace_target = Path(args.trace_out).expanduser()
        if trace_target.is_dir() or not trace_target.parent.is_dir():
            parser.error(
                f"--trace-out: '{args.trace_out}' is not a writable file path."
            )

    use_plain = (
        args.no_color
        or bool(os.environ.get("NO_COLOR"))
        or (not sys.stdout.isatty() and os.environ.get("FORCE_COLOR") != "1")
    )
    theme = ThemeEngine("plain" if use_plain else args.theme)
    is_practice = bool(args.practice or args.mode == "practice")
    ensure_workspace_directories()

    t_raw = (args.target or "").strip()
    extra_tokens = [tok.strip() for tok in getattr(args, "extra", []) if tok.strip()]
    full_cmd = f"{t_raw} {' '.join(extra_tokens)}".strip()
    full_cmd_low = full_cmd.lower()
    t_low = t_raw.lower()

    if getattr(args, "catalog", False):
        return print_catalog_list(full_cmd or None, theme)
    if args.list is not None:
        mod_filter = None if args.list == "__all__" else args.list
        return print_catalog_list(mod_filter or full_cmd or None, theme)

    # 0. Anti-spoiler solution & hint blocker:
    if t_low in {"solution", "--solution", "solve", "--solve", "hint", "--hint"} or any(
        tok.lower() in {"solution", "--solution", "solve", "--solve", "hint", "--hint"}
        for tok in extra_tokens
    ):
        print(
            theme.status(
                "error",
                "Reference solutions and hints are strictly locked. Use 'subject <ex>' and debug from the Deepthought trace.",
            )
        )
        return 2

    # Subcommand routing for documented CLI patterns:
    # 0b. guide [ex] / doctor
    if t_low in {"guide", "start", "howto", "how-to", "--guide"}:
        ex_arg = extra_tokens[0] if extra_tokens else args.subject
        return print_guide(theme, str(ex_arg) if ex_arg else None)

    if t_low in {"doctor", "check", "setup", "diagnose", "--doctor"}:
        return print_doctor(theme)

    # 1. subject <ex>
    if t_low in {"subject", "show-subject", "-s"}:
        args.show_subject = True
        subject_arg = extra_tokens[0] if extra_tokens else args.subject
        if not subject_arg:
            parser.error("Usage: ./bin/moulinette subject <exercise>")
        return handle_subject_inspection(
            str(subject_arg),
            show_subject=True,
            show_hint=False,
            theme=theme,
            prefer_exam=args.exam,
        )

    # 2. init <ex>
    if t_low in {"init", "--init"}:
        args.init = True
        subject_arg = extra_tokens[0] if extra_tokens else args.subject
        if not subject_arg:
            parser.error("Usage: ./bin/moulinette init <exercise>")
        return scaffold_exercise_workspace(
            subject_arg, args.dir, theme, prefer_exam=args.exam
        )

    # 3. watch <ex>
    if t_low in {"watch", "--watch"}:
        if args.json:
            parser.error(
                "--json grades a single exercise once: it cannot be combined with watch."
            )
        args.watch = True
        subject_arg = extra_tokens[0] if extra_tokens else args.subject
        if not subject_arg:
            parser.error("Usage: ./bin/moulinette watch <exercise>")
        return evaluate_exercise_or_module(
            str(subject_arg),
            None,
            explicit_dir=args.dir,
            exam_flag=args.exam,
            norm_flag=args.norm,
            strict_flag=args.strict,
            watch_flag=True,
            is_practice=is_practice,
            trace_out=args.trace_out,
            xp_ledger=args.xp_ledger,
            theme=theme,
            trace_mode=resolve_trace_mode(args),
        )

    # 4. list [target]
    if t_low in {"list", "--list"}:
        filter_arg = extra_tokens[0] if extra_tokens else (args.subject or None)
        return print_catalog_list(filter_arg, theme)

    # 5. xp / stats / history
    if t_low in {"xp", "stats", "history"}:
        print_student_progression(theme, args.xp_ledger)
        return 0

    # 6. Section catalogs: 'piscine', 'piscine exam', 'exams'
    if full_cmd_low in {
        "piscine",
        "piscines",
        "exam",
        "exams",
        "piscine exam",
        "piscine_exam",
    }:
        return print_catalog_list(full_cmd_low, theme)

    # 7. Exam track direct lookup: e.g. 'c_piscine_exam_00', 'rank02'
    exam_trk = resolve_exam_track_name(full_cmd_low)
    if exam_trk:
        return print_catalog_list(exam_trk, theme)

    subject_arg = args.subject or (t_raw if t_raw else None)
    module_arg = args.module

    if args.init:
        if not subject_arg:
            parser.error(
                "Provide an exercise slug to initialize (e.g. `./moulinette --init c00/ft_putchar`)."
            )
        return scaffold_exercise_workspace(
            subject_arg, args.dir, theme, prefer_exam=args.exam
        )

    if args.show_subject:
        if not subject_arg:
            parser.error(
                "Provide an exercise slug (e.g. `./moulinette --show-subject ft_split`)."
            )
        return handle_subject_inspection(
            str(subject_arg),
            show_subject=args.show_subject,
            show_hint=False,
            theme=theme,
            prefer_exam=args.exam,
        )

    piscine_mods = get_piscine_modules()
    if subject_arg and not module_arg:
        s_clean = str(subject_arg).strip().lower()
        if s_clean in piscine_mods:
            module_arg = s_clean
            subject_arg = None
        else:
            exam_trk = resolve_exam_track_name(s_clean)
            if exam_trk:
                return print_catalog_list(exam_trk, theme)

    if not subject_arg and not module_arg:
        if sys.stdin.isatty():
            return interactive_moulinette_repl(args, theme, is_practice)
        parser.error(
            "Provide an exercise name (e.g. `moulinette ft_strlen`), `--subject`, or `--module`."
        )

    if args.json and module_arg:
        parser.error(
            "--json grades a single exercise: it cannot be combined with a module."
        )

    effective_dir = args.dir
    if args.self_test:
        if module_arg:
            return subprocess.call(
                [
                    sys.executable,
                    str(KIT_ROOT / "bin" / "deepthought"),
                    module_arg,
                    "--self-test",
                    "--trace-mode",
                    resolve_trace_mode(args),
                    *deepthought_theme_args(theme),
                ]
            )
        if subject_arg and not args.json:
            found_s = resolve_exercise_or_report(
                str(subject_arg), theme, prefer_exam=args.exam
            )
            if found_s is None:
                return 1
            if not (KIT_ROOT / "corrections" / found_s[0]).is_dir():
                print(
                    theme.c(
                        f"Error: no reference solution for {short_exercise_label(found_s[0])}.",
                        "err",
                        "bold",
                    )
                )
                return 1
            subject_arg = found_s[0]
            effective_dir = str((KIT_ROOT / "corrections" / found_s[0]).resolve())
    if args.json and subject_arg:
        try:
            res_s, def_ex = resolve_piscine_or_exam_subject(
                str(subject_arg), prefer_exam=args.exam
            )
            if not _is_exercise_dir(KIT_ROOT / "subjects" / res_s):
                raise ExerciseLookupError(f"Unknown exercise '{subject_arg}'.")
            if args.self_test:
                if not (KIT_ROOT / "corrections" / res_s).is_dir():
                    raise ExerciseLookupError(
                        f"No reference solution for {short_exercise_label(res_s)}."
                    )
                effective_dir = str((KIT_ROOT / "corrections" / res_s).resolve())
            elif _is_inside_corrections(effective_dir):
                print(
                    json.dumps(
                        {
                            "subject": str(subject_arg),
                            "error": "Refusing '--dir' inside corrections/ without '--self-test' (anti-spoiler policy).",
                        },
                        indent=2,
                    )
                )
                return 2
            is_ex = True if args.exam else def_ex
            leaf_s = _MODULE_PREFIX_RE.sub("", Path(res_s).name)
            sub_d = resolve_submission_dir(
                effective_dir, leaf_s, resolved_subject=res_s
            )
            rep = grade_subject(
                KIT_ROOT,
                res_s,
                sub_d,
                is_exam=is_ex,
                strict=args.strict or (not is_ex),
                enforce_norm=args.norm,
                reveal_tests=(resolve_trace_mode(args) == "helpful"),
            )
            if args.trace_out:
                Path(args.trace_out).expanduser().write_text(
                    rep.trace, encoding="utf-8"
                )
        except ExerciseLookupError as exc:
            print(
                json.dumps({"subject": str(subject_arg), "error": str(exc)}, indent=2)
            )
            return 2
        except FileNotFoundError as exc:
            what = (
                f"'{exc.filename}' not found on this machine (environment problem)"
                if exc.filename
                else str(exc)
            )
            print(
                json.dumps(
                    {"subject": str(subject_arg), "error": f"cannot grade: {what}"},
                    indent=2,
                )
            )
            return 2
        except OSError as exc:
            print(
                json.dumps(
                    {"subject": str(subject_arg), "error": f"cannot grade: {exc}"},
                    indent=2,
                )
            )
            return 2
        print(
            json.dumps(
                {
                    "subject": rep.subject_id,
                    "passed": rep.passed,
                    "grade": rep.grade,
                    "status": rep.status,
                    "reason": rep.reason,
                    "error_info": rep.error_info,
                },
                indent=2,
            )
        )
        return 0 if rep.passed else 1
    return evaluate_exercise_or_module(
        str(subject_arg) if subject_arg else None,
        module_arg,
        explicit_dir=effective_dir,
        exam_flag=args.exam,
        norm_flag=args.norm,
        strict_flag=args.strict,
        watch_flag=args.watch,
        is_practice=is_practice,
        trace_out=args.trace_out,
        xp_ledger=args.xp_ledger,
        theme=theme,
        trace_mode=resolve_trace_mode(args),
        allow_corrections=args.self_test,
    )


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (KeyboardInterrupt, EOFError):
        print("\n[moulinette] Operation cancelled by user.")
        raise SystemExit(130)
    except ExerciseLookupError as lookup_exc:
        print(f"Error: {lookup_exc}")
        raise SystemExit(2)
