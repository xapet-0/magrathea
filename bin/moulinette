        f"{theme.c('C Piscine & Shell (c00..c13, shell00..01, rush)', 'muted')}"
    )
    print(
        f"{theme.c('2  ', 'muted')}  "
        f"{theme.c('piscine exam'.ljust(14), 'accent', 'bold')}  "
        f"{theme.c('9 tracks (303 exs)'.ljust(22), 'secondary')}  "
        f"{theme.c('Piscine Exams (00..Final) & Common Core (02..06)', 'muted')}"
    )
    print("")
    print(theme.c("tip: type 'piscine' (1) or 'piscine exam' (2) to browse, or <exercise> to grade directly.", "muted"))


def print_catalog_list(target: str | None, theme: ThemeEngine) -> int:
    piscine_dir = KIT_ROOT / "pools" / "piscine"
    exam_dir = KIT_ROOT / "pools" / "exams"
    piscine_pools = sorted(piscine_dir.glob("*.yml"))
    target_clean = (target or "").strip().lower()

    # Case 1: Specific Exam Track (or Specific Level inside an Exam Track, e.g. "c_piscine_exam_00:0")
    selected_lvl_idx: int | None = None
    track_query = target_clean
    if ":" in target_clean:
        track_query, lvl_part = target_clean.split(":", 1)
        lvl_part = lvl_part.replace("level", "").replace("lvl", "").strip()
        if lvl_part.isdigit():
            selected_lvl_idx = int(lvl_part)

    exam_file = None
    if track_query and track_query not in {"piscine", "piscines", "exam", "exams", "piscine exam", "piscine_exam", "all", "__all__"}:
        resolved_trk = resolve_exam_track_name(track_query)
        candidates = [
            resolved_trk or track_query,
            track_query,
            track_query.replace("exam_", ""),
            track_query.replace("rank_", "rank0"),
            track_query.replace("exam", "c_piscine_exam_"),
        ]
        for c in candidates:
            if c and (exam_dir / f"{c}.yml").exists():
                exam_file = exam_dir / f"{c}.yml"
                break

    if exam_file:
        data = fast_load_yaml(exam_file)
        title = data.get("display_name") or data.get("name") or exam_file.stem
        dur_s = data.get("duration_seconds", 14400)
        dur_h = dur_s // 3600
        dur_m = (dur_s % 3600) // 60
        levels = data.get("levels", [])
        total_candidates = sum(len(lvl.get("candidates", [])) for lvl in levels)

        # Sub-case 1A: Inside a specific level of the exam track (e.g. level0)
        if selected_lvl_idx is not None:
            matched_lvl = next((lvl for lvl in levels if int(lvl.get("level", -1)) == selected_lvl_idx), None)
            if not matched_lvl and 0 <= selected_lvl_idx < len(levels):
                matched_lvl = levels[selected_lvl_idx]
            if matched_lvl:
                lvl_num = matched_lvl.get("level", selected_lvl_idx)
                pts = matched_lvl.get("points", 100 // max(1, len(levels)))
                cands = matched_lvl.get("candidates", [])
                subj_base = tilde_path(KIT_ROOT / "subjects" / "exams")
                ws_base = tilde_path(KIT_ROOT / "workspace" / "exams")
                print(f"{theme.c('===>', 'accent', 'bold')} {theme.c(f'{exam_file.stem} / level{lvl_num} ({len(cands)} candidates | {pts} pts each)', 'primary', 'bold')}")
                print(theme.c(f"     subject: {subj_base}/<ex>/subject.en.txt (or 'subject <ex>') | turn-in: {ws_base}/<ex>/", "muted"))
                print("")
                print(theme.c(f"{'#':<4}  {'ASSIGNMENT':<24}  {'FILES':<24}  {'ALLOWED':<18}  {'PTS':>3}", "bold"))
                print(theme.c(f"{'----':<4}  {'------------------------':<24}  {'------------------------':<24}  {'------------------':<18}  {'---':>3}", "muted"))
                for idx, ex_id in enumerate(cands, 1):
                    m_path = KIT_ROOT / "subjects" / "exams" / ex_id / "meta.yml"
                    meta = fast_load_yaml(m_path) if m_path.exists() else {}
                    exp = ", ".join(meta.get("expected_files") or [f"{ex_id}.c"])
                    if len(exp) > 24:
                        exp = exp[:23] + "…"
                    allow = ", ".join(meta.get("allowed_functions") or ["None"])
                    if len(allow) > 18:
                        allow = allow[:17] + "…"
                    disp = ex_id if len(ex_id) <= 24 else ex_id[:23] + "…"
                    print(f"{theme.c(f'{idx:<4}', 'muted')}  {theme.c(f'{disp:<24}', 'primary', 'bold')}  {theme.c(f'{exp:<24}', 'secondary')}  {theme.c(f'{allow:<18}', 'muted')}  {pts:>3}")
                return 0

        # Sub-case 1B: Compact Level Table (1 row per level, matching piscine module table style)
        subj_base = tilde_path(KIT_ROOT / "subjects" / "exams")
        ws_base = tilde_path(KIT_ROOT / "workspace" / "exams")
        print(f"{theme.c('===>', 'accent', 'bold')} {theme.c(f'exam track: {exam_file.stem} ({title})', 'primary', 'bold')}")
        print(theme.c(f"     duration: {dur_h:02d}h {dur_m:02d}m | levels: {len(levels)} ({total_candidates} exs) | subject: {subj_base}/<ex>/subject.en.txt | turn-in: {ws_base}/<ex>/", "muted"))
        print("")
        print(theme.c(f"{'LEVEL':<8}  {'PTS':>4}  {'COUNT':>5}  {'EXERCISES'}", "bold"))
        print(theme.c(f"{'--------':<8}  {'----':>4}  {'-----':>5}  {'---------------------------------------------------------'}", "muted"))
        for lvl in levels:
            lvl_num = lvl.get("level", 0)
            pts = lvl.get("points", 100 // max(1, len(levels)))
            cands = [str(c) for c in (lvl.get("candidates") or [])]
            preview = _format_preview_exercises(cands, max_width=56)
            lvl_tag = f"level{lvl_num}"
            print(f"{theme.c(f'{lvl_tag:<8}', 'accent', 'bold')}  {pts:>4}  {len(cands):>5}  {theme.c(preview, 'secondary')}")
        return 0

    # Case 2: Specific Piscine Module (with rush00..02 / bsq support)
    if target_clean in {"rush00", "rush01", "rush02", "bsq", "rush"}:
        target_clean = "rush_bsq"
    if target_clean and (piscine_dir / f"{target_clean}.yml").exists():
        pool_file = piscine_dir / f"{target_clean}.yml"
        data = fast_load_yaml(pool_file)
        title = data.get("display_name") or data.get("title") or target_clean
        exs = data.get("exercises") or []
        subj_mod = tilde_path(KIT_ROOT / "subjects" / "piscine" / target_clean)
        ws_mod = tilde_path(KIT_ROOT / "workspace" / "piscine" / target_clean)
        print(f"{theme.c('===>', 'accent', 'bold')} {theme.c(f'piscine module: {target_clean} ({title})', 'primary', 'bold')}")
        print(theme.c(f"     exercises: {len(exs)} | subject: {subj_mod}/<ex>/subject.en.txt | turn-in: {ws_mod}/<ex>/", "muted"))
        print("")
        print(theme.c(f"{'EX':<4}  {'ASSIGNMENT':<22}  {'FILES':<24}  {'ALLOWED':<14}  {'XP':>3}", "bold"))
        print(theme.c(f"{'----':<4}  {'----------------------':<22}  {'------------------------':<24}  {'--------------':<14}  {'---':>3}", "muted"))
        for idx, ex in enumerate(exs):
            raw_id = (ex.get("subject_id") or ex.get("id") or "") if isinstance(ex, dict) else str(ex)
            ex_id = Path(raw_id).name
            ex_label = ex.get("ex", f"ex{idx:02d}") if isinstance(ex, dict) else f"ex{idx:02d}"
            m_path = KIT_ROOT / "subjects" / "piscine" / target_clean / ex_id / "meta.yml"
            meta = fast_load_yaml(m_path) if m_path.exists() else {}
            clean_leaf = _MODULE_PREFIX_RE.sub("", ex_id)
            exp = ", ".join(meta.get("expected_files") or [f"{clean_leaf}.c"])
            if len(exp) > 24:
                exp = exp[:23] + "…"
            allow = ", ".join(meta.get("allowed_functions") or ["None"])
            if len(allow) > 14:
                allow = allow[:13] + "…"
            xp = (ex.get("xp") if isinstance(ex, dict) else None) or meta.get("xp", 100)
            leaf_disp = clean_leaf if len(clean_leaf) <= 22 else clean_leaf[:21] + "…"
            print(f"{theme.c(f'{ex_label:<4}', 'muted')}  {theme.c(f'{leaf_disp:<22}', 'primary', 'bold')}  {theme.c(f'{exp:<24}', 'secondary')}  {theme.c(f'{allow:<14}', 'muted')}  {xp:>3}")
        return 0

    OFFICIAL_EXAM_TRACKS = [
        "c_piscine_exam_00", "c_piscine_exam_01", "c_piscine_exam_02", "c_piscine_final_exam",
        "rank02", "rank03", "rank04", "rank05", "rank06",
    ]
    visible_exam_pools = [exam_dir / f"{trk}.yml" for trk in OFFICIAL_EXAM_TRACKS if (exam_dir / f"{trk}.yml").exists()]

    # Case 3: Target is "piscine" or "piscines"
    if target_clean in {"piscine", "piscines"}:
        print(f"{theme.c('===>', 'accent', 'bold')} {theme.c(f'42 / 1337 c piscine catalog ({len(piscine_pools)} modules | 136 exercises)', 'primary', 'bold')}")
        print(theme.c(f"     subject: {tilde_path(KIT_ROOT / 'subjects/piscine')}/<mod>/<ex>/subject.en.txt | turn-in: {tilde_path(KIT_ROOT / 'workspace/piscine')}/<mod>/<ex>/", "muted"))
        print("")
        print(theme.c(f"{'MODULE':<10}  {'COUNT':>5}  {'EXERCISES'}", "bold"))
        print(theme.c(f"{'----------':<10}  {'-----':>5}  {'---------------------------------------------------------'}", "muted"))
        for p in piscine_pools:
            data = fast_load_yaml(p)
            exs = [Path((e.get("subject_id") or e.get("id") or "") if isinstance(e, dict) else str(e)).name for e in (data.get("exercises") or [])]
            preview = _format_preview_exercises(exs, max_width=56)
            print(f"{theme.c(f'{p.stem:<10}', 'accent', 'bold')}  {len(exs):>5}  {theme.c(preview, 'secondary')}")
        return 0

    # Case 4: Target is "exams", "exam", or "piscine exam"
    if target_clean in {"exam", "exams", "piscine exam", "piscine_exam"}:
        print(f"{theme.c('===>', 'accent', 'bold')} {theme.c(f'piscine exam ({len(visible_exam_pools)} tracks | 303 unique exercises)', 'primary', 'bold')}")
        print(theme.c(f"     subject: {tilde_path(KIT_ROOT / 'subjects/exams')}/<ex>/subject.en.txt | turn-in: {tilde_path(KIT_ROOT / 'workspace/exams')}/<ex>/", "muted"))
        print("")
        print(theme.c(f"{'TRACK':<24}  {'DUR':<4}  {'LVL':>3}  {'POOL':>4}  {'NAME'}", "bold"))
        print(theme.c(f"{'------------------------':<24}  {'----':<4}  {'---':>3}  {'----':>4}  {'----------------------------------'}", "muted"))
        for p in visible_exam_pools:
            data = fast_load_yaml(p)
            levels = data.get("levels", [])
            dur_h = data.get("duration_seconds", 14400) // 3600
            cands = sum(len(lvl.get("candidates", [])) for lvl in levels)
            title = data.get("display_name") or p.stem
            if len(title) > 34:
                title = title[:33] + "…"
            print(f"{theme.c(f'{p.stem:<24}', 'accent', 'bold')}  {dur_h:02d}h   {len(levels):>3}  {cands:>4}  {theme.c(title, 'secondary')}")
        return 0

    # Case 5: Unknown specific target filter
    if target_clean and target_clean not in {"list", "__all__", "all"}:
        print(theme.c(f"moulinette: unknown catalog target '{target}'", "err", "bold"))
        return 1

    # Case 6: Default complete catalog
    print_sections_menu(theme)
    return 0


def scaffold_exercise_workspace(target: str, dest_override: str | None, theme: ThemeEngine, prefer_exam: bool = False) -> int:
    pool_file = KIT_ROOT / "pools" / "piscine" / f"{target.strip().lower()}.yml"
    if pool_file.exists():
        mod = target.strip().lower()
        data = fast_load_yaml(pool_file)
        base_out = Path(dest_override).expanduser().resolve() if dest_override else (KIT_ROOT / "workspace" / "piscine" / mod)
        base_out.mkdir(parents=True, exist_ok=True)
        for idx, ex in enumerate(data.get("exercises") or []):
            raw_id = (ex.get("subject_id") or ex.get("id") or "") if isinstance(ex, dict) else str(ex)
            ex_id = Path(raw_id).name
            ex_code = ex.get("ex", f"ex{idx:02d}") if isinstance(ex, dict) else f"ex{idx:02d}"
            ex_out = base_out / ex_id
            scaffold_exercise_workspace(f"{mod}/{ex_id}", str(ex_out), theme, prefer_exam=prefer_exam)
            ex_code_link = base_out / ex_code
            if not ex_code_link.exists():
                try:
                    ex_code_link.symlink_to(ex_id)
                except OSError:
                    pass
        print(theme.c(f"\n[OK] Entire module '{mod}' scaffolded in {base_out}", "ok", "bold"))
        print(theme.c(f"Grade entire module with: ./moulinette {mod} --dir {base_out}", "primary", "bold"))
        return 0

    resolved, _ = resolve_piscine_or_exam_subject(target, prefer_exam=prefer_exam)
    subj_dir = KIT_ROOT / "subjects" / resolved
    if not subj_dir.exists() and (KIT_ROOT / "subjects" / "piscine" / resolved).exists():
        resolved = f"piscine/{resolved}"
        subj_dir = KIT_ROOT / "subjects" / resolved
    if not subj_dir.exists():
        print(theme.c(f"Error: Unknown exercise '{target}'. Try `./moulinette --list`.", "err", "bold"))
        return 1

    meta = fast_load_yaml(subj_dir / "meta.yml")
    out_dir = Path(dest_override).expanduser().resolve() if dest_override else (KIT_ROOT / "workspace" / resolved)
    out_dir.mkdir(parents=True, exist_ok=True)

    if (subj_dir / "subject.en.txt").exists():
        shutil.copy2(subj_dir / "subject.en.txt", out_dir / "subject.en.txt")
    for hf in subj_dir.glob("*.h"):
        if not (out_dir / hf.name).exists():
            shutil.copy2(hf, out_dir / hf.name)
    for extra_f in ("resources.tar.gz", "a", "sw.diff"):
        if (subj_dir / extra_f).exists() and not (out_dir / extra_f).exists():
            shutil.copy2(subj_dir / extra_f, out_dir / extra_f)

    clean_leaf = _MODULE_PREFIX_RE.sub("", subj_dir.name)
    exp_files = meta.get("expected_files") or [f"{clean_leaf}.c"]
    proto = str(meta.get("prototype") or "")
    allowed = meta.get("allowed_functions") or []
    stype = meta.get("type", "")

    for fname in exp_files:
        if "*" in fname:
            continue
        fpath = out_dir / fname
        if fpath.exists():
            continue
        fpath.parent.mkdir(parents=True, exist_ok=True)
        if fname.endswith(".sh"):
            fpath.write_text("#!/bin/sh\n\n", encoding="utf-8")
            os.chmod(fpath, 0o755)
        elif fname.endswith(".h"):
            guard = re.sub(r"[^A-Za-z0-9]", "_", fname).upper()
            fpath.write_text(build_42_header(fname) + f"#ifndef {guard}\n# define {guard}\n\n#endif\n", encoding="utf-8")
        elif fname.endswith(".c"):
            hdr = build_42_header(fname)
            incs: list[str] = []
            if any(f in allowed for f in ("write", "read", "close")):
                incs.append("#include <unistd.h>")
            if any(f in allowed for f in ("malloc", "free", "exit")):
                incs.append("#include <stdlib.h>")
            inc_s = ("\n".join(incs) + "\n\n") if incs else ""
            if stype == "c_function" and proto and "main(" not in proto:
                body = f"{proto.rstrip(';')}\n{{\n\t/* TODO: implement {clean_leaf} */\n}}\n"
            else:
                body = "int\tmain(int argc, char **argv)\n{\n\t(void)argc;\n\t(void)argv;\n\treturn (0);\n}\n"
            fpath.write_text(hdr + inc_s + body, encoding="utf-8")

    t_out = tilde_path(out_dir)
    t_subj = tilde_path(subj_dir / "subject.en.txt")
    primary_f = exp_files[0] if exp_files else f"{clean_leaf}.c"
    print(theme.c("=" * 80, "border"))
    print(theme.c(f"  SCAFFOLDED WORKSPACE READY: {resolved}", "ok", "bold"))
    print(theme.c("-" * 80, "border"))
    print(f"  Turn-In Folder  : {theme.c(t_out + '/', 'accent', 'bold')}  {theme.c(f'(~ = {Path.home()})', 'muted')}")
    print(f"  Subject File    : {theme.c(t_subj, 'secondary')}")
    print(f"  Expected Files  : {', '.join(exp_files)}")
    print(f"  Allowed Funcs   : {', '.join(allowed) if allowed else 'None'}")
    print(f"  1) Edit Code    : {theme.c(f'vim {t_out}/{primary_f}', 'accent')}")
    print(f"  2) Grade Now    : type {theme.c(clean_leaf, 'primary', 'bold')} here in moulinette (no git push needed)")
    print(theme.c("=" * 80, "border"))
    return 0


def snapshot_workspace_state(directory: Path) -> dict[str, tuple[int, int]]:
    state: dict[str, tuple[int, int]] = {}
    if not directory.exists():
        return state
    try:
        paths = list(directory.rglob("*"))
    except OSError:
        return state

    for p in paths:
        try:
            rel_parts = p.relative_to(directory).parts
        except ValueError:
            continue
        if any(part.startswith(".") or part == "__pycache__" for part in rel_parts):
            continue
        if p.name.endswith(_IGNORED_WATCH_SUFFIXES) or p.name == "4913":
            continue
        try:
            st = p.stat()
        except OSError:
            continue
        if p.is_file():
            state[str(Path(*rel_parts))] = (st.st_mtime_ns, st.st_size)
    return state


def handle_subject_inspection(
    subject_arg: str,
    *,
    show_subject: bool = True,
    show_hint: bool = False,
    theme: ThemeEngine,
    prefer_exam: bool = False,
) -> int:
    if show_hint:
        print(theme.status("error", "Reference solutions and hints are strictly locked. Use 'subject <ex>' and debug from the Deepthought trace."))
        return 2
    resolved_subj, _ = resolve_piscine_or_exam_subject(str(subject_arg), prefer_exam=prefer_exam)
    rel_subj = resolved_subj if resolved_subj.startswith(("piscine/", "exams/")) else f"piscine/{resolved_subj}"
    if not (KIT_ROOT / "subjects" / rel_subj).exists():
        if (KIT_ROOT / "subjects" / resolved_subj).exists():
            rel_subj = resolved_subj
        else:
            print(theme.c(f"Error: Unknown exercise '{subject_arg}'. Try `./moulinette --list`.", "err", "bold"))
            return 1

    s_file = KIT_ROOT / "subjects" / rel_subj / "subject.en.txt"
    clean_leaf = _MODULE_PREFIX_RE.sub("", Path(rel_subj).name)
    turnin_dir = resolve_submission_dir(None, clean_leaf, resolved_subject=rel_subj)
    if turnin_dir == KIT_ROOT.resolve() or turnin_dir == Path.cwd().resolve():
        turnin_dir = (KIT_ROOT / "workspace" / rel_subj).resolve()

    if show_subject:
        if not s_file.is_file():
            print(theme.c(f"Error: Subject file missing at {s_file}", "err", "bold"))
            return 1
        meta_s = fast_load_yaml(KIT_ROOT / "subjects" / rel_subj / "meta.yml")
        disk_s = parse_subject_disk_metadata(s_file)
        exp_s = meta_s.get("expected_files") or [disk_s["expected_files"]]
        primary_f = str(exp_s[0]) if exp_s else f"{clean_leaf}.c"
        t_subj = tilde_path(s_file)
        t_turnin = tilde_path(turnin_dir)
        print(theme.render_subject(s_file.read_text(encoding="utf-8", errors="replace"), subject_id=clean_leaf))
        print(theme.c(f"     subject : {t_subj}", "muted"))
        print(theme.c(f"     turn-in : {t_turnin}/{primary_f}  (~ = {Path.home()})", "accent"))
        print(theme.c(f"     submit  : 1) 'init {clean_leaf}'  2) 'vim {t_turnin}/{primary_f}'  3) type '{clean_leaf}' to grade", "muted"))
    return 0


def resolve_module_slug(module_id: str) -> str:
    slug = module_id.lower().strip()
    alias_file = KIT_ROOT / "pools/official_42_slugs.yml"
    if alias_file.exists():
        aliases = fast_load_yaml(alias_file)
        slug = (aliases.get("piscine") or {}).get(slug, slug)
    return slug


def evaluate_exercise_or_module(
    subject_arg: str | None,
    module_arg: str | None,
    *,
    explicit_dir: str | None,
    exam_flag: bool,
    norm_flag: bool,
    strict_flag: bool,
    watch_flag: bool,
    is_practice: bool,
    trace_out: str | None,
    xp_ledger: str | None,
    theme: ThemeEngine,
) -> int:
    if module_arg:
        if explicit_dir:
            target_dir = Path(explicit_dir).expanduser().resolve()
        else:
            mod_slug = resolve_module_slug(module_arg)
            cwd = Path(".").resolve()
            ws_mod = (KIT_ROOT / "workspace" / "piscine" / mod_slug).resolve()
            if cwd != KIT_ROOT.resolve() and (cwd / "ex00").exists():
                target_dir = cwd
            elif (cwd / mod_slug).is_dir() and (cwd / mod_slug).resolve() != (KIT_ROOT / "corrections" / "piscine" / mod_slug).resolve():
                target_dir = (cwd / mod_slug).resolve()
            else:
                target_dir = ws_mod
            target_dir.mkdir(parents=True, exist_ok=True)
        cmd = [sys.executable, str(KIT_ROOT / "bin" / "deepthought"), module_arg, "--dir", str(target_dir), "--theme", theme.name]
        if strict_flag:
            cmd.append("--strict")
        return subprocess.call(cmd)

    if not subject_arg:
        return 1
    if str(subject_arg).strip().lower() in {"clear", "cls"}:
        clear_viewport()
        return 0

    resolved_subject, default_is_exam = resolve_piscine_or_exam_subject(str(subject_arg), prefer_exam=exam_flag)
    is_exam = True if exam_flag else default_is_exam
    slug_leaf = _MODULE_PREFIX_RE.sub("", Path(resolved_subject).name)
    submit_dir = resolve_submission_dir(explicit_dir, slug_leaf, resolved_subject=resolved_subject)

    def run_single_grade() -> GradeReport | None:
        try:
            res = grade_subject(
                KIT_ROOT,
                resolved_subject,
                submit_dir,
                is_exam=is_exam,
                strict=strict_flag or (not is_exam),
                enforce_norm=norm_flag,
            )
        except FileNotFoundError:
            print(theme.c(f"Error: Unknown exercise '{subject_arg}'. Try `./moulinette --list`.", "err", "bold"))
            return None

        rel_subj = resolved_subject if resolved_subject.startswith(("piscine/", "exams/")) else f"piscine/{resolved_subject}"
        meta_file = KIT_ROOT / "subjects" / rel_subj / "meta.yml"
        if not meta_file.exists():
            meta_file = KIT_ROOT / "subjects" / resolved_subject / "meta.yml"
        meta_data = fast_load_yaml(meta_file)
        configured_xp = int(meta_data.get("xp", 150))

        is_corr_eval = (KIT_ROOT / "corrections").resolve() in [submit_dir.resolve(), *submit_dir.resolve().parents]
        if xp_ledger:
            ledger_path = Path(xp_ledger)
        elif is_corr_eval:
            ledger_path = KIT_ROOT / "workspace" / ".selftest_xp_ledger.json"
        else:
            ledger_path = KIT_ROOT / "workspace" / "xp_ledger.json"
        tracker = XPTracker(ledger_path)
        xp_res = tracker.record_evaluation(
            resolved_subject,
            passed=res.passed,
            grade=res.grade,
            configured_xp=configured_xp,
        )

        print(colorize_trace(res.trace, theme))
        print("")
        print(render_five_gate_scorecard(res, theme, is_exam=is_exam, norm_enabled=norm_flag))
        summary_block = res.format_exam_trace_summary(include_coaching=is_practice)
        if not res.passed and summary_block:
            print(summary_block)
        status_colored = theme.c(f"{res.status} ({res.grade}/100)", "ok" if res.passed else "err", "bold")
        print(f"\nSummary: {res.subject_id} -> {status_colored}")
        print(
            f"XP Progression: +{xp_res.awarded_xp} XP "
            f"(Total: {xp_res.total_xp} XP | Level {xp_res.level:.2f}) "
            f"[{xp_res.status_code}]"
        )
        if "Nothing turned in" in res.status:
            expected_ws = (KIT_ROOT / "workspace" / rel_subj).resolve()
            t_ws = tilde_path(expected_ws)
            t_subj = tilde_path(KIT_ROOT / "subjects" / rel_subj / "subject.en.txt")
            print(theme.c(f"     subject : {t_subj} (type 'subject {slug_leaf}')", "muted"))
            print(theme.c(f"     turn-in : {t_ws}/{slug_leaf}.c  (~ = {Path.home()})", "accent"))
            print(theme.c(f"     submit  : 1) type 'init {slug_leaf}'  2) edit '{t_ws}/{slug_leaf}.c'  3) type '{slug_leaf}' to grade", "muted"))
        if xp_res.awarded_xp > 0 and not is_corr_eval:
            p_prof = load_student_profile()
            p_prof.award_xp(xp_res.awarded_xp)
            p_prof.save()
        if trace_out:
            Path(trace_out).write_text(res.trace, encoding="utf-8")
        return res

    if watch_flag:
        submit_dir.mkdir(parents=True, exist_ok=True)
        print(theme.c(f"[Watch Mode] Watching {submit_dir} for changes (Ctrl+C to stop)...", "primary", "bold"))
        last_state: dict[str, tuple[int, int]] | None = None
        try:
            while True:
                cur_state = snapshot_workspace_state(submit_dir)
                if cur_state != last_state:
                    if last_state is not None:
                        time.sleep(0.15)
                        cur_state = snapshot_workspace_state(submit_dir)
                    last_state = cur_state
                    print(theme.c("\n" + "=" * 80, "border"))
                    print(theme.c(f"[Watch Mode] File change detected at {time.strftime('%H:%M:%S')} — Running Moulinette...", "accent", "bold"))
                    if run_single_grade() is None:
                        return 1
                time.sleep(0.5)
        except KeyboardInterrupt:
            print("\nStopped watch mode.")
            return 0

    res = run_single_grade()
    if res is None:
        return 1
    return 0 if res.passed else 1


def setup_readline_completer(piscine_mods: set[str]) -> None:
    if readline is None or not sys.stdin.isatty():
        return
    exam_tracks = {p.stem for p in (KIT_ROOT / "pools" / "exams").glob("*.yml")} if (KIT_ROOT / "pools" / "exams").is_dir() else set()
    commands = {
        "piscine", "piscine_exam", "back", "forward", "list", "subject",
        "clear", "cls", "help", "quit", "exit",
        "--back", "--forward", "--list", "--init", "--show-subject", "--watch", "--strict", "--exam",
    }
    exercises: set[str] = set()
    subj_root = KIT_ROOT / "subjects"
    if (subj_root / "exams").is_dir():
        for ex_dir in (subj_root / "exams").iterdir():
            if ex_dir.is_dir():
                exercises.add(ex_dir.name)
    if (subj_root / "piscine").is_dir():
        for ex_dir in (subj_root / "piscine").glob("*/*"):
            if ex_dir.is_dir():
                exercises.add(ex_dir.name)
                exercises.add(_MODULE_PREFIX_RE.sub("", ex_dir.name))

    vocab = sorted(commands | piscine_mods | exam_tracks | exercises)

    def _completer(text: str, state: int) -> str | None:
        matches = [w for w in vocab if w.startswith(text)]
        return matches[state] if state < len(matches) else None

    readline.set_completer_delims(" \t\n;")
    readline.set_completer(_completer)
    if "libedit" in (getattr(readline, "__doc__", "") or ""):
        readline.parse_and_bind("bind ^I rl_complete")
    else:
        readline.parse_and_bind("tab: complete")


def resolve_exercise_in_nav_context(target: str, nav_stack: list[str]) -> str:
    """Resolve an exercise name or 'exNN' code relative to the active navigation stack."""
    clean = target.strip().strip("/")
    if len(nav_stack) >= 2 and nav_stack[0] == "piscine":
        mod = nav_stack[1]
        pool_file = KIT_ROOT / "pools" / "piscine" / f"{mod}.yml"
        if pool_file.is_file():
            data = fast_load_yaml(pool_file)
            for idx, ex in enumerate(data.get("exercises") or []):
                raw_id = (ex.get("subject_id") or ex.get("id") or "") if isinstance(ex, dict) else str(ex)
                ex_id = Path(raw_id).name
                ex_code = (ex.get("ex", f"ex{idx:02d}") if isinstance(ex, dict) else f"ex{idx:02d}").lower()
                clean_leaf = _MODULE_PREFIX_RE.sub("", ex_id)
                if clean.lower() in {ex_code, ex_id.lower(), clean_leaf.lower()}:
                    return f"piscine/{mod}/{ex_id}"
    if nav_stack and nav_stack[0] == "piscine exam":
        if (KIT_ROOT / "subjects" / "exams" / clean).is_dir():
            return f"exams/{clean}"
    return clean


def interactive_moulinette_repl(args: argparse.Namespace, theme: ThemeEngine, is_practice: bool) -> int:
    piscine_mods = get_piscine_modules()
    setup_readline_completer(piscine_mods)

    nav_stack: list[str] = []
    back_stack: list[list[str]] = []
    forward_stack: list[list[str]] = []

    def _render_banner_header() -> None:
        cols, _ = theme.term_size()
        w = max(40, min(80, cols))
        banner = theme.tool_banner("moulinette", w, tagline="Don't Panic. Deepthought is judging your code.")
        stats = theme.stats_block(
            [
                "moulinette v0.1.1 - 42 / 1337 Deepthought Grading Engine",
                "17 piscine modules (136 exs) - 9 exam tracks (303 exs)",
                "5-gate pipeline: norminette, symbols, gcc -Werror, canary, diff",
            ],
            width=w,
        )
        if banner:
            for b in banner:
                print(b)
            print("")
        for s in stats:
            print(s)
        print("")
        print(theme.status("status", "Enter an exercise (e.g. ft_strlen), section (piscine | piscine exam), 'list', or 'q' to quit."))
        print(theme.status("status", "More / Pro Flags: back (b), forward (f), --list, --show-subject <ex>, --init <ex>, --watch <ex>"))
        print("")

    def _render_current_context() -> None:
        clear_viewport()
        _render_banner_header()

        if not nav_stack:
            print_sections_menu(theme)
            print("")
            return

        if nav_stack == ["piscine"]:
            print_catalog_list("piscine", theme)
            print("")
            print(theme.c("nav: type <module> (e.g. c00) to view exercises, 'grade <module>' to evaluate, or 'back' / 'forward'.", "muted"))
            print("")
            return

        if len(nav_stack) == 2 and nav_stack[0] == "piscine":
            mod_name = nav_stack[1]
            print_catalog_list(mod_name, theme)
            print("")
            print(theme.c(f"nav: type <exercise> (or ex00) to grade, 'subject <ex>' to read, 'grade' to evaluate {mod_name}, or 'back' / 'forward'.", "muted"))
            print("")
            return

        if nav_stack == ["piscine exam"]:
            print_catalog_list("piscine exam", theme)
            print("")
            print(theme.c("nav: type <track> (e.g. c_piscine_exam_00, rank02) to open, or 'back' / 'forward'.", "muted"))
            print("")
            return

        if len(nav_stack) == 2 and nav_stack[0] == "piscine exam":
            trk_name = nav_stack[1]
            print_catalog_list(trk_name, theme)
            print("")
            print(theme.c("nav: type 'level0' (or '0'..'9') to view level exercises, <exercise> to grade, or 'back' / 'forward'.", "muted"))
            print("")
            return

        if len(nav_stack) == 3 and nav_stack[0] == "piscine exam":
            trk_name, lvl_tag = nav_stack[1], nav_stack[2]
            lvl_num = lvl_tag.replace("level", "").strip()
            print_catalog_list(f"{trk_name}:{lvl_num}", theme)
            print("")
            print(theme.c("nav: type <exercise> to grade in exam mode, 'subject <ex>' to read, or 'back' / 'forward'.", "muted"))
            print("")
            return

    def _navigate_to(target_path: list[str]) -> None:
        if target_path != nav_stack:
            back_stack.append(list(nav_stack))
            forward_stack.clear()
            nav_stack[:] = list(target_path)
        _render_current_context()

    def _go_back() -> None:
        if back_stack:
            forward_stack.append(list(nav_stack))
            nav_stack[:] = back_stack.pop()
        elif nav_stack:
            forward_stack.append(list(nav_stack))
            nav_stack.pop()
        _render_current_context()

    def _go_forward() -> None:
        if forward_stack:
            back_stack.append(list(nav_stack))
            nav_stack[:] = forward_stack.pop()
            _render_current_context()
        else:
            print(theme.c("Already at the latest forward view.", "muted"))

    def _current_prompt() -> str:
        if not nav_stack:
            label = "moulinette (grade)> "
        else:
            label = f"moulinette ({'/'.join(nav_stack)})> "
        return rl_safe_prompt(theme.c(label, "primary", "bold"))

    def _on_sigwinch(signum: int, frame: Any) -> None:
        _render_current_context()
        if readline is not None:
            try:
                readline.forced_update_display()
            except Exception:
                pass

    prev_winch = None
    if hasattr(signal, "SIGWINCH") and sys.stdout.isatty():
        prev_winch = signal.getsignal(signal.SIGWINCH)
        signal.signal(signal.SIGWINCH, _on_sigwinch)

    try:
        with interactive_terminal_screen(enabled=True):
            _render_current_context()
            while True:
                try:
                    raw = input(_current_prompt()).strip()
                except EOFError:
                    print("\n" + theme.status("status", "Session closed."))
                    return 0
                except KeyboardInterrupt:
                    print("^C\n" + theme.status("status", "Interrupted. Type 'back', 'forward', or 'q' to exit."))
                    continue

                if not raw:
                    continue
                low_raw = raw.lower().strip()

                if low_raw in {"q", "quit", "exit"}:
                    return 0

                if low_raw in {"back", "--back", "-b", "b", "..", "prev", "up", "return", "cd .."}:
                    _go_back()
                    continue

                if low_raw in {"forward", "--forward", "-f", "f", "next", "redo"}:
                    _go_forward()
                    continue

                if low_raw in {"home", "root", "top"}:
                    _navigate_to([])
                    continue

                if low_raw in {"clear", "cls"} or raw == "\x0c":
                    _render_current_context()
                    continue

                if low_raw in {"help", "?", "--help", "-h", "more", "--more"}:
                    clear_viewport()
                    _render_banner_header()
                    ws_tilde = tilde_path(KIT_ROOT / "workspace")
                    print(theme.status("status", "Sections   : 'piscine' (1), 'piscine exam' (2), <module> (c00), <track> (rank02), 'level0'"))
                    print(theme.status("status", "Navigation : 'back' (b / ..), 'forward' (f / next), 'home', 'list'"))
                    print(theme.status("status", "Evaluation : <exercise> (ft_strlen), 'subject <ex>', 'init <ex>', 'watch <ex>', '--strict', q"))
                    print(theme.status("status", f"Path Guide : '~' means your home folder ({Path.home()}). Turn-in root: {ws_tilde}/"))
                    print(theme.status("status", f"How to Code: 1) 'init <ex>'  2) 'vim {ws_tilde}/.../<ex>.c'  3) type '<ex>' to grade"))
                    print("")
                    continue

                if low_raw in {"1", "piscine", "piscines", "cd piscine", "use piscine"}:
                    _navigate_to(["piscine"])
                    continue

                if low_raw in {"2", "piscine exam", "piscine exams", "piscine_exam", "exam", "exams", "cd exam", "cd exams", "use exam", "use exams"}:
                    _navigate_to(["piscine exam"])
                    continue

                # Level selection when inside an exam track (e.g. 'level0', 'level 0', 'lvl0', or '0')
                if len(nav_stack) >= 2 and nav_stack[0] == "piscine exam":
                    m_lvl = re.match(r"^(?:level\s*|lvl\s*)?(\d+)$", low_raw)
                    if m_lvl:
                        lvl_idx = int(m_lvl.group(1))
                        trk_file = KIT_ROOT / "pools" / "exams" / f"{nav_stack[1]}.yml"
                        trk_levels = (fast_load_yaml(trk_file).get("levels") or []) if trk_file.is_file() else []
                        valid_lvls = {int(l.get("level", i)) for i, l in enumerate(trk_levels)}
                        if lvl_idx in valid_lvls:
                            _navigate_to(["piscine exam", nav_stack[1], f"level{lvl_idx}"])
                            continue

                try:
                    tokens = shlex.split(raw)
                except ValueError as exc:
                    print(theme.c(f"Parse error: {exc}", "err", "bold"))
                    continue

                explicit_grade_cmd = tokens[0].lower() in {"grade", "eval"}
                if explicit_grade_cmd and len(tokens) == 1:
                    if len(nav_stack) == 2 and nav_stack[0] == "piscine":
                        clear_viewport()
                        _render_banner_header()
                        evaluate_exercise_or_module(
                            None,
                            nav_stack[1],
                            explicit_dir=args.dir,
                            exam_flag=False,
                            norm_flag=args.norm,
                            strict_flag=args.strict,
                            watch_flag=args.watch,
                            is_practice=is_practice,
                            trace_out=args.trace_out,
                            xp_ledger=args.xp_ledger,
                            theme=theme,
                        )
                        print("\n" + theme.c("tip: type 'list' to view exercises, or 'back' / 'forward' to navigate.", "muted") + "\n")
                        continue
                    print(theme.c("Usage: grade <exercise|module>", "warn", "bold"))
                    continue

                if explicit_grade_cmd and len(tokens) > 1:
                    tokens = tokens[1:]

                cmd0 = tokens[0].lower()
                arg1 = " ".join(tokens[1:]).strip() if len(tokens) > 1 else None
                in_exam_section = bool(nav_stack and nav_stack[0] == "piscine exam")

                if cmd0 in {"solution", "--solution", "solve", "--solve", "hint", "--hint"}:
                    print(theme.status("error", "Reference solutions and hints are strictly locked. Use 'subject <ex>' and debug from the Deepthought trace."))
                    print("")
                    continue

                if cmd0 in {"list", "--list", "ls", "catalog", "--catalog"}:
                    if not arg1:
                        _render_current_context()
                        continue
                    arg1_low = arg1.lower()
                    if arg1_low in {"piscine", "piscines", "1"}:
                        _navigate_to(["piscine"])
                        continue
                    if arg1_low in {"piscine exam", "piscine_exam", "exam", "exams", "2"}:
                        _navigate_to(["piscine exam"])
                        continue
                    if arg1_low in piscine_mods or arg1_low in {"rush00", "rush01", "rush02", "bsq", "rush"}:
                        mod_t = "rush_bsq" if arg1_low in {"rush00", "rush01", "rush02", "bsq", "rush"} else arg1_low
                        _navigate_to(["piscine", mod_t])
                        continue
                    trk_t = resolve_exam_track_name(arg1_low)
                    if trk_t:
                        _navigate_to(["piscine exam", trk_t])
                        continue
                    clear_viewport()
                    _render_banner_header()
                    print_catalog_list(arg1, theme)
                    print("")
                    continue

                if cmd0 in {"xp", "stats", "history"}:
                    clear_viewport()
                    _render_banner_header()
                    ledger_p = Path(args.xp_ledger) if args.xp_ledger else (KIT_ROOT / "workspace" / "xp_ledger.json")
                    prof = load_student_profile()
                    print(f"{theme.c('===>', 'accent', 'bold')} {theme.bold(f'Student Progression ({prof.login})')}")
                    print(f"     Total XP : {getattr(prof, 'total_xp', getattr(prof, 'xp', 0))} XP  |  Level : {prof.level:.2f}")
                    if ledger_p.is_file():
                        try:
                            ldata = json.loads(ledger_p.read_text(encoding="utf-8"))
                            passed_ex = sorted((ldata.get("validated_exercises") or ldata.get("validated_subjects") or {}).keys())
                            print(f"     Validated: {len(passed_ex)} exercise(s)" + (f" ({', '.join(passed_ex[-8:])})" if passed_ex else ""))
                        except Exception:
                            pass
                    print("\n" + theme.c("tip: type 'list', 'back', or 'forward' to navigate.", "muted") + "\n")
                    continue

                first_arg = tokens[1] if len(tokens) > 1 else None
                if cmd0 in {"init", "--init", "subject", "--show-subject", "-s", "watch", "--watch"} and not first_arg:
                    print(theme.c(f"Usage: {cmd0} <exercise>", "warn", "bold"))
                    print("")
                    continue

                if cmd0 in {"init", "--init"} and first_arg:
                    ctx_target = resolve_exercise_in_nav_context(first_arg, nav_stack)
                    clear_viewport()
                    _render_banner_header()
                    scaffold_exercise_workspace(ctx_target, args.dir, theme, prefer_exam=in_exam_section or args.exam)
                    print("\n" + theme.c("tip: type 'list', 'back', or 'forward' to navigate.", "muted") + "\n")
                    continue
                if cmd0 in {"subject", "--show-subject", "-s"} and first_arg:
                    ctx_target = resolve_exercise_in_nav_context(first_arg, nav_stack)
                    clear_viewport()
                    _render_banner_header()
                    handle_subject_inspection(ctx_target, show_subject=True, show_hint=False, theme=theme, prefer_exam=in_exam_section or args.exam)
                    print("\n" + theme.c("tip: type 'list', 'back', or 'forward' to navigate.", "muted") + "\n")
                    continue

                repl_watch = args.watch or (cmd0 in {"watch", "--watch"})
                repl_exam = args.exam or in_exam_section
                repl_norm = args.norm
                repl_strict = args.strict
                repl_self_test = False
                repl_dir = args.dir
                target_tok: str | None = first_arg if cmd0 in {"watch", "--watch"} else None

                idx_t = 2 if cmd0 in {"watch", "--watch"} else 0
                while idx_t < len(tokens):
                    tok = tokens[idx_t]
                    if tok in {"--watch", "-w"}:
                        repl_watch = True
                    elif tok == "--exam":
                        repl_exam = True
                    elif tok == "--norm":
                        repl_norm = True
                    elif tok == "--strict":
                        repl_strict = True
                    elif tok == "--self-test":
                        repl_self_test = True
                    elif tok in {"--dir", "--path"} and idx_t + 1 < len(tokens):
                        repl_dir = tokens[idx_t + 1]
                        idx_t += 1
                    elif not tok.startswith("-") and target_tok is None:
                        target_tok = tok
                    idx_t += 1

                if not target_tok:
                    continue

                exam_trk = resolve_exam_track_name(target_tok)
                if exam_trk and not explicit_grade_cmd:
                    _navigate_to(["piscine exam", exam_trk])
                    continue

                is_mod = target_tok.lower() in piscine_mods
                has_extra_flags = repl_watch or repl_self_test or (repl_dir is not None)
                if is_mod and not explicit_grade_cmd and not has_extra_flags and nav_stack != ["piscine", target_tok.lower()]:
                    _navigate_to(["piscine", target_tok.lower()])
                    continue

                resolved_tok = target_tok if is_mod else resolve_exercise_in_nav_context(target_tok, nav_stack)

                if repl_self_test and not repl_dir:
                    if is_mod:
                        clear_viewport()
                        _render_banner_header()
                        subprocess.call([sys.executable, str(KIT_ROOT / "bin" / "deepthought"), target_tok.lower(), "--self-test", "--theme", theme.name])
                        print("\n" + theme.c("tip: type 'list', 'back', or 'forward' to navigate.", "muted") + "\n")
                        continue
                    res_s, _ = resolve_piscine_or_exam_subject(resolved_tok, prefer_exam=repl_exam)
                    rel_s = res_s if res_s.startswith(("piscine/", "exams/")) else f"piscine/{res_s}"
                    if (KIT_ROOT / "corrections" / rel_s).is_dir():
                        repl_dir = str((KIT_ROOT / "corrections" / rel_s).resolve())
                    elif (KIT_ROOT / "corrections" / res_s).is_dir():
                        repl_dir = str((KIT_ROOT / "corrections" / res_s).resolve())

                clear_viewport()
                _render_banner_header()
                evaluate_exercise_or_module(
                    None if is_mod else resolved_tok,
                    target_tok.lower() if is_mod else None,
                    explicit_dir=repl_dir,
                    exam_flag=repl_exam,
                    norm_flag=repl_norm,
                    strict_flag=repl_strict,
                    watch_flag=repl_watch,
                    is_practice=is_practice,
                    trace_out=args.trace_out,
                    xp_ledger=args.xp_ledger,
                    theme=theme,
                )
                print("\n" + theme.c("tip: type 'list' to view current section, or 'back' / 'forward' to navigate.", "muted") + "\n")
    finally:
        if prev_winch is not None and hasattr(signal, "SIGWINCH"):
            signal.signal(signal.SIGWINCH, prev_winch)


def main() -> int:
    parser = argparse.ArgumentParser(description="1337 / 42 Moulinette & Deepthought Grader — Pro Edition")
    parser.add_argument("target", nargs="?", help="Exercise slug (e.g., ft_strlen, c01/c01_ft_strlen), module, or command (e.g. subject, init, watch, piscine, 'piscine exam')")
    parser.add_argument("extra", nargs="*", help="Optional subcommand arguments or tokens (e.g. subject ft_strlen, init ft_strlen)")
    parser.add_argument("--subject", help="Subject identifier")
    parser.add_argument("--module", help="Grade an entire Piscine module")
    parser.add_argument("--dir", "--path", dest="dir", default=None, help="Directory containing user submission")
    parser.add_argument("--exam", action="store_true", help="Grade in exam mode (Norminette disabled unless --norm)")
    parser.add_argument("--norm", action="store_true", help="Force 42 Norminette check even in exam mode")
    parser.add_argument("--strict", action="store_true", help="Strict Piscine mode (Norminette + forbidden symbols)")
    parser.add_argument("--init", action="store_true", help="Scaffold a starter folder with 42 header and subject.en.txt")
    parser.add_argument("--show-subject", "-S", action="store_true", help="Display formatted subject.en.txt for the exercise")
    parser.add_argument("--practice", action="store_true", help="Enable special practice mode")
    parser.add_argument("--mode", choices=["real", "practice"], default="real", help="Operating mode (default: real)")
    parser.add_argument("--watch", action="store_true", help="Live watch mode: re-grade automatically on file save")
    parser.add_argument("--list", nargs="?", const="__all__", default=None, help="List Piscine modules, Exam tracks, or exercises in a module/track")
    parser.add_argument("--trace-out", help="Optional path to save Deepthought trace")
    parser.add_argument("--xp-ledger", default=None, help="Optional path to XP ledger JSON file")
    parser.add_argument("--theme", default="42-cluster", choices=sorted(PALETTES), help="Color palette")
    parser.add_argument("--catalog", action="store_true", help="Display complete Piscine & Exam catalog")
    parser.add_argument("--self-test", action="store_true", help="Grade reference solution in corrections/ to verify environment")
    parser.add_argument("--json", action="store_true", help="Output grading report in JSON format")
    parser.add_argument("--no-color", action="store_true", help="Disable ANSI colors")
    if any(arg.split("=", 1)[0].strip().lower() in {"--solution", "--solve", "solution", "solve", "--hint", "hint"} for arg in sys.argv[1:]):
        print("Error: Reference solutions and hints are strictly locked in Moulinette to preserve the 42 / 1337 peer-learning methodology. Use 'subject <ex>' and debug from the Deepthought trace.")
        return 2
    args = parser.parse_args()

    use_plain = args.no_color or bool(os.environ.get("NO_COLOR")) or (not sys.stdout.isatty() and os.environ.get("FORCE_COLOR") != "1")
    theme = ThemeEngine("plain" if use_plain else args.theme)
    is_practice = bool(args.practice or args.mode == "practice")

    t_raw = (args.target or "").strip()
    extra_tokens = [tok.strip() for tok in getattr(args, "extra", []) if tok.strip()]
    full_cmd = f"{t_raw} {' '.join(extra_tokens)}".strip()
    full_cmd_low = full_cmd.lower()
    t_low = t_raw.lower()

    if getattr(args, "catalog", False):
        return print_catalog_list(full_cmd or None, theme)
    if args.list is not None:
        mod_filter = None if args.list == "__all__" else args.list
        return print_catalog_list(mod_filter or full_cmd or None, theme)

    # 0. Anti-spoiler solution & hint blocker:
    if t_low in {"solution", "--solution", "solve", "--solve", "hint", "--hint"} or any(
        tok.lower() in {"solution", "--solution", "solve", "--solve", "hint", "--hint"} for tok in extra_tokens
    ):
        print(theme.status("error", "Reference solutions and hints are strictly locked. Use 'subject <ex>' and debug from the Deepthought trace."))
        return 2

    # Subcommand routing for documented CLI patterns:
    # 1. subject <ex>
    if t_low in {"subject", "show-subject", "-s"}:
        args.show_subject = True
        subject_arg = extra_tokens[0] if extra_tokens else args.subject
        if not subject_arg:
            parser.error("Usage: ./bin/moulinette subject <exercise>")
        return handle_subject_inspection(
            str(subject_arg),
            show_subject=True,
            show_hint=False,
            theme=theme,
            prefer_exam=args.exam,
        )

    # 2. init <ex>
    if t_low in {"init", "--init"}:
        args.init = True
        subject_arg = extra_tokens[0] if extra_tokens else args.subject
        if not subject_arg:
            parser.error("Usage: ./bin/moulinette init <exercise>")
        return scaffold_exercise_workspace(subject_arg, args.dir, theme, prefer_exam=args.exam)

    # 3. watch <ex>
    if t_low in {"watch", "--watch"}:
        args.watch = True
        subject_arg = extra_tokens[0] if extra_tokens else args.subject
        if not subject_arg:
            parser.error("Usage: ./bin/moulinette watch <exercise>")
        return evaluate_exercise_or_module(
            str(subject_arg),
            None,
            explicit_dir=args.dir,
            exam_flag=args.exam,
            norm_flag=args.norm,
            strict_flag=args.strict,
            watch_flag=True,
            is_practice=is_practice,
            trace_out=args.trace_out,
            xp_ledger=args.xp_ledger,
            theme=theme,
        )

    # 4. list [target]
    if t_low in {"list", "--list"}:
        filter_arg = extra_tokens[0] if extra_tokens else (args.subject or None)
        return print_catalog_list(filter_arg, theme)

    # 5. xp / stats / history
    if t_low in {"xp", "stats", "history"}:
        ledger_p = Path(args.xp_ledger) if args.xp_ledger else (KIT_ROOT / "workspace" / "xp_ledger.json")
        prof = load_student_profile()
        print(f"{theme.c('===>', 'accent', 'bold')} {theme.bold(f'Student Progression ({prof.login})')}")
        print(f"     Total XP : {getattr(prof, 'total_xp', getattr(prof, 'xp', 0))} XP  |  Level : {prof.level:.2f}")
        if ledger_p.is_file():
            try:
                ldata = json.loads(ledger_p.read_text(encoding="utf-8"))
                passed_ex = sorted((ldata.get("validated_exercises") or ldata.get("validated_subjects") or {}).keys())
                print(f"     Validated: {len(passed_ex)} exercise(s)" + (f" ({', '.join(passed_ex[-8:])})" if passed_ex else ""))
            except Exception:
                pass
        return 0

    # 6. Section catalogs: 'piscine', 'piscine exam', 'exams'
    if full_cmd_low in {"piscine", "piscines", "exam", "exams", "piscine exam", "piscine_exam"}:
        return print_catalog_list(full_cmd_low, theme)

    # 7. Exam track direct lookup: e.g. 'c_piscine_exam_00', 'rank02'
    exam_trk = resolve_exam_track_name(full_cmd_low)
    if exam_trk:
        return print_catalog_list(exam_trk, theme)

    subject_arg = args.subject or (t_raw if t_raw else None)
    module_arg = args.module

    if args.init:
        if not subject_arg:
            parser.error("Provide an exercise slug to initialize (e.g. `./moulinette --init c00/ft_putchar`).")
        return scaffold_exercise_workspace(subject_arg, args.dir, theme, prefer_exam=args.exam)

    if args.show_subject:
        if not subject_arg:
            parser.error("Provide an exercise slug (e.g. `./moulinette --show-subject ft_split`).")
        return handle_subject_inspection(
            str(subject_arg),
            show_subject=args.show_subject,
            show_hint=False,
            theme=theme,
            prefer_exam=args.exam,
        )

    piscine_mods = get_piscine_modules()
    if subject_arg and not module_arg:
        s_clean = str(subject_arg).strip().lower()
        if s_clean in piscine_mods:
            module_arg = s_clean
            subject_arg = None
        else:
            exam_trk = resolve_exam_track_name(s_clean)
            if exam_trk:
                return print_catalog_list(exam_trk, theme)

    if not subject_arg and not module_arg:
        if sys.stdin.isatty():
            return interactive_moulinette_repl(args, theme, is_practice)
        parser.error("Provide an exercise name (e.g. `moulinette ft_strlen`), `--subject`, or `--module`.")

    effective_dir = args.dir
    if getattr(args, "self_test", False) and not effective_dir:
        if module_arg:
            return subprocess.call([sys.executable, str(KIT_ROOT / "bin" / "deepthought"), module_arg, "--self-test", "--theme", theme.name])
        if subject_arg:
            res_s, _ = resolve_piscine_or_exam_subject(str(subject_arg), prefer_exam=args.exam)
            rel_s = res_s if res_s.startswith(("piscine/", "exams/")) else f"piscine/{res_s}"
            if (KIT_ROOT / "corrections" / rel_s).is_dir():
                effective_dir = str((KIT_ROOT / "corrections" / rel_s).resolve())
            elif (KIT_ROOT / "corrections" / res_s).is_dir():
                effective_dir = str((KIT_ROOT / "corrections" / res_s).resolve())
    if getattr(args, "json", False) and subject_arg and not module_arg:
        res_s, def_ex = resolve_piscine_or_exam_subject(str(subject_arg), prefer_exam=args.exam)
        is_ex = True if args.exam else def_ex
        leaf_s = _MODULE_PREFIX_RE.sub("", Path(res_s).name)
        sub_d = resolve_submission_dir(effective_dir, leaf_s, resolved_subject=res_s)
        rep = grade_subject(KIT_ROOT, res_s, sub_d, is_exam=is_ex, strict=args.strict or (not is_ex), enforce_norm=args.norm)
        print(json.dumps({"subject": rep.subject_id, "passed": rep.passed, "grade": rep.grade, "status": rep.status, "reason": rep.reason, "error_info": rep.error_info}, indent=2))
        return 0 if rep.passed else 1
    return evaluate_exercise_or_module(
        str(subject_arg) if subject_arg else None,
        module_arg,
        explicit_dir=effective_dir,
        exam_flag=args.exam,
        norm_flag=args.norm,
        strict_flag=args.strict,
        watch_flag=args.watch,
        is_practice=is_practice,
        trace_out=args.trace_out,
        xp_ledger=args.xp_ledger,
        theme=theme,
    )


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (KeyboardInterrupt, EOFError):
        print("\n[moulinette] Operation cancelled by user.")
        raise SystemExit(130)

