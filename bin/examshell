    def do_run(self, arg: str) -> None:
        if not self.practice:
            t = self.theme
            print(t.c("  [examshell] 'run' is only available in practice mode (--mode practice).", "warn"))
            return
        """Compile your code in `rendu/<assignment>` and run it with custom arguments (`run "arg1" "arg2"`)."""
        import tempfile
        from deepthought.grader import has_main_definition

        t = self.theme
        local_dir = self.rendu_dir / self.current_assignment
        c_files = sorted(local_dir.glob("*.c")) if local_dir.is_dir() else []
        if not c_files:
            print(t.c(f"No .c files found in {local_dir}. Run `init` or `edit` first!", "err", "bold"))
            return
        if not any(has_main_definition(cf) for cf in c_files):
            print(t.c(f"[run] '{self.current_assignment}' is a C function exercise (no main() in file) -> running 5-Gate test harness:", "accent"))
            self.do_check(arg)
            return
        try:
            user_args = shlex.split(arg)
        except ValueError:
            user_args = arg.split()
        with tempfile.TemporaryDirectory(prefix="exam_run_") as td:
            work = Path(td)
            for p in local_dir.iterdir():
                if p.is_file():
                    shutil.copy2(p, work / p.name)
            subj_dir = KIT_ROOT / "subjects" / "exams" / self.current_assignment
            for hf in subj_dir.glob("*.h"):
                if not (work / hf.name).exists():
                    shutil.copy2(hf, work / hf.name)
            exe = work / "user_run"
            cmd_comp = ["cc", "-Wall", "-Wextra", "-Werror", *[p.name for p in c_files], "-o", str(exe)]
            print(t.c(f"$> {' '.join(['cc', '-Wall', '-Wextra', '-Werror', *[p.name for p in c_files], '-o', self.current_assignment])}", "accent"))
            cproc = subprocess.run(cmd_comp, cwd=work, capture_output=True, text=True)
            if cproc.returncode != 0:
                print(t.c("Compilation failed:", "err", "bold"))
                print(t.c(cproc.stderr.rstrip(), "err"))
                return
            quoted = " ".join(shlex.quote(a) for a in user_args)
            print(t.c(f"$> ./{self.current_assignment} {quoted} | cat -e".rstrip(), "accent"))
            try:
                rproc = subprocess.run([str(exe), *user_args], cwd=work, capture_output=True, text=True, timeout=2.0)
            except subprocess.TimeoutExpired:
                print(t.c("Timeout (> 2.0s) — check for infinite loops!", "err", "bold"))
                return
            cat_e_out = rproc.stdout.replace("\n", "$\n")
            if cat_e_out.endswith("\n"):
                cat_e_out = cat_e_out[:-1]
            if cat_e_out:
                print(t.c(cat_e_out, "ok"))
            else:
                print(t.c("(empty stdout)", "muted"))
            if rproc.stderr:
                print(t.c(f"[stderr]: {rproc.stderr.rstrip()}", "warn"))
            print(t.c(f"[exit code: {rproc.returncode}]", "muted"))


    def do_grademe(self, arg: str) -> None:
        """Clone strictly from the bare Vogsphere repository and run Deepthought grading (`grademe [--now]`)."""
        t = self.theme
        self._refresh_lifecycle_state()
        if self.lifecycle_state == "expired" or self._is_expired():
            self.lifecycle_state = "expired"
            self.last_exit_code = 1
            self._save_session()
            print(t.c("Error: Exam time has expired. Grading submissions are no longer accepted.", "err", "bold"))
            return
        if self.lifecycle_state in {"passed", "abandoned", "failed"}:
            self.last_exit_code = 1
            print(t.c(f"Error: Exam session is already '{self.lifecycle_state}'. Cannot grade further.", "err", "bold"))
            return

        flags = arg.strip().lower().split()
        if any(f in {"--now", "now", "--skip", "skip", "--no-wait"} for f in flags):
            if not self.practice:
                self.last_exit_code = 2
                print(
                    t.c(
                        "Error: Cooldown bypass flags (--now / --skip) are restricted in normal exam mode.",
                        "err",
                        "bold",
                    )
                )
                return
            self._reset_cooldown()

        rem_wait = self._cooldown_remaining()
        if rem_wait > 0:
            total_pen = max(rem_wait, self.last_penalty_sec or (max(1, self.attempts) * self.cooldown_step))
            s1 = self._format_cooldown_short(self.cooldown_step)
            s2 = self._format_cooldown_short(self.cooldown_step * 2)
            s3 = self._format_cooldown_short(self.cooldown_step * 3)
            s4 = self._format_cooldown_short(self.cooldown_step * 4)
            def _build_cd_panel(cur_left: int) -> list[str]:
                cd_rows = [
                    f"{t.secondary('Assignment      ')} : {t.primary(self.current_assignment)} (Failed attempts on this exercise: {t.warn(str(self.attempts))})",
                    f"{t.secondary('Current Penalty ')} : {t.warn(self._format_cooldown_human(total_pen))} ({self.cooldown_step}s × {max(1, self.attempts)})",
                    f"{t.secondary('Remaining Wait  ')} : {t.bold(self._format_cooldown_human(cur_left))}",
                    f"{t.secondary('Penalty Scale   ')} : Fail #1 = {s1} -> Fail #2 = {s2} -> Fail #3 = {s3} -> Fail #4 = {s4} (+{self.cooldown_step}s each fail)",
                    f"{t.secondary('Auto-Reset      ')} : Passing the exercise automatically resets the cooldown timer to {t.ok('0s')}!",
                ]
                return t.box_panel("⏳ GRADING COOLDOWN ACTIVE", cd_rows, border_color="warn").splitlines()

            if self._viewport_active and is_interactive_tty():
                fd = sys.stdin.fileno()
                old_attrs = termios.tcgetattr(fd)
                new_attrs = list(old_attrs)
                new_attrs[3] = new_attrs[3] & ~(termios.ICANON | termios.ECHO | termios.ISIG)
                try:
                    termios.tcsetattr(fd, termios.TCSADRAIN, new_attrs)
                    while True:
                        left = self._cooldown_remaining()
                        if left <= 0:
                            break
                        m, s = divmod(left, 60)
                        pbar = t.progress_bar(total_pen - left, float(total_pen), width=18)
                        hint_s = "(Press Ctrl+C to return to prompt & use `check`)" if self.practice else "(Press Ctrl+C to return to prompt)"
                        prog_line = f"  {t.warn('⏳ Cooldown:')} {pbar} {t.bold(f'{m:02d}:{s:02d}')} remaining {t.muted(hint_s)}"
                        self._content_lines = [*_build_cd_panel(left), "", prog_line]
                        self._render_shell_viewport()
                        b = _read_next_tty_byte(fd, timeout_s=0.95)
                        if b == 3:  # Ctrl+C
                            raise KeyboardInterrupt
                except KeyboardInterrupt:
                    left_now = self._cooldown_remaining()
                    print("\n".join(_build_cd_panel(left_now)))
                    print(t.c(f"  [Cooldown] Paused wait ({self._format_cooldown_human(left_now)} left in background).", "warn", "bold"))
                    if self.practice:
                        print(t.c("  Tip: Use `check` or `run` right now with 0s wait, or `cooldown reset` / `grademe --now` to skip wait.", "muted"))
                    return
                finally:
                    try:
                        termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)
                    except Exception:
                        pass
                print(t.c("  ✓ Cooldown complete! Proceeding with official Deepthought grading...", "ok", "bold"))
            else:
                print("\n".join(_build_cd_panel(rem_wait)))
                if sys.stdin.isatty() or "--wait" in flags:
                    try:
                        while True:
                            left = self._cooldown_remaining()
                            if left <= 0:
                                break
                            m, s = divmod(left, 60)
                            pbar = t.progress_bar(total_pen - left, float(total_pen), width=18)
                            prompt_hint = "(Press Ctrl+C to return to prompt & use `check`)" if self.practice else "(Press Ctrl+C to return to prompt)"
                            line = f"\r  {t.warn('⏳ Cooldown:')} {pbar} {t.bold(f'{m:02d}:{s:02d}')} remaining {t.muted(prompt_hint)}   "
                            sys.stdout.write(line)
                            sys.stdout.flush()
                            time.sleep(1)
                        sys.stdout.write("\r" + (" " * 96) + "\r")
                        sys.stdout.flush()
                        print(t.c("  ✓ Cooldown complete! Proceeding with official Deepthought grading...", "ok", "bold"))
                    except KeyboardInterrupt:
                        sys.stdout.write("\n")
                        sys.stdout.flush()
                        left_now = self._cooldown_remaining()
                        print(t.c(f"  [Cooldown] Paused wait ({self._format_cooldown_human(left_now)} left in background).", "warn", "bold"))
                        if self.practice:
                            print(t.c("  Tip: Use `check` or `run` right now with 0s wait, or `cooldown reset` / `grademe --now` to skip wait.", "muted"))
                        return

        lvl = self.levels[self.current_idx]
        pts = lvl.get("points", round(100 / max(1, len(self.levels))))
        cur_attempt = self.attempts
        trace_name = f"{lvl['level']}-{cur_attempt}_{self.current_assignment}.trace"
        trace_path = self.traces_dir / trace_name

        pre_lines = [
            "Before continuing, please make SURE that you have pushed your files,",
            f"that they are in the right directory (~/exam-basedir/rendu/{self.current_assignment}),",
            "and that you didn't forget anything.",
            "If your assignment is wrong, you will stay on the same assignment at the same level.",
        ]
        if is_interactive_tty() and self._viewport_active:
            try:
                confirm = self._prompt_in_viewport("Are you sure? [y/N]: ", extra_lines=pre_lines).strip().lower()
            except (EOFError, KeyboardInterrupt):
                print("Grading request cancelled.")
                return
            if confirm not in {"y", "yes"}:
                print("Grading request cancelled.")
                return
        elif sys.stdin.isatty():
            print("")
            for pl in pre_lines:
                print(pl)
            print("")
            try:
                confirm = input("Are you sure? [y/N] ").strip().lower()
            except (EOFError, KeyboardInterrupt):
                print("")
                return
            if confirm not in {"y", "yes"}:
                return
        else:
            print("")
            for pl in pre_lines:
                print(pl)
            print("")
            print("Are you sure? [y/N] y")

        print(t.c("OK, making a grading request to the server now.", "primary"))
        print("")
        print(t.c("We will now wait for the job to complete.", "muted"))
        print(t.c("Please be patient, this CAN take several minutes...", "muted"))
        print(t.c("(10 seconds is fast, 30 seconds is expected, 3 minutes is a maximum)", "muted"))
        print(t.c("waiting...", "muted"))

        while True:
            has_push, pushed_dir = collect_pushed_files(self.vogsphere_dir)
            cleanup_root = pushed_dir.parent if pushed_dir.name == "repo" else pushed_dir
            try:
                submit_path = pushed_dir / self.current_assignment

                git_log_proc = subprocess.run(
                    ["git", f"--git-dir={self.vogsphere_dir}", "log", "--stat", "-n", "5"],
                    text=True,
                    capture_output=True,
                )
                if git_log_proc.returncode == 0 and git_log_proc.stdout.strip():
                    git_log_text = git_log_proc.stdout.rstrip()
                else:
                    git_log_text = "No commits pushed to vogsphere bare repository."

                # STRICT VOGSPHERE ENFORCEMENT: Do NOT fall back to unpushed local files in rendu/!
                target_dir = submit_path if (has_push and submit_path.exists()) else (pushed_dir / "__missing_submission__")
                if not has_push and target_dir.exists():
                    shutil.rmtree(target_dir)
                try:
                    result = grade_subject(
                        KIT_ROOT,
                        f"exams/{self.current_assignment}",
                        target_dir,
                        is_exam=True,
                        strict=False,
                        git_log_text=git_log_text,
                        enforce_norm=self.norm_enabled,
                    )
                except FileNotFoundError:
                    from deepthought.grader import build_deepthought_header

                    hdr = build_deepthought_header(
                        self.current_assignment,
                        target_dir,
                        [f"{self.current_assignment}.c"],
                        git_log_text=git_log_text,
                    )
                    fallback_trace = (
                        f"{hdr}\n$> ls -la {self.current_assignment}\n"
                        f"ls: {self.current_assignment}: No such file or directory\nNothing turned in\nGrade: 0"
                    )
                    result = GradeReport(self.current_assignment, False, "Nothing turned in", "Nothing turned in", fallback_trace, "", {})
                break
            except Exception as exc:
                print(t.c(">>>>>>>>>> ERROR <<<<<<<<<<", "err", "bold"))
                print(f"There was an error during the grading job! Specifically:\n  {exc}")
                print('You can choose to "retry" the grading job, or to "abort" it (draw a new assignment at the same level with no penalty).')
                if not sys.stdin.isatty():
                    return
                try:
                    choice = self._prompt_confirm_line("Action [retry/abort]: ").strip().lower()
                except (EOFError, KeyboardInterrupt):
                    return
                if choice.startswith("a"):
                    lvl_cands = lvl.get("candidates", [])
                    others = [c for c in lvl_cands if c != self.current_assignment] or lvl_cands
                    self.current_assignment = random.choice(others)
                    self._provision_subject_files(self.current_assignment)
                    self._save_session()
                    print(t.c(f"Current assignment aborted without penalty. New assignment for level {lvl['level']}: {self.current_assignment}", "ok", "bold"))
                    return
                print(t.c("Retrying grading job...", "primary"))
            finally:
                if cleanup_root.exists() and cleanup_root.name.startswith("vogsphere_pull_"):
                    shutil.rmtree(cleanup_root, ignore_errors=True)

        full_trace_text = result.trace
        summary_block = result.format_exam_trace_summary(include_coaching=self.practice)
        if summary_block and summary_block not in full_trace_text:
            full_trace_text = full_trace_text.rstrip() + "\n\n" + summary_block + "\n"

        trace_path.write_text(full_trace_text, encoding="utf-8")
        alias_trace = self.traces_dir / f"0-0_{self.current_assignment}.trace"
        alias_trace.write_text(full_trace_text, encoding="utf-8")
        level_slug_trace = self.traces_dir / f"{lvl['level']}-{self.current_assignment}.trace"
        level_slug_trace.write_text(full_trace_text, encoding="utf-8")
        self.attempts += 1

        if result.passed:
            self._reset_cooldown()
            self.grade = min(100, self.grade + pts)
            self.history.append(f"Level {lvl['level']} [{self.current_assignment}]: {result.status} (+{pts} pts)")
            self.level_records.append(
                {
                    "level": lvl["level"],
                    "attempt": cur_attempt,
                    "slug": self.current_assignment,
                    "points": pts,
                    "state": "Success",
                }
            )
            print(t.c(">>>>>>>>>> SUCCESS <<<<<<<<<<", "ok", "bold"))
            print(t.c(f"You have passed assignment '{self.current_assignment}'!", "ok"))
            print(f"Your new grade is: {self.grade} / 100")
            print(f">>> RESULT: {result.status} — Grade: {self.grade}/100 <<<")
            print(f"Trace saved to {t.c(f'~/exam-basedir/traces/{trace_name}', 'info')}")
            print(t.c("✓ Grading cooldown timer has been reset to 0s!", "ok"))
            p_prof = load_student_profile(self.login)
            p_prof.award_xp(pts * 4)
            p_prof.save()
            if self.current_idx + 1 < len(self.levels):
                self.current_idx += 1
                self.attempts = 0
                self.current_assignment = self._pick_assignment()
                self._provision_subject_files(self.current_assignment)
                print(f"Advancing to Level {self.levels[self.current_idx]['level']}: {self.current_assignment}")
            else:
                self.grade = 100
                self.lifecycle_state = "passed"
                print(t.c("CONGRATULATIONS! You have completed all levels of this exam (100/100)!", "ok", "bold"))
        else:
            self.last_exit_code = 1
            self.history.append(f"Level {lvl['level']} [{self.current_assignment}]: {result.status} (attempt {self.attempts})")
            self.level_records.append(
                {
                    "level": lvl["level"],
                    "attempt": cur_attempt,
                    "slug": self.current_assignment,
                    "points": pts,
                    "state": "Failure",
                }
            )
            print(t.c(">>>>>>>>>> FAILURE <<<<<<<<<<", "err", "bold"))
            print(t.c("You have failed the assignment.", "err"))
            detail_s = f" ({result.reason})" if result.reason and result.reason != result.status else ""
            print(f">>> RESULT: {result.status}{detail_s} — Grade remains {self.grade}/100 <<<")
            if summary_block:
                clean_summary = "\n".join(
                    ln for ln in summary_block.splitlines()
                    if not ln.strip().startswith(">>>>>>>>>> FAILURE")
                )
                if clean_summary.strip():
                    print(clean_summary)
            print(f"Trace saved to {t.c(f'~/exam-basedir/traces/{trace_name}', 'info')}")
            if self.cooldown_enabled:
                penalty_sec = self.attempts * self.cooldown_step
                self.last_penalty_sec = penalty_sec
                self.next_grademe_ts = self._now_ts() + penalty_sec
                s1 = self._format_cooldown_short(self.cooldown_step)
                s2 = self._format_cooldown_short(self.cooldown_step * 2)
                s3 = self._format_cooldown_short(self.cooldown_step * 3)
                s4 = self._format_cooldown_short(self.cooldown_step * 4)
                print(
                    t.c(
                        f"⏳ [COOLDOWN PENALTY]: Fail #{self.attempts} -> You must wait {self._format_cooldown_human(penalty_sec)} before your next `grademe`.",
                        "warn",
                        "bold",
                    )
                )
                print(
                    t.c(
                        f"   Penalty Scale : 1st fail = {s1} -> 2nd fail = {s2} -> 3rd fail = {s3} -> 4th fail = {s4} (+{self.cooldown_step}s each fail, resets to 0s on pass)",
                        "muted",
                    )
                )

        self._save_session()
        if not (is_interactive_tty() and self._viewport_active):
            print("\n(Press Enter to continue...)")
            print("")
            self.do_status("")

    def do_trace(self, arg: str) -> None:
        """Print the most recent Deepthought trace file with syntax coloring."""
        traces = sorted(self.traces_dir.glob("*.trace"), key=lambda p: p.stat().st_mtime)
        if not traces:
            print(self.theme.c("No traces available yet. Run `check` or `grademe` first.", "warn"))
            return
        raw_trace = traces[-1].read_text(encoding="utf-8", errors="replace")
        print(self.theme.colorize_trace(raw_trace))

    def do_diff(self, arg: str) -> None:
        """Show the unified diff from the most recent failed trace."""
        traces = sorted(self.traces_dir.glob("*.trace"), key=lambda p: p.stat().st_mtime)
        if not traces:
            print(self.theme.c("No traces available yet. Run `check` or `grademe` first.", "warn"))
            return
        raw_trace = traces[-1].read_text(encoding="utf-8", errors="replace")
        diff_lines = [
            line for line in raw_trace.splitlines()
            if line.startswith(("---", "+++", "@@", "-", "+", "$> ./", "$> diff", "Diff ", "Expected", "Actual", "Status :", "Detail :"))
        ]
        if not diff_lines:
            print(self.theme.colorize_trace("\n".join(raw_trace.splitlines()[-25:])))
            return
        colored = self.theme.colorize_trace("\n".join(diff_lines)).splitlines()
        print(self.theme.box_panel(f"LAST TRACE DIFF — {traces[-1].name}", colored, border_color="primary"))

    def do_tool(self, arg: str) -> None:
        """Alias for `tools`."""
        self.do_help(arg)

    def do_guidelines(self, arg: str) -> None:
        """Display the official 42 / 1337 Exam General & Coding Guidelines (examGUIDELINES.md)."""
        g_file = KIT_ROOT / "docs" / "examGUIDELINES.md"
        if g_file.is_file():
            raw = g_file.read_text(encoding="utf-8", errors="replace").rstrip()
            print(self.theme.box_panel("OFFICIAL 42 EXAM GENERAL & CODING GUIDELINES", raw.splitlines(), border_color="primary"))
        else:
            rows = [
                "1. Pure C only (except shell exercises). Respect exact file/directory/function names.",
                "2. Turn in files inside ~/exam-basedir/rendu/<assignment>/ and push to Vogsphere before grademe.",
                "3. Programs with explicit files compile with: clang -Wall -Wextra -Werror file1.c ... -o program_name",
                "4. Programs with *.c *.h compile with:        clang -Wall -Wextra -Werror *.c -o program_name",
                "5. Single functions compile with:             clang -c -Wall -Wextra -Werror yourfile.c (linked with Deepthought main.c)",
                "6. Any function not listed in Allowed functions is strictly forbidden (Cheating: -42).",
            ]
            print(self.theme.box_panel("OFFICIAL 42 EXAM GENERAL & CODING GUIDELINES", rows, border_color="primary"))

    def do_rules(self, arg: str) -> None:
        """Alias for `guidelines`."""
        self.do_guidelines(arg)

    def do_tools(self, arg: str) -> None:
        """Display extended student helper commands (`subject`, `trace`, `logs`, `time`, `clean`, etc.)."""
        self.do_help(arg)

    def do_help(self, arg: str) -> None:
        """Display the 3 core exam commands (`status`, `grademe`, `finish`) and reveal extra helper commands."""
        t = self.theme
        topic = arg.strip().lower()
        if topic and topic not in {"all", "tools", "extra"}:
            if not self.practice and topic not in NORMAL_MODE_ALLOWLIST:
                self.last_exit_code = 2
                print(t.c(f"Error: Help topic '{topic}' is restricted in normal exam mode. Available commands: status, grademe, finish, tools (or subject, trace, logs, time, clean, clear, help).", "err", "bold"))
                return
            fn = getattr(self, f"do_{topic}", None)
            if fn and fn.__doc__:
                lines = [
                    f"{t.secondary('Command')} : {t.cmd(topic)}",
                    f"{t.secondary('Usage  ')} : {fn.__doc__.strip()}",
                ]
                print(t.box_panel(f"HELP — {topic.upper()}", lines, border_color="primary"))
                return
            super().do_help(arg)
            return

        rows = [
            t.bold("Core Exam Commands (Official 42 ExamShell):"),
            f"  {t.accent('status'):<18} Display current level, grade, assignment history, and remaining time",
            f"  {t.accent('grademe'):<18} Push check & submit your current assignment to Deepthought",
            f"  {t.accent('finish'):<18} End your exam session and record final score",
            "",
            t.bold("Extra Helper Commands (Convenience Tools):"),
            f"  {t.accent('subject [--pager]'):<18} Display the current assignment subject.en.txt",
            f"  {t.accent('trace [--pager]'):<18} Display the Deepthought trace & diff of your last grademe",
            f"  {t.accent('logs [file]'):<18} List or read saved trace files in ~/exam-basedir/traces/",
            f"  {t.accent('time'):<18} Display session clock, remaining time, and cooldown timer",
            f"  {t.accent('history'):<18} Display chronological history of your grademe attempts",
            f"  {t.accent('clean'):<18} Remove compiled binaries/temp files (a.out, *.o) from rendu/",
            f"  {t.accent('clear'):<18} Clear terminal screen and redraw status",
            f"  {t.accent('more'):<18} Open interactive scrollable pager (j/k/Space/q) on long output",
            f"  {t.accent('guidelines'):<18} Display official 42 Exam General & Coding Guidelines",
        ]
        if self.practice:
            rows.extend(
                [
                    "",
                    t.bold("Practice Mode Commands (--practice only):"),
                    f"  {t.ok('check / test'):<18} Instant local Moulinette test (0s cooldown, no git push needed)",
                    f"  {t.ok('run [args...]'):<18} Compile and run your code with custom arguments",
                    f"  {t.ok('edit [editor]'):<18} Open current assignment in your editor ($EDITOR / vim)",
                    f"  {t.ok('push'):<18} Auto-stage, commit, and push rendu/ to Vogsphere",
                    f"  {t.ok('skip / reroll'):<18} Advance level or draw another assignment at current level",
                    f"  {t.ok('cooldown reset'):<18} Reset grading cooldown timer to 0s",
                ]
            )
        print(t.box_panel("EXAMSHELL COMMANDS (CORE + EXTRA TOOLS)", rows, border_color="primary"))

    def do_assign(self, arg: str) -> None:
        """Set or switch the current assignment slug (e.g., 'assign ft_strlen' or 'assign ft_split')."""
        if not self.practice:
            self.last_exit_code = 2
            print(self.theme.c("Error: Command 'assign' is restricted in normal exam mode.", "err", "bold"))
            return
        slug = arg.strip()
        if not slug:
            print("Usage: assign <exercise_slug>")
            return
        subj_dir = KIT_ROOT / "subjects" / "exams" / slug
        if not subj_dir.exists():
            print(f"Unknown exam exercise: {slug}")
            return
        self.current_assignment = slug
        self.attempts = 0
        self._reset_cooldown()
        self._provision_subject_files(slug)
        self._save_session()
        print(f"Current assignment set to: {slug}")
        self.do_status("")

    def complete_assign(self, text: str, line: str, begidx: int, endidx: int) -> List[str]:
        if not self.practice:
            return []
        all_slugs = sorted(p.name for p in (KIT_ROOT / "subjects" / "exams").iterdir() if p.is_dir())
        return [s for s in all_slugs if s.startswith(text)]

    def complete_theme(self, text: str, line: str, begidx: int, endidx: int) -> List[str]:
        if not self.practice:
            return []
        opts = [*sorted(PALETTES), "plain"]
        return [o for o in opts if o.startswith(text)]

    def complete_enable(self, text: str, line: str, begidx: int, endidx: int) -> List[str]:
        if not self.practice:
            return []
        return [o for o in ["norm", "norminette"] if o.startswith(text)]

    def complete_disable(self, text: str, line: str, begidx: int, endidx: int) -> List[str]:
        if not self.practice:
            return []
        return [o for o in ["norm", "norminette"] if o.startswith(text)]


    def do_ssh_key(self, arg: str) -> None:
        """Bind or list SSH public keys (id_rsa_pub) for the local bare Vogsphere repository directly in terminal."""
        from deepthought.vogsphere import get_registered_ssh_keys, register_ssh_key

        raw = arg.strip()
        if not raw or raw == "list":
            keys = get_registered_ssh_keys(self.vogsphere_dir)
            print(f"Vogsphere Bare Repo : {self.vogsphere_dir}")
            print(f"Registered SSH Keys : {len(keys)}")
            for idx, k in enumerate(keys, 1):
                short = k if len(k) <= 72 else (k[:48] + "..." + k[-20:])
                print(f"  [{idx}] {short}")
            return
        key_path = Path(raw).expanduser()
        pubkey_text = key_path.read_text(encoding="utf-8") if key_path.is_file() else raw
        try:
            info = register_ssh_key(self.vogsphere_dir, pubkey_text, login=self.login)
            print(f"vogsphere: (INFO) Transaction ID : {info['transaction_id']}")
            print(f"vogsphere: (INFO) SSH Key bound  : {info['key_type']} {info['fingerprint']} ({info['comment']})")
            print(f"vogsphere: (INFO) Repository URI : {info['vogsphere_uri']}")
            print("vogsphere: (INFO) You have read and write rights on this repository")
        except ValueError as exc:
            print(f"vogsphere: (ERROR) {exc}")

    def do_klist(self, arg: str) -> None:
        """Display Kerberos ticket cache (as referenced by Vogsphere in exqm.txt)."""
        now_dt = self._start_dt()
        exp_dt = dt.datetime.fromtimestamp(self.start_ts + 36000, tz=now_dt.tzinfo)
        print(f"Ticket cache: FILE:/tmp/krb5cc_1000_{self.login}")
        print(f"Default principal: {self.login}@1337.MA")
        print("")
        print("Valid starting       Expires              Service principal")
        print(f"{now_dt.strftime('%d/%m/%Y %H:%M:%S')}  {exp_dt.strftime('%d/%m/%Y %H:%M:%S')}  krbtgt/1337.MA@1337.MA")
        print(f"        renew until {(now_dt + dt.timedelta(days=7)).strftime('%d/%m/%Y %H:%M:%S')}")

    def do_force_success(self, arg: str) -> None:
        """[Practice Mode] Force current assignment validation and advance to the next level."""
        if not self.practice:
            self.last_exit_code = 2
            print(self.theme.c("Error: Command 'force_success' is restricted in normal exam mode.", "err", "bold"))
            return
        lvl = self.levels[self.current_idx]
        pts = lvl.get("points", round(100 / max(1, len(self.levels))))
        cur_attempt = self.attempts
        self._reset_cooldown()
        self.grade = min(100, self.grade + pts)
        self.history.append(f"Level {lvl['level']} [{self.current_assignment}]: FORCED OK (+{pts} pts)")
        self.level_records.append(
            {
                "level": lvl["level"],
                "attempt": cur_attempt,
                "slug": self.current_assignment,
                "points": pts,
                "state": "Success",
            }
        )
        print(">>>>>>>>>> SUCCESS <<<<<<<<<<")
        print(f"You have passed assignment '{self.current_assignment}'!")
        print(f"Your new grade is: {self.grade} / 100")
        if self.current_idx + 1 < len(self.levels):
            self.current_idx += 1
            self.attempts = 0
            self.current_assignment = self._pick_assignment()
            self._provision_subject_files(self.current_assignment)
            print(f"Advancing to Level {self.levels[self.current_idx]['level']}: {self.current_assignment}")
        else:
            self.grade = 100
            self.lifecycle_state = "passed"
            print("CONGRATULATIONS! You have completed all levels of this exam (100/100)!")
        self._save_session()

    def do_remove_grade_time(self, arg: str) -> None:
        """[Practice Mode] Reset grading wait/cooldown timer between grademe attempts."""
        if not self.practice:
            self.last_exit_code = 2
            print(self.theme.c("Error: Command 'remove_grade_time' is restricted in normal exam mode.", "err", "bold"))
            return
        self._reset_cooldown()
        self._save_session()
        print(self.theme.c("[VIP Practice] Cooldown timer between grademe requests has been reset to 0s!", "ok", "bold"))

    def do_cooldown(self, arg: str) -> None:
        """View, reset, or configure the progressive grademe failure wait timer (`cooldown [reset|off|on|<seconds>]`)."""
        if not self.practice:
            self.last_exit_code = 2
            print(self.theme.c("Error: Command 'cooldown' is restricted in normal exam mode.", "err", "bold"))
            return
        t = self.theme
        sub = arg.strip().lower()
        if sub in {"reset", "clear", "0", "skip"}:
            self._reset_cooldown()
            self._save_session()
            print(t.c("✓ Grading cooldown timer reset to 0s! You can run `grademe` immediately.", "ok", "bold"))
            return
        if sub in {"off", "disable", "false"}:
            self.cooldown_enabled = False
            self._reset_cooldown()
            self._save_session()
            print(t.c("✓ Progressive grading cooldown DISABLED (0s wait between grademe attempts).", "warn", "bold"))
            return
        if sub in {"on", "enable", "true"}:
            self.cooldown_enabled = True
            self._save_session()
            print(t.c(f"✓ Progressive grading cooldown ENABLED (+{self.cooldown_step}s per failed attempt, resets on pass).", "ok", "bold"))
            return
        if sub.isdigit() and int(sub) > 0:
            self.cooldown_step = int(sub)
            self._save_session()
            s1 = self._format_cooldown_short(self.cooldown_step)
            s2 = self._format_cooldown_short(self.cooldown_step * 2)
            s3 = self._format_cooldown_short(self.cooldown_step * 3)
            print(t.c(f"✓ Cooldown step set to {self.cooldown_step}s per failure ({s1} -> {s2} -> {s3} ...).", "ok", "bold"))
            return

        rem = self._cooldown_remaining()
        next_pen = (self.attempts + 1) * self.cooldown_step
        s1 = self._format_cooldown_short(self.cooldown_step)
        s2 = self._format_cooldown_short(self.cooldown_step * 2)
        s3 = self._format_cooldown_short(self.cooldown_step * 3)
        s4 = self._format_cooldown_short(self.cooldown_step * 4)
        state_str = (
            t.c("DISABLED (0s wait)", "muted")
            if not self.cooldown_enabled
            else (
                t.c(f"⏳ WAITING — {self._format_cooldown_human(rem)} remaining", "warn", "bold")
                if rem > 0
                else t.c("✓ READY (0s wait right now)", "ok", "bold")
            )
        )
        rows = [
            f"{t.secondary('Cooldown Status  ')} : {state_str}",
            f"{t.secondary('Current Exercise ')} : {t.primary(self.current_assignment)} (Failed grademe attempts: {t.bold(str(self.attempts))})",
            f"{t.secondary('Next Fail Penalty')} : {t.warn(self._format_cooldown_human(next_pen))} (Attempt #{self.attempts + 1} if failed)",
            f"{t.secondary('Progression Scale')} : Fail #1 = {s1} -> Fail #2 = {s2} -> Fail #3 = {s3} -> Fail #4 = {s4} (+{self.cooldown_step}s each fail)",
            f"{t.secondary('Reset Condition  ')} : Resets to {t.ok('0s')} automatically when you pass the exercise!",
            "",
            t.bold("Quick Cooldown Commands:"),
            f"  {pad_visible(t.cmd('cooldown reset'), 24)} Clear active wait timer to 0s immediately (alias: {t.cmd('remove_grade_time')})",
            f"  {pad_visible(t.cmd('cooldown off') + ' / ' + t.cmd('on'), 24)} Disable or enable progressive wait penalties for this session",
            f"  {pad_visible(t.cmd('cooldown 30'), 24)} Set base wait increment in seconds (default: 30s)",
            f"  {pad_visible(t.cmd('grademe --now'), 24)} Grade immediately and bypass any active cooldown timer",
        ]
        print(t.box_panel("GRADING COOLDOWN TIMER — PRO CONTROL PANEL", rows, border_color="primary"))

    def do_kinit(self, arg: str) -> None:
        """Simulate `kinit [student_login]` Kerberos TGT acquisition for @1337.MA (never stores or echoes passwords)."""
        tokens = arg.strip().split()
        prompt_pw = "--prompt" in tokens
        clean_tokens = [tok for tok in tokens if tok != "--prompt"]
        login = clean_tokens[0] if clean_tokens else self.login
        self.login = login
        print("[LOCAL SIMULATION — Kerberos TGT Acquisition]")
        if prompt_pw and sys.stdin.isatty():
            try:
                _ = _read_masked_password(f"Password for {login}@1337.MA (simulated, hidden): ")
            except (EOFError, KeyboardInterrupt):
                print("")
                return
        else:
            print(f"Password for {login}@1337.MA: [hidden — local simulation]")
        print(f"Authenticating {login}@1337.MA... [OK]")
        self.do_klist("")

    def do_sessions(self, arg: str) -> None:
        """Display the verbatim Examshell v2.4.1-release EXAM SESSION SELECTION table."""
        print_session_selection_table(self.login)

    def do_menu(self, arg: str) -> None:
        """Display the official 42 / 1337 exam tracks menu and session selection table."""
        print_session_selection_table(self.login)
        print("")
        print_official_menu()

    def do_finish(self, arg: str) -> bool:
        """End the exam session."""
        finish_lines = [
            "Please confirm that you REALLY want to end your current session.",
            "If you do, you will not be able to do anything with it anymore!",
        ]
        if is_interactive_tty() and self._viewport_active:
            try:
                ans = self._prompt_in_viewport("Are you finished? [y/N]: ", extra_lines=finish_lines).strip().lower()
            except (EOFError, KeyboardInterrupt):
                print("Finish cancelled. Session remains active.")
                return False
            if ans not in {"y", "yes"}:
                print("Finish cancelled. Session remains active.")
                return False
        elif sys.stdin.isatty():
            for fl in finish_lines:
                print(fl)
            try:
                ans = input("Are you finished? [y/N] ").strip().lower()
            except (EOFError, KeyboardInterrupt):
                print("")
                return False
            if ans not in {"y", "yes"}:
                return False
        else:
            for fl in finish_lines:
                print(fl)
            print("Are you finished? [y/N] y")
        self._save_session(finished=True)
        print("Your session has been marked as finished. You may now log out.")
        return True

    def do_exit(self, arg: str) -> bool:
        return self.do_finish(arg)

    def do_quit(self, arg: str) -> bool:
        return self.do_finish(arg)

    def do_EOF(self, arg: str) -> bool:
        if not (is_interactive_tty() and self._viewport_active):
            print("")
        return self.do_finish(arg)


def _describe_pool_levels(slug: str, fallback: str = "Levels") -> tuple[str, str]:
    yml_path = KIT_ROOT / "pools" / "exams" / f"{slug}.yml"
    if not yml_path.is_file():
        return "4h (14400s)", fallback
    try:
        data = yaml.safe_load(yml_path.read_text(encoding="utf-8")) or {}
        secs = int(data.get("duration_seconds") or 0)
        h = secs // 3600
        dur_str = f"{h}h ({secs}s)" if secs else "4h (14400s)"
        levels = data.get("levels") or []
        if not levels:
            return dur_str, fallback
        n = len(levels)
        pts = levels[0].get("points", round(100 / n))
        total_ex = sum(len(l.get("candidates") or []) for l in levels)
        return dur_str, f"{n} Levels (0..{n - 1}, {pts} pts/lvl, {total_ex} exercises)"
    except Exception:
        return "4h (14400s)", fallback


SESSION_TRACKS = (
    ("c_piscine_exam_00", "C Piscine Exam 00", "piscine"),
    ("c_piscine_exam_01", "C Piscine Exam 01", "piscine"),
    ("c_piscine_exam_02", "C Piscine Exam 02", "piscine"),
    ("c_piscine_final_exam", "C Piscine Final Exam", "piscine"),
    ("rank02", "Exam Rank 02", "common core"),
    ("rank03", "Exam Rank 03", "common core"),
    ("rank04", "Exam Rank 04", "common core"),
    ("rank05", "Exam Rank 05", "common core"),
    ("rank06", "Exam Rank 06", "common core"),
)


def _pool_facts(slug: str) -> tuple[str, str, str, str]:
    """(duration, levels, points per level, exercises) read from pools/exams/<slug>.yml; '?' when unknown."""
    try:
        data = yaml.safe_load((KIT_ROOT / "pools" / "exams" / f"{slug}.yml").read_text(encoding="utf-8")) or {}
    except Exception:
        return "?", "?", "?", "?"
    secs = int(data.get("duration_seconds") or 0)
    h, m = divmod(secs // 60, 60)
    dur = f"{h}h" if m == 0 else f"{h}h{m:02d}"
    levels = data.get("levels") or []
    n = len(levels)
    pts = str(levels[0].get("points", round(100 / n))) if n else "?"
    total = sum(len(lv.get("candidates") or []) for lv in levels)
    return (dur if secs else "?"), (str(n) if n else "?"), pts, (str(total) if n else "?")


def print_session_selection_table(login: str = DEFAULT_LOGIN) -> None:
    t = ThemeEngine("plain")
    cols, _ = t.term_size()
    w = max(44, min(80, cols))
    print("=" * w)
    print("EXAM SESSION SELECTION")
    print("-" * w)
    print(f"Available sessions for '{login}':")
    print("")
    if cols < 72:
        print("  ID  Session               Dur     Status")
        print("  --  --------------------  ------  -----------")
        print("  0   C Piscine Exam 00     06h00m  [COMPLETED]")
        print("  1   C Piscine Exam 01     06h00m  [AVAILABLE]")
        print("  2   C Piscine Exam 02     08h00m  [LOCKED]")
        print("  3   C Piscine Final Exam  10h00m  [LOCKED]")
    else:
        print("  ID   Session Name                  Rank / Cursus        Duration   Status")
        print("  --   ---------------------------   ------------------   --------   -----------")
        print("  0    C Piscine Exam 00             C Piscine            06h 00m    [COMPLETED]")
        print("  1    C Piscine Exam 01             C Piscine            06h 00m    [AVAILABLE]")
        print("  2    C Piscine Exam 02             C Piscine            08h 00m    [LOCKED]")
        print("  3    C Piscine Final Exam          C Piscine            10h 00m    [LOCKED]")
    print("")
    print("-" * w)
    print("Select session ID to launch (or 'q' to quit): 1")
    print("=" * w)


def print_official_menu(theme: ThemeEngine | None = None) -> None:
    t = theme or ThemeEngine("plain" if os.environ.get("NO_COLOR") else "42-cluster")
    cols, _ = t.term_size()
    w = max(44, min(88, cols))
    print(t.startup_banner(version="v0.1.1", mode="real", width=w))
    print("=" * w)
    print("  42 / 1337 OFFICIAL EXAMSHELL v0.1.1 — AVAILABLE EXAM TRACKS (--menu)")
    print("=" * w)
    official_piscine = [
        ("c_piscine_exam_00", "C Piscine Exam 00"),
        ("c_piscine_exam_01", "C Piscine Exam 01"),
        ("c_piscine_exam_02", "C Piscine Exam 02"),
        ("c_piscine_final_exam", "C Piscine Final Exam"),
    ]
    print("  [PISCINE PART — OFFICIAL 42 / 1337 C PISCINE EXAMS]")
    for idx, (slug, title) in enumerate(official_piscine, 1):
        dur, lvls = _describe_pool_levels(slug, "Levels")
        if cols < 76:
            print(f"  {idx}) {slug} ({dur}) — {lvls}")
        else:
            print(f"    {idx}) {slug:<22} | {title:<22} | Duration: {dur:<12} | {lvls}")
    print("-" * w)
    print("  [STUD_PART — COMMON CORE EXAMS (SEPARATED)]")
    common_core = [
        ("rank02", "Common Core Exam Rank 02"),
        ("rank03", "Common Core Exam Rank 03"),
        ("rank04", "Common Core Exam Rank 04"),
        ("rank05", "Common Core Exam Rank 05"),
        ("rank06", "Common Core Exam Rank 06"),
    ]
    for idx, (slug, title) in enumerate(common_core, 5):
        dur, lvls = _describe_pool_levels(slug, "Levels")
        if cols < 76:
            print(f"  {idx}) {slug} ({dur}) — {lvls}")
        else:
            print(f"    {idx}) {slug:<22} | {title:<24} | Duration: {dur:<12} | {lvls}")
    print("=" * w)


def interactive_identity_screen(
    theme: ThemeEngine,
    login: str = DEFAULT_LOGIN,
    basedir: Path | None = None,
    mode: str = "real",
) -> str:
    """STAGE 1/4: IDENTITY — Startup banner and simulated Kerberos / Vogsphere identity screen."""
    active_login = login
    disp_basedir = "~/exam-basedir" if basedir is None else str(basedir)
    mode_lbl = "PRACTICE / COACHING MODE" if mode == "practice" else "NORMAL EXAM MODE"
    status_notice = ""

    def _build_stage1_lines(cols: int, rows: int) -> list[str]:
        w = max(40, min(88, cols))
        lines: list[str] = []
        banner_lines = theme.startup_banner(version="v0.1.1", mode=mode, width=w, height=rows).splitlines()
        if rows >= 18:
            lines.extend(banner_lines)
        else:
            lines.extend(banner_lines[:4])
        lines.append(theme.c("  [STAGE 1/4: IDENTITY — LOCAL KERBEROS / VOGSPHERE SESSION]", "primary", "bold"))
        lines.append(theme.c("-" * w, "border"))
        lines.append(f"  Principal  : {theme.c(f'{active_login}@1337.MA', 'ok', 'bold')} [LOCAL SIMULATION]")
        lines.append(f"  Active Mode: {theme.c(mode_lbl, 'warn' if mode == 'practice' else 'ok', 'bold')}")
        lines.append(f"  Workspace  : {theme.c(disp_basedir, 'info')}")
        if status_notice:
            lines.append(f"  Status     : {status_notice}")
        budget = max(6, rows - 2)
        if len(lines) > budget:
            lines = lines[:budget]
        else:
            lines.extend([""] * (budget - len(lines)))
        footer = theme.c(
            clip_visible("Enter=Exam Selection | kinit <login>=Switch User | q=Quit", cols),
            "muted",
        )
        lines.append(footer)
        return lines

    while True:
        cols, rows = theme.term_size()
        prompt_str = (
            theme.c(f"Identity [{active_login}] (Enter=continue, 'kinit <login>', q=quit): ", "primary", "bold")
            if theme.enabled
            else f"Identity [{active_login}] (Enter=continue, 'kinit <login>', q=quit): "
        )
        sys.stdout.write(render_viewport_frame(_build_stage1_lines(cols, rows), prompt_str, cols, rows))
        sys.stdout.flush()
        try:
            raw = _read_tty_line(
                prompt_str,
                theme,
                redraw_fn=lambda b, p: sys.stdout.write(
                    render_viewport_frame(_build_stage1_lines(*theme.term_size()), prompt_str, *theme.term_size())
                )
                or sys.stdout.flush(),
            ).strip()
        except (EOFError, KeyboardInterrupt):
            raise SystemExit(0)

        low = raw.lower()
        if not raw or low in {"c", "continue", "next", "ok"}:
            return active_login
        if low in {"q", "quit", "exit"}:
            raise SystemExit(0)
        if low.startswith("kinit") or low.startswith("login"):
            parts = raw.split()
            if len(parts) >= 2:
                active_login = parts[1].strip()
            else:
                login_prompt = f"Login [{active_login}]: "
                try:
                    entered = _read_tty_line(login_prompt, theme).strip()
                    if entered:
                        active_login = entered
                except (EOFError, KeyboardInterrupt):
                    continue
            try:
                _ = _read_masked_password(
                    f"Password for {active_login}@1337.MA (simulated, hidden): ",
                    theme=theme,
                )
            except (EOFError, KeyboardInterrupt):
                continue
            status_notice = theme.c(
                f"Kerberos ticket initialized for {active_login}@1337.MA [LOCAL]",
                "ok",
                "bold",
            )
            continue
        status_notice = theme.c(
            f"Unrecognized input '{raw}'. Press Enter to continue, 'kinit <login>', or 'q' to quit.",
            "warn",
        )


def interactive_select_pool(
    theme: ThemeEngine,
    login: str = DEFAULT_LOGIN,
    basedir: Path | None = None,
    mode: str = "real",
) -> tuple[str, bool, bool, str]:
    """EXAM SESSION SELECTION — msfconsole-style session table read from pools/exams/*.yml."""
    choices = [(slug, title, track, *_pool_facts(slug)) for slug, title, track in SESSION_TRACKS]

    sess_file = (basedir or (Path.home() / "exam-basedir")) / ".session.json"
    saved_session: dict | None = None
    if sess_file.is_file():
        try:
            data = json.loads(sess_file.read_text(encoding="utf-8"))
            if not data.get("finished", False) and data.get("pool"):
                saved_session = data
        except Exception:
            saved_session = None

    active_login = login
    page = 0
    notice = ""
    default_choice = "0" if saved_session else "1"
    prompt_range = f"0-{len(choices)}" if saved_session else f"1-{len(choices)}"

    def _build_stage2_lines(cols: int, rows: int) -> tuple[list[str], int]:
        nonlocal page
        w = max(40, min(80, cols))
        mode_tag = "practice / coaching" if mode == "practice" else "normal exam"
        piscine_n = sum(1 for c in choices if c[2] == "piscine")
        stats = theme.stats_block(
            [
                "examshell v0.1.1 - 42 / 1337 exam environment",
                f"{len(choices)} sessions - {piscine_n} piscine - {len(choices) - piscine_n} common core",
                f"Principal: {active_login}@1337.MA - mode: {mode_tag}",
            ],
            width=w,
        )
        resume_ln: list[str] = []
        if saved_session:
            resume_ln = [clip_visible(theme.status(
                "status",
                f"Unfinished session: {saved_session.get('pool', '?')} "
                f"(grade {saved_session.get('grade', 0)}/100, on {saved_session.get('current_assignment', '?')}). "
                f"Type {theme.c('0', 'ok', 'bold')} to resume.",
            ), cols)]
        wide = cols >= 72
        headers = ["#", "Exam", "Track", "Time", "Levels", "Pts/Lvl", "Exercises"] if wide else ["#", "Exam", "Time", "Lvls"]

        def _row(i: int, c: tuple) -> list[str]:
            slug, title, track, dur, lvls, pts, exs = c
            return [str(i), title, track, dur, lvls, pts, exs] if wide else [str(i), title, dur, lvls]

        footer = clip_visible(theme.status(
            "status", f"Type a number [{prompt_range}], 'kinit <login>', 'n'/'p' to page, or 'q' to quit."
        ), cols)
        tail = ([notice] if notice else []) + [footer]
        banner = theme.tool_banner("examshell", w, tagline="Don't Panic. Deepthought is watching.")
        all_rows = [_row(i, c) for i, c in enumerate(choices, 1)]
        budget = rows - 1  # last row is the prompt

        def _compose(full: bool, with_banner: bool, sub_rows: list[list[str]], title: str) -> list[str]:
            tbl = theme.table(title, headers, sub_rows, max_width=cols)
            if not full:
                tbl = [tbl[0], *tbl[3:]]  # drop '=' underline and blank on tiny screens
                return [stats[0], *resume_ln, *tbl, *tail]
            out = [*banner, ""] if with_banner else []
            return [*out, *stats, "", *resume_ln, *tbl, "", *tail]

        title = "EXAM SESSION SELECTION"
        for full, with_banner in ((True, True), (True, False), (False, False)):
            if with_banner and not banner:
                continue
            lines = _compose(full, with_banner, all_rows, title)
            if len(lines) <= budget:
                page = 0
                return lines, 1

        fixed = len(_compose(False, False, [], title))
        per_page = max(1, budget - fixed)
        total_pages = max(1, (len(all_rows) + per_page - 1) // per_page)
        page = page % total_pages
        sub = all_rows[page * per_page : (page + 1) * per_page]
        return _compose(False, False, sub, f"{title} - Page {page + 1}/{total_pages}")[:budget], total_pages

    while True:
        cols, rows = theme.term_size()
        frame_lines, total_pages = _build_stage2_lines(cols, rows)
        prompt_str = (
            theme.c(
                f"Select session [{prompt_range}] (Enter={default_choice}, q=quit): ",
                "primary",
                "bold",
            )
            if theme.enabled
            else f"Select session [{prompt_range}] (Enter={default_choice}, q=quit): "
        )
        _write_viewport_frame(frame_lines, prompt_str, cols, rows)
        try:
            raw = _read_tty_line(
                prompt_str,
                theme,
                redraw_fn=lambda b, p: _write_viewport_frame(
                    _build_stage2_lines(*theme.term_size())[0], prompt_str, *theme.term_size()
                ),
            ).strip()
        except (EOFError, KeyboardInterrupt):
            raise SystemExit(0)

        low = raw.lower()
        if low in {"clear", "cls"} or raw == "\x0c":
            notice = ""
            continue
        if low in {"n", "next"}:
            page = (page + 1) % max(1, total_pages)
            notice = ""
            continue
        if low in {"p", "prev"}:
            page = (page - 1) % max(1, total_pages)
            notice = ""
            continue
        if low.startswith("kinit") or low.startswith("login"):
            parts = raw.split()
            if len(parts) >= 2:
                active_login = parts[1].strip()
            else:
                try:
                    entered = _read_tty_line(f"Login [{active_login}]: ", theme).strip()
                    if entered:
                        active_login = entered
                except (EOFError, KeyboardInterrupt):
                    continue
            try:
                _ = _read_masked_password(
                    f"Password for {active_login}@1337.MA (simulated, hidden): ",
                    theme=theme,
                )
            except (EOFError, KeyboardInterrupt):
                continue
            notice = theme.status("good", f"Kerberos ticket initialized for {active_login}@1337.MA (local simulation)")
            continue
        if low in {"q", "quit", "exit"}:
            raise SystemExit(0)
        if not raw:
            raw = default_choice
        if raw == "0" and saved_session:
            return str(saved_session.get("pool", choices[0][0])), False, True, active_login
        if raw.isdigit() and 1 <= int(raw) <= len(choices):
            return choices[int(raw) - 1][0], False, False, active_login
        resolved_cand = resolve_pool_slug(raw)
        cand_file = Path(raw) if Path(raw).is_file() else (KIT_ROOT / "pools" / "exams" / f"{resolved_cand}.yml")
        if cand_file.exists():
            return raw, False, False, active_login
        notice = theme.status("error", f"Unknown session '{raw}'. Pick a number from the table or a pool slug.")


def main() -> int:
    parser = argparse.ArgumentParser(description="42 / 1337 Authentic ExamShell v0.1.1 — Pro Edition")
    parser.add_argument("pool", nargs="?", default=None, help="Exam pool ID (e.g. c_piscine_exam_00, exam00, examfinal)")
    parser.add_argument("-p", "--pool", dest="pool_flag", default=None, help="Exam pool ID")
    parser.add_argument("-m", "--menu", action="store_true", help="Display official exam tracks menu and exit")
    parser.add_argument("--mode", choices=["real", "test", "practice"], default=None, help="Session mode (default: real)")
    parser.add_argument("--practice", action="store_true", help="Enable special practice/coaching mode (alias for --mode practice)")
    parser.add_argument("--duration", type=int, default=None, help="Override exam duration in seconds (> 0)")
    parser.add_argument("-l", "--level", type=int, default=None, help="Starting exam level")
    parser.add_argument("-s", "--seed", type=int, default=42, help="Random seed for candidate pool draw")
    parser.add_argument("--login", default=DEFAULT_LOGIN, help="Student login (defaults to $USER)")
    parser.add_argument("-b", "--basedir", "--workspace", dest="basedir", type=Path, default=None, help="Custom exam-basedir path")
    parser.add_argument("--fresh", action="store_true", help="Force fresh session")
    parser.add_argument("-r", "--resume", action="store_true", help="Resume existing session in basedir")
    parser.add_argument("-t", "--theme", default="42-cluster", choices=sorted(PALETTES), help="Color theme")
    parser.add_argument("-c", "--command", dest="command", default=None, help="Execute a single examshell command and exit")
    parser.add_argument("--no-color", action="store_true", help="Disable ANSI colors")
    if any(arg.split("=", 1)[0].strip().lower() in {"--solution", "--solve", "solution", "solve"} for arg in sys.argv[1:]):
        print("Error: Reference solutions are strictly locked in ExamShell to preserve the 42 / 1337 peer-learning methodology. Use 'subject' and debug from the Deepthought trace.")
        return 2
    args = parser.parse_args()

    use_no_color = bool(args.no_color or os.environ.get("NO_COLOR"))
    t_sel = ThemeEngine("plain" if use_no_color else args.theme)

    if args.menu:
        print_official_menu(t_sel)
        return 0

    if args.basedir is not None:
        try:
            validate_safe_basedir(args.basedir)
        except ValueError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1

    raw_pool_arg = args.pool_flag or args.pool
    if raw_pool_arg and str(raw_pool_arg).strip().lower() in {"clear", "cls"}:
        if is_interactive_tty():
            sys.stdout.write("\033[H\033[2J")
            sys.stdout.flush()
        return 0
    explicit_mode = "practice" if args.practice else args.mode
    practice_flag = explicit_mode == "practice"
    resume_flag = bool(args.resume and not args.fresh)
    active_login = args.login
    showed_menu_banner = False

    with TerminalSessionGuard():
        if os.environ.get("EXAMSHELL_SIMULATE_CRASH") == "startup":
            raise RuntimeError("Simulated startup crash for terminal restoration verification")

        if raw_pool_arg is None and not resume_flag and is_interactive_tty():
            raw_pool_arg, extra_prac, picked_resume, active_login = interactive_select_pool(
                t_sel,
                login=active_login,
                basedir=Path(args.basedir) if args.basedir else None,
                mode="practice" if practice_flag else "real",
            )
            showed_menu_banner = True
            practice_flag = practice_flag or extra_prac
            if picked_resume and not args.fresh:
                resume_flag = True

        pool_id = raw_pool_arg or "c_piscine_exam_00"
        resolved_pool = resolve_pool_slug(pool_id)
        pool_path = Path(pool_id) if Path(pool_id).is_file() else (KIT_ROOT / "pools" / "exams" / f"{resolved_pool}.yml")
        if not pool_path.exists():
            print(f"Error: Unknown exam pool '{pool_id}'. Available in pools/exams/:")
            for p in sorted((KIT_ROOT / "pools" / "exams").glob("*.yml")):
                print("  -", p.stem)
            return 1

        try:
            shell = ExamShell(
                pool=pool_id,
                level=args.level,
                seed=args.seed,
                practice=practice_flag,
                explicit_mode=explicit_mode,
                theme_name=args.theme,
                no_color=use_no_color,
                basedir=Path(args.basedir) if args.basedir else None,
                resume_session=resume_flag,
                login=active_login,
                duration_override=args.duration,
                defer_init_basedir=True,
            )
        except ValueError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1

        shell.print_boot_header(show_banner=not showed_menu_banner)
        if args.command is not None:
            for raw_ln in str(args.command).splitlines():
                cmd_line = raw_ln.strip()
                if not cmd_line:
                    continue
                print(f"examshell> {cmd_line}")
                if shell.onecmd(cmd_line):
                    break
            return int(getattr(shell, "last_exit_code", 0) or 0)
        if not is_interactive_tty():
            for line in sys.stdin:
                cmd_line = line.strip()
                if not cmd_line:
                    continue
                print(f"examshell> {cmd_line}")
                if shell.onecmd(cmd_line):
                    break
            return 0

        def _handle_ctrl_c() -> None:
            shell.last_exit_code = 130
            shell._footer_notice = "^C — Input cleared (session active; type 'finish' or press Ctrl+D to exit)"
            shell._render_shell_viewport()

        def _handle_ctrl_l(buf_s: str, cur_p: int) -> None:
            shell.do_clear("")
            shell._render_shell_viewport(buf_s, cur_p)

        while True:
            shell._waiting_for_input = True
            try:
                cmd_line = _read_tty_line(
                    shell.prompt,
                    shell.theme,
                    redraw_fn=lambda buf_s, cur_p: shell._render_shell_viewport(buf_s, cur_p),
                    tick_fn=shell._tick_persistent_clock,
                    clear_fn=_handle_ctrl_l,
                    ctrl_c_fn=_handle_ctrl_c,
                    completer_fn=shell._complete_tty_input,
                    history=shell._raw_cmd_history,
                    allow_ctrl_c_clear=True,
                )
            except KeyboardInterrupt:
                _handle_ctrl_c()
                continue
            except EOFError:
                cmd_line = "EOF"

            shell._waiting_for_input = False
            if cmd_line.strip() == "__simulate_crash__" and os.environ.get("EXAMSHELL_SIMULATE_CRASH") == "1":
                raise RuntimeError("Simulated runtime exception inside STAGE 4/4: EXAM SHELL")
            if shell.onecmd(cmd_line):
                break
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

