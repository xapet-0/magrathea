def resolve_pool_slug(raw_pool: str) -> str:
    key = raw_pool.strip().lower()
    if key in SHORTHAND_POOL_ALIASES:
        return SHORTHAND_POOL_ALIASES[key]
    slug_map_file = KIT_ROOT / "pools" / "official_42_slugs.yml"
    if slug_map_file.exists():
        data = yaml.safe_load(slug_map_file.read_text(encoding="utf-8")) or {}
        aliases = data.get("exams") or data.get("official_exam_slugs") or {}
        if raw_pool in aliases:
            return aliases[raw_pool]
    return raw_pool



DEFAULT_LOGIN = os.environ.get("USER") or os.environ.get("LOGNAME") or "student"


def build_42_header(filename: str, login: str = DEFAULT_LOGIN) -> str:
    now_s = dt.datetime.now().strftime("%Y/%m/%d %H:%M:%S")
    fn_pad = f"{filename[:41]:<41}"
    lg_pad = f"{login[:8]:<8}"
    by_pad = f"By: {login} <{login}@student.1337.ma>"
    by_line = f"/*   {by_pad:<47}+#+  +:+       +#+        */"
    cr_line = f"/*   Created: {now_s} by {lg_pad}          #+#    #+#             */"
    up_line = f"/*   Updated: {now_s} by {lg_pad}         ###   ########.fr       */"
    return "\n".join(
        [
            "/* ************************************************************************** */",
            "/*                                                                            */",
            "/*                                                        :::      ::::::::   */",
            f"/*   {fn_pad}          :+:      :+:    :+:   */",
            "/*                                                    +:+ +:+         +:+     */",
            by_line,
            "/*                                                +#+#+#+#+#+   +#+           */",
            cr_line,
            up_line,
            "/*                                                                            */",
            "/* ************************************************************************** */",
            "",
        ]
    )


def parse_subject_disk_metadata(subject_file: Path) -> Dict[str, str]:
    info = {
        "assignment_name": "Unknown",
        "expected_files": "Unknown",
        "allowed_functions": "None",
        "prototype": "None (Program / Script)",
    }
    if not subject_file.exists():
        return info
    text = subject_file.read_text(encoding="utf-8", errors="replace")
    m_name = re.search(r"^Assignment name[ \t]*:[ \t]*([^\n]*)", text, re.MULTILINE | re.IGNORECASE)
    if m_name and m_name.group(1).strip():
        info["assignment_name"] = m_name.group(1).strip()
    m_files = re.search(r"^(?:Expected files|Files to turn in)[ \t]*:[ \t]*([^\n]*)", text, re.MULTILINE | re.IGNORECASE)
    if m_files and m_files.group(1).strip():
        info["expected_files"] = m_files.group(1).strip()
    m_allow = re.search(r"^Allowed (?:functions|commands)[ \t]*:[ \t]*([^\n]*)", text, re.MULTILINE | re.IGNORECASE)
    if m_allow:
        val = m_allow.group(1).strip()
        info["allowed_functions"] = val if (val and not val.startswith("---")) else "None"
    for line_s in text.splitlines():
        s = line_s.strip()
        if s.endswith(");") and "(" in s and not s.startswith(("$>", "//", "/*", "*")):
            if any(
                s.startswith(t)
                for t in (
                    "int",
                    "void",
                    "char",
                    "unsigned",
                    "size_t",
                    "float",
                    "double",
                    "long",
                    "t_list",
                    "t_btree",
                    "struct",
                )
            ):
                info["prototype"] = " ".join(s.split())
                break
    return info


def render_five_gate_scorecard(report: GradeReport, theme: ThemeEngine, norm_enabled: bool = False) -> str:
    st = report.status
    g1_fail = "Nothing turned in" in st or "main() in function" in st or "Extraneous file" in st
    g2_fail = "Cheating" in st or "Norme error" in st
    g3_fail = st == "Does not compile" or "Makefile" in st
    g4_fail = any(k in st for k in ("Segmentation fault", "Bus error", "Abort", "Floating point", "Timeout", "Output limit", "Redzone KO", "Leak KO", "Free KO", "Strict KO", "Exit 42", "Exit 43"))
    g5_fail = not report.passed and not (g1_fail or g2_fail or g3_fail or g4_fail)

    gates = [
        ("Gate 1", "Turn-in Files & Entry-Point Check (no leftover main)", not g1_fail, g1_fail),
        (
            "Gate 2",
            f"ELF Symbol Whitelist (nm -u){' + 42 Norminette' if norm_enabled else ''}",
            not (g1_fail or g2_fail),
            g2_fail,
        ),
        ("Gate 3", "Strict Compilation (cc -Wall -Wextra -Werror)", not (g1_fail or g2_fail or g3_fail), g3_fail),
        ("Gate 4", "Process Sandbox, 2.0s Timeout & Signal Isolation", not (g1_fail or g2_fail or g3_fail or g4_fail), g4_fail),
        ("Gate 5", "Deepthought Torture Matrix & cat -e Diff Oracle", report.passed, g5_fail),
    ]
    lines = [theme.c("  5-GATE MOULINETTE PIPELINE SCORECARD:", "primary", "bold")]
    stopped = False
    for g_id, g_desc, is_ok, is_fail in gates:
        if stopped:
            badge = theme.c("[SKIP]", "muted")
            desc_s = theme.c(g_desc, "muted")
        elif is_fail:
            badge = theme.c("[FAIL]", "err", "bold")
            desc_s = theme.c(f"{g_desc}  <-- {st}", "err", "bold")
            stopped = True
        elif is_ok:
            badge = theme.c("[PASS]", "ok", "bold")
            desc_s = g_desc
        else:
            badge = theme.c("[SKIP]", "muted")
            desc_s = theme.c(g_desc, "muted")
        lines.append(f"    {badge} {theme.c(g_id, 'accent', 'bold')}: {desc_s}")
    return "\n".join(lines)


class ExamShell(cmd.Cmd):
    def __init__(
        self,
        pool: str,
        level: int | None = None,
        seed: int | None = None,
        practice: bool = False,
        explicit_mode: str | None = None,
        theme_name: str = "42-cluster",
        no_color: bool = False,
        basedir: Path | None = None,
        resume_session: bool = False,
        login: str = DEFAULT_LOGIN,
        clock_fn: Callable[[], dt.datetime] | None = None,
        duration_override: int | None = None,
        defer_init_basedir: bool = False,
    ) -> None:
        super().__init__()
        self._custom_clock = clock_fn is not None
        self.clock_fn: Callable[[], dt.datetime] = clock_fn or default_clock
        self._mono_anchor: float = time.monotonic()
        self._wall_anchor: float = self._raw_clock_dt().timestamp()
        self.raw_pool = pool
        self.pool = resolve_pool_slug(pool)
        self.practice = practice
        self.explicit_mode = explicit_mode
        self.seed = seed
        self.login = login
        self.rng = random.Random(seed)
        self.use_plain = no_color or bool(os.environ.get("NO_COLOR")) or (not sys.stdout.isatty() and os.environ.get("FORCE_COLOR") != "1")
        self.theme = ThemeEngine("plain" if self.use_plain else theme_name)
        self.prompt = self.theme.c("examshell> ", "primary", "bold") if not self.use_plain else "examshell> "
        self.norm_enabled = False
        self.resumed = False
        self.last_exit_code = 0
        self.lifecycle_state = "not_started"
        self._basedir_prepared = False
        self._waiting_for_input = False
        self._ticker_stop = threading.Event()
        self._ticker_thread: threading.Thread | None = None
        self.cmd_history: list[str] = []
        self._raw_cmd_history: list[str] = []
        self.setup_logs: list[str] = []
        self._content_lines: list[str] = []
        self._full_scroll_lines: list[str] = []
        self._full_scroll_title: str = "LAST COMMAND OUTPUT"
        self._footer_notice: str = ""
        self._viewport_active: bool = False
        self._real_stdout = sys.stdout

        pool_file = Path(self.raw_pool) if Path(self.raw_pool).is_file() else (KIT_ROOT / "pools" / "exams" / f"{self.pool}.yml")
        if not pool_file.exists():
            available = sorted(p.stem for p in (KIT_ROOT / "pools" / "exams").glob("*.yml"))
            raise SystemExit(f"Unknown exam pool '{pool}'. Available: {', '.join(available)}")
        self.manifest = yaml.safe_load(pool_file.read_text(encoding="utf-8"))
        self.levels: list[dict] = self.manifest["levels"]

        is_final = "final" in self.pool.lower() or "final" in self.raw_pool.lower()
        raw_dur = duration_override if duration_override is not None else self.manifest.get("duration_seconds", 28800 if is_final else 14400)
        self.duration_sec = validate_duration_seconds(raw_dur, context=f"exam pool '{self.pool}'")

        self.custom_basedir = basedir is not None
        raw_basedir = basedir if basedir is not None else (Path.home() / "exam-basedir")
        validate_safe_basedir(raw_basedir)
        self.exam_basedir = Path(raw_basedir).expanduser()
        self.workspace = KIT_ROOT / "workspace"
        self.rendu_dir = self.exam_basedir / "rendu"
        self.traces_dir = self.exam_basedir / "traces"
        self.subjects_dir = self.exam_basedir / "subjects"
        self.vogsphere_dir = self.exam_basedir / "vogsphere.git"
        self.session_file = self.exam_basedir / ".session.json"

        loaded_state: dict | None = None
        if resume_session and self.session_file.exists():
            try:
                raw_state = json.loads(self.session_file.read_text(encoding="utf-8"))
                if isinstance(raw_state, dict) and "start_ts" in raw_state:
                    loaded_state = raw_state
            except Exception as exc:
                print(f"Warning: Corrupted session file at {self.session_file} ({exc}). Starting fresh session.", file=sys.stderr)
                loaded_state = None

        if loaded_state is not None:
            state = loaded_state
            self.resumed = True
            self._basedir_prepared = True
            saved_practice = bool(state.get("practice", False))
            if self.explicit_mode is None:
                self.practice = saved_practice
            elif (self.explicit_mode == "practice") != saved_practice:
                saved_lbl = "practice" if saved_practice else "real"
                raise SystemExit(
                    f"Error: Cannot resume a '{saved_lbl}' mode session in '{self.explicit_mode}' mode. "
                    f"Use --mode {saved_lbl} or --fresh."
                )
            self.current_idx = max(0, min(len(self.levels) - 1, int(state.get("current_idx", 0))))
            self.grade = int(state.get("grade", 0))
            self.attempts = int(state.get("attempts", 0))
            if "start_at" in state:
                try:
                    dt_start = dt.datetime.fromisoformat(str(state["start_at"]))
                    if dt_start.tzinfo is None:
                        dt_start = dt_start.replace(tzinfo=self._now_dt().tzinfo)
                    self.start_ts = dt_start.timestamp()
                except Exception:
                    self.start_ts = float(state.get("start_ts", self._now_ts()))
            else:
                self.start_ts = float(state.get("start_ts", self._now_ts()))
            self.duration_sec = validate_duration_seconds(state.get("duration_sec", self.duration_sec), context="resumed session")
            self.current_assignment = state.get("current_assignment", "") or self._pick_assignment()
            self.history: list[str] = list(state.get("history", []))
            self.cmd_history = list(state.get("cmd_history", []))
            self.level_records: list[dict] = list(state.get("level_records", []))
            self.norm_enabled = bool(state.get("norm_enabled", False))
            self.cooldown_step = int(state.get("cooldown_step", 30))
            self.cooldown_enabled = bool(state.get("cooldown_enabled", True))
            self.next_grademe_ts = float(state.get("next_grademe_ts", 0.0))
            self.last_penalty_sec = int(state.get("last_penalty_sec", 0))
            saved_lifecycle = str(state.get("lifecycle_state", "running"))
            if saved_lifecycle == "abandoned" and not self._is_expired() and self.grade < 100:
                saved_lifecycle = "running"
            self.lifecycle_state = saved_lifecycle if saved_lifecycle in SESSION_STATES else "running"
            self._refresh_lifecycle_state()
        else:
            if level is not None:
                self.current_idx = max(0, min(len(self.levels) - 1, level))
            else:
                self.current_idx = 0
            self.grade = 0
            self.attempts = 0
            self.start_ts = self._now_ts()
            self.current_assignment = self._pick_assignment()
            self.history = []
            self.cmd_history = []
            self.level_records = []
            self.cooldown_step = 30
            self.cooldown_enabled = True
            self.next_grademe_ts = 0.0
            self.last_penalty_sec = 0
            self.lifecycle_state = "running"
            if not defer_init_basedir:
                self._initialize_fresh_workspace()
        self._raw_cmd_history = [
            re.sub(r"^\[[0-9:]+\]\s*", "", entry).strip()
            for entry in self.cmd_history
            if entry.strip()
        ]
        if self.resumed and not self.setup_logs:
            self._record_setup_logs(resumed=True)
        self._update_prompt()

    def _record_setup_logs(self, resumed: bool = False) -> None:
        """Workspace preparation transcript, worded like docs/exqm.txt Step 2 (local simulation values)."""
        server_now = self._start_dt().strftime("%Y-%m-%d %H:%M:%S")
        tx_id = f"8ed938b3-fe1e-4eb6-b561-{int(self.start_ts) % 1000000000000:012d}"
        clone_lines = (
            ["Your Git repository is already present. Reusing it..."]
            if resumed
            else ["The Git repository is not cloned yet. Cloning...", f"Cloning into '{self.rendu_dir}'..."]
        )
        self.setup_logs = [
            "Selecting project...",
            "Creating required directories...",
            "Ensuring your Git repository for this exam is present and correct...",
            *clone_lines,
            f"vogsphere: (INFO) Transaction ID : {tx_id}",
            "vogsphere: (INFO) Please mention this ID in any ticket you create concerning this transaction",
            f"vogsphere: (INFO) This transaction has been started at {server_now}, server time.",
            "vogsphere: (INFO) Rights will be determined using this time, so do NOT cut the connection.",
            f"vogsphere: (INFO) It appears you are {self.login}. If that's not true, check your Kerberos tickets (klist)",
            "vogsphere: (INFO) You have read and write rights on this repository",
            "",
            f"Your git repository was successfully cloned to {self.rendu_dir}",
            f"Subjects: {self.subjects_dir}  |  Traces: {self.traces_dir}",
        ]

    def _initialize_fresh_workspace(self) -> None:
        if self._basedir_prepared:
            return
        self._prepare_fresh_basedir()
        self._provision_subject_files(self.current_assignment)
        if not self.custom_basedir and os.environ.get("DT_SKIP_HOME_SYMLINKS") != "1":
            rendu_link = Path.home() / "rendu"
            try:
                if rendu_link.is_symlink() or rendu_link.exists():
                    if rendu_link.is_symlink() and rendu_link.resolve() != self.rendu_dir.resolve():
                        rendu_link.unlink()
                        rendu_link.symlink_to(self.rendu_dir)
                else:
                    rendu_link.symlink_to(self.rendu_dir)
            except Exception:
                pass
        self._basedir_prepared = True
        self._record_setup_logs(resumed=False)
        self._save_session()

    def _raw_clock_dt(self) -> dt.datetime:
        now = self.clock_fn()
        if now.tzinfo is None:
            now = now.replace(tzinfo=dt.datetime.now().astimezone().tzinfo)
        return now

    def _now_dt(self) -> dt.datetime:
        if self._custom_clock or os.environ.get("EXAMSHELL_FAKE_NOW", "").strip():
            return self._raw_clock_dt()
        elapsed_mono = max(0.0, time.monotonic() - self._mono_anchor)
        tz = dt.datetime.now().astimezone().tzinfo
        return dt.datetime.fromtimestamp(self._wall_anchor + elapsed_mono, tz=tz)

    def _now_ts(self) -> float:
        return self._now_dt().timestamp()

    def _elapsed_seconds(self) -> int:
        return max(0, int(self._now_ts() - self.start_ts))

    def _start_dt(self) -> dt.datetime:
        tz = self._now_dt().tzinfo
        return dt.datetime.fromtimestamp(self.start_ts, tz=tz)

    def _expires_dt(self) -> dt.datetime:
        tz = self._now_dt().tzinfo
        return dt.datetime.fromtimestamp(self.start_ts + self.duration_sec, tz=tz)

    def _is_expired(self) -> bool:
        return self._now_ts() >= (self.start_ts + self.duration_sec)

    def _refresh_lifecycle_state(self) -> str:
        if self.lifecycle_state in {"passed", "failed", "abandoned"}:
            return self.lifecycle_state
        if self.grade >= 100:
            self.lifecycle_state = "passed"
        elif self._is_expired():
            self.lifecycle_state = "expired"
        elif self.lifecycle_state == "not_started":
            self.lifecycle_state = "running"
        return self.lifecycle_state

    def _update_prompt(self) -> None:
        self.prompt = self.theme.c("examshell> ", "primary", "bold") if not self.use_plain else "examshell> "

    def _build_persistent_status_header(self, cols: int) -> list[str]:
        """Build the 4-row Persistent Status Header fixed at Rows 1..4 of examshell v0.1.1."""
        t = self.theme
        self._refresh_lifecycle_state()
        lvl = self.levels[self.current_idx]
        lvl_num = lvl.get("level", self.current_idx)
        pts = lvl.get("points", round(100 / max(1, len(self.levels))))
        mode_lbl = "PRACTICE / COACHING" if self.practice else "NORMAL EXAM"
        state_lbl = self.lifecycle_state.upper()
        local_clock_str = self._now_dt().strftime("%d/%m/%Y %H:%M:%S")
        rem_hms = self._format_hms()
        ends = self._expires_dt().strftime("%H:%M")

        if cols < 72:
            r1 = f"examshell v0.1.1 | {mode_lbl} | {self.pool} [{state_lbl}]"
            r2 = f"User:{self.login} | Lvl:{lvl_num} | Grade:{self.grade}/100 | {self.current_assignment}"
            r3 = f"Local Clock: {local_clock_str} | Remaining: {rem_hms}"
        else:
            r1 = f"examshell v0.1.1 | Mode: {mode_lbl} | Exam: {self.pool} | State: {state_lbl}"
            r2 = (
                f"Student: {self.login}@1337.MA | Level: {lvl_num} | Grade: {self.grade}/100 "
                f"| Assignment: {self.current_assignment} ({pts} pts)"
            )
            r3 = f"Local Clock: {local_clock_str} | Remaining: {rem_hms} | Ends at {ends}"
        r4 = "=" * max(40, min(80, cols))
        return [
            t.c(clip_visible(r1, cols), "primary", "bold") if not self.use_plain else clip_visible(r1, cols),
            t.c(clip_visible(r2, cols), "secondary", "bold") if not self.use_plain else clip_visible(r2, cols),
            t.c(clip_visible(r3, cols), "warn" if self.practice else "ok", "bold") if not self.use_plain else clip_visible(r3, cols),
            t.c(clip_visible(r4, cols), "border") if not self.use_plain else clip_visible(r4, cols),
        ]

    def _tick_persistent_clock(self) -> None:
        """Update Row 3 and any visible Current local time / You have ... remaining lines in-place using DECSC/DECRC without moving input cursor."""
        if not self._viewport_active or not is_interactive_tty():
            return
        if os.environ.get("EXAMSHELL_LIVE_TICK", "1") == "0":
            return
        try:
            t = self.theme
            cols, rows = t.term_size()
            hdr = self._build_persistent_status_header(cols)
            row3 = hdr[2]
            hms = self._format_hms()
            rem_human = self._format_timer()
            now_dt = self._now_dt()
            local_clock_str = now_dt.strftime("%d/%m/%Y %H:%M:%S %Z").strip()
            el_sec = self._elapsed_seconds()
            eh, em_r = divmod(el_sec, 3600)
            em, es = divmod(em_r, 60)
            elapsed_hms = f"{eh:02d}:{em:02d}:{es:02d}"

            updates = [f"\033]0;examshell | {self.current_assignment} | rem {hms}\007\0337\033[3;1H\033[K{row3}"]
            content_budget = max(3, rows - 6)
            vis_limit = content_budget if len(self._content_lines) <= content_budget else max(1, content_budget - 1)
            for idx, line in enumerate(self._content_lines[:vis_limit]):
                plain = ANSI_ESCAPE_RE.sub("", str(line)).strip()
                screen_row = 5 + idx
                if plain.startswith("Current local time:"):
                    new_ln = clip_visible(f"Current local time: {local_clock_str}  (Elapsed: {elapsed_hms})", cols)
                    self._content_lines[idx] = new_ln
                    updates.append(f"\033[{screen_row};1H\033[K{new_ln}")
                elif plain.startswith("Current local time   :"):
                    new_ln = clip_visible(f"Current local time   : {local_clock_str}", cols)
                    self._content_lines[idx] = new_ln
                    updates.append(f"\033[{screen_row};1H\033[K{new_ln}")
                elif plain.startswith("Elapsed session time :"):
                    new_ln = clip_visible(f"Elapsed session time : {elapsed_hms} ({el_sec}s)", cols)
                    self._content_lines[idx] = new_ln
                    updates.append(f"\033[{screen_row};1H\033[K{new_ln}")
                elif plain.startswith("You have ") and "remaining" in plain:
                    role = "warn" if self._remaining_seconds() < 1800 else "ok"
                    new_ln = clip_visible(f"You have {t.c(rem_human, role, 'bold')} remaining ({hms})", cols)
                    self._content_lines[idx] = new_ln
                    updates.append(f"\033[{screen_row};1H\033[K{new_ln}")
                elif plain.startswith("Remaining exam time  :"):
                    new_ln = clip_visible(f"Remaining exam time  : {rem_human} ({hms})", cols)
                    self._content_lines[idx] = new_ln
                    updates.append(f"\033[{screen_row};1H\033[K{new_ln}")

            updates.append("\0338")
            self._real_stdout.write("".join(updates))
            self._real_stdout.flush()
        except Exception:
            pass

    def _render_shell_viewport(self, current_input: str = "", cursor_pos: int = 0, prompt_override: str | None = None) -> None:
        """Render the complete examshell v0.1.1 viewport fitted strictly to `cols x rows` with prompt directly below content."""
        if not self._viewport_active or not is_interactive_tty():
            return
        t = self.theme
        cols, rows = t.term_size()
        hdr_lines = self._build_persistent_status_header(cols)
        content_budget = max(3, rows - 6)  # Rows 5 .. rows - 2

        raw_content: list[str] = []
        for line in self._content_lines:
            for sub in (str(line).splitlines() or [""]):
                raw_content.append(clip_visible(sub, cols))

        if len(raw_content) <= content_budget:
            fitted_content = raw_content
        else:
            keep = max(1, content_budget - 1)
            more_notice = t.c(
                clip_visible(
                    f"[Showing {keep}/{len(raw_content)} lines — run 'more' or '<cmd> --pager' to scroll full output]",
                    cols,
                ),
                "warn",
                "bold",
            )
            fitted_content = [*raw_content[:keep], more_notice]

        if self._footer_notice:
            footer_raw = self._footer_notice
            self._footer_notice = ""
        elif self.practice:
            footer_raw = "Practice: status | subject | init | check | run | push | grademe | trace | logs | clear | clean | finish"
        else:
            footer_raw = (
                f"{t.muted('Commands:')} {t.accent('status')} | {t.accent('grademe')} | {t.accent('finish')}  "
                f"{t.muted('(type')} {t.accent('tools')} {t.muted('or')} {t.accent('help')} {t.muted('for extra commands)')}"
                if not self.use_plain
                else "Commands: status | grademe | finish  (type 'tools' or 'help' for extra commands)"
            )
        footer_line = clip_visible(footer_raw, cols) if (not self.use_plain and not self._footer_notice and not self.practice) else (t.c(clip_visible(footer_raw, cols), "muted") if not self.use_plain else clip_visible(footer_raw, cols))

        active_prompt = prompt_override if prompt_override is not None else self.prompt
        _write_viewport_frame([*hdr_lines, *fitted_content, footer_line], active_prompt, cols, rows)
        if current_input:
            _draw_bottom_prompt_line(active_prompt, current_input, cursor_pos, cols, rows)

    def _prompt_confirm_line(self, prompt_text: str, extra_lines: Sequence[str] | None = None) -> str:
        return self._prompt_in_viewport(prompt_text, extra_lines=extra_lines)

    def _prompt_in_viewport(self, prompt_text: str, extra_lines: Sequence[str] | None = None) -> str:
        """Prompt for confirmation directly below content while keeping the examshell viewport intact."""
        if not (self._viewport_active and is_interactive_tty()):
            return input(prompt_text)
        if extra_lines is not None:
            self._content_lines = list(extra_lines)
        styled_prompt = self.theme.c(prompt_text, "warn", "bold") if not self.use_plain else prompt_text
        self._render_shell_viewport(prompt_override=styled_prompt)
        return _read_tty_line(
            styled_prompt,
            self.theme,
            redraw_fn=lambda buf, pos: self._render_shell_viewport(buf, pos, prompt_override=styled_prompt),
            tick_fn=self._tick_persistent_clock,
        )

    def _run_pager(self, title: str, lines: Sequence[str]) -> None:
        """Interactive scrollable pager inside the Defined Content Area with dynamic SIGWINCH resize support."""
        expanded: list[str] = []
        for ln in lines:
            expanded.extend(str(ln).splitlines() or [""])
        if not expanded:
            expanded = ["(empty output)"]
        self._full_scroll_title = title
        self._full_scroll_lines = expanded

        if not (self._viewport_active and is_interactive_tty()):
            for ln in expanded:
                print(ln)
            return

        offset = 0
        pager_prompt = (
            self.theme.c("pager (j/k/Space/q)> ", "primary", "bold")
            if not self.use_plain
            else "pager (j/k/Space/q)> "
        )

        def _render_pager_view(cur_buf: str = "", cur_pos: int = 0) -> tuple[int, int]:
            nonlocal offset
            cols, rows = self.theme.term_size()
            hdr_lines = self._build_persistent_status_header(cols)
            page_size = max(3, rows - 6)
            max_offset = max(0, len(expanded) - page_size)
            offset = max(0, min(offset, max_offset))
            chunk = [clip_visible(ln, cols) for ln in expanded[offset : offset + page_size]]
            start_n = offset + 1
            end_n = min(len(expanded), offset + page_size)
            footer_str = (
                f"[PAGER: {title}] Lines {start_n}-{end_n} of {len(expanded)} "
                "| j/Enter/Space=down, k=up, g=top, G=bottom, q=return to examshell>"
            )
            footer_line = (
                self.theme.c(clip_visible(footer_str, cols), "secondary", "bold")
                if not self.use_plain
                else clip_visible(footer_str, cols)
            )
            _write_viewport_frame([*hdr_lines, *chunk, footer_line], pager_prompt, cols, rows)
            if cur_buf:
                _draw_bottom_prompt_line(pager_prompt, cur_buf, cur_pos, cols, rows)
            return page_size, max_offset

        while True:
            page_size, max_offset = _render_pager_view()
            try:
                cmd_in = _read_tty_line(
                    pager_prompt,
                    self.theme,
                    redraw_fn=_render_pager_view,
                    tick_fn=self._tick_persistent_clock,
                ).strip()
            except (EOFError, KeyboardInterrupt):
                break
            low = cmd_in.lower()
            if low in {"q", "quit", "exit", "return"}:
                break
            if low in {"k", "up", "p", "prev", "b"}:
                offset = max(0, offset - max(1, page_size // 2))
            elif low in {"g", "top", "home"}:
                offset = 0
            elif cmd_in == "G" or low in {"bottom", "end"}:
                offset = max_offset
            else:
                offset = min(max_offset, offset + max(1, page_size // 2))
        self._content_lines = expanded
        self._render_shell_viewport()

    def _complete_tty_input(self, buf_str: str, cursor_pos: int) -> tuple[str, int]:
        """Mode-aware Tab completion for `_read_tty_line`."""
        prefix = buf_str[:cursor_pos]
        suffix = buf_str[cursor_pos:]
        stripped_lead = prefix.lstrip()
        if " " not in stripped_lead:
            word = stripped_lead
            matches = sorted(set(self.completenames(word)))
            if len(matches) == 1:
                completed = matches[0] + " "
                return completed + suffix, len(completed)
            if len(matches) > 1:
                common = os.path.commonprefix(matches)
                new_word = common if len(common) > len(word) else word
                self._footer_notice = f"Completions: {', '.join(matches)}"
                self._render_shell_viewport(new_word + suffix, len(new_word))
                return new_word + suffix, len(new_word)
            return buf_str, cursor_pos

        parts = stripped_lead.split(" ", 1)
        cmd_name = parts[0]
        arg_prefix = parts[1] if len(parts) > 1 else ""
        comp_fn = getattr(self, f"complete_{cmd_name}", None)
        if comp_fn is None:
            return buf_str, cursor_pos
        matches = sorted(set(comp_fn(arg_prefix, prefix, len(cmd_name) + 1, cursor_pos)))
        if len(matches) == 1:
            new_prefix = f"{cmd_name} {matches[0]}"
            return new_prefix + suffix, len(new_prefix)
        if len(matches) > 1:
            common = os.path.commonprefix(matches)
            new_arg = common if len(common) > len(arg_prefix) else arg_prefix
            new_prefix = f"{cmd_name} {new_arg}"
            self._footer_notice = f"Completions ({cmd_name}): {', '.join(matches[:12])}"
            self._render_shell_viewport(new_prefix + suffix, len(new_prefix))
            return new_prefix + suffix, len(new_prefix)
        return buf_str, cursor_pos

    def _start_live_ticker(self) -> None:
        return

    def _stop_live_ticker(self) -> None:
        self._waiting_for_input = False

    def precmd(self, line: str) -> str:
        self._waiting_for_input = False
        return line

    def postcmd(self, stop: bool, line: str) -> bool:
        self._update_prompt()
        self._waiting_for_input = not stop
        return stop

    def _prepare_fresh_basedir(self) -> None:
        validate_safe_basedir(self.exam_basedir)
        if self.exam_basedir.exists():
            if self.exam_basedir.is_symlink():
                raise ValueError(f"Unsafe exam-basedir '{self.exam_basedir}': refusing to remove symlink.")
            shutil.rmtree(self.exam_basedir)
        self.exam_basedir.mkdir(parents=True, exist_ok=True)
        self.traces_dir.mkdir(parents=True, exist_ok=True)
        self.subjects_dir.mkdir(parents=True, exist_ok=True)
        init_vogsphere_repo(self.exam_basedir)
        if not self.custom_basedir:
            self.workspace.mkdir(parents=True, exist_ok=True)
            for name, target in [
                ("rendu", self.rendu_dir),
                ("traces", self.traces_dir),
                ("subjects", self.subjects_dir),
                ("vogsphere.git", self.vogsphere_dir),
            ]:
                link = self.workspace / name
                if link.is_symlink() or link.exists():
                    if link.is_symlink() or link.is_file():
                        link.unlink()
                    else:
                        shutil.rmtree(link)
                link.symlink_to(target)

    def _save_session(self, finished: bool = False) -> None:
        self._refresh_lifecycle_state()
        if finished and self.lifecycle_state == "running":
            self.lifecycle_state = "passed" if self.grade >= 100 else "abandoned"
        state = {
            "raw_pool": self.raw_pool,
            "pool": self.pool,
            "current_idx": self.current_idx,
            "grade": self.grade,
            "attempts": self.attempts,
            "start_ts": self.start_ts,
            "start_at": self._start_dt().isoformat(),
            "expires_at": self._expires_dt().isoformat(),
            "duration_sec": self.duration_sec,
            "current_assignment": self.current_assignment,
            "history": self.history,
            "cmd_history": self.cmd_history[-200:],
            "level_records": self.level_records,
            "practice": self.practice,
            "mode": "practice" if self.practice else "real",
            "lifecycle_state": self.lifecycle_state,
            "norm_enabled": self.norm_enabled,
            "cooldown_step": self.cooldown_step,
            "cooldown_enabled": self.cooldown_enabled,
            "next_grademe_ts": self.next_grademe_ts,
            "last_penalty_sec": self.last_penalty_sec,
            "finished": finished or self.lifecycle_state in {"passed", "failed", "abandoned", "expired"},
        }
        self.exam_basedir.mkdir(parents=True, exist_ok=True)
        tmp_file = self.session_file.with_suffix(".json.tmp")
        tmp_file.write_text(json.dumps(state, indent=2), encoding="utf-8")
        os.replace(tmp_file, self.session_file)

    def _reset_cooldown(self) -> None:
        self.next_grademe_ts = 0.0
        self.last_penalty_sec = 0

    def _cooldown_remaining(self) -> int:
        if not self.cooldown_enabled:
            return 0
        rem = self.next_grademe_ts - self._now_ts()
        return max(0, int(round(rem)))

    @staticmethod
    def _format_cooldown_short(sec: int) -> str:
        sec = max(0, int(sec))
        m, s = divmod(sec, 60)
        if m == 0:
            return f"{s}s"
        if s == 0:
            return f"{m}min"
        return f"{m}min {s:02d}s"

    def _format_cooldown_human(self, sec: int) -> str:
        sec = max(0, int(sec))
        m, s = divmod(sec, 60)
        mmss = f"{m:02d}:{s:02d}"
        if m == 0:
            return f"{s} seconds ({mmss})"
        if s == 0:
            unit = "minute" if m == 1 else "minutes"
            return f"{m} {unit} ({mmss} / {sec}s)"
        unit = "minute" if m == 1 else "minutes"
        return f"{m} {unit} {s} seconds ({mmss} / {sec}s)"

    def _pick_assignment(self) -> str:
        lvl = self.levels[self.current_idx]
        raw_list = lvl.get("assignments") or lvl.get("subjects") or lvl.get("exercises") or lvl.get("candidates") or []
        candidates = [c["id"] if isinstance(c, dict) else str(c) for c in raw_list]
        if not candidates:
            return "only_z"
        return self.rng.choice(candidates)

    def _provision_subject_files(self, slug: str) -> Path:
        src_dir = KIT_ROOT / "subjects" / "exams" / slug
        dst_dir = self.subjects_dir / slug
        if dst_dir.exists():
            shutil.rmtree(dst_dir)
        dst_dir.mkdir(parents=True, exist_ok=True)
        subj_txt = src_dir / "subject.en.txt"
        if subj_txt.exists():
            shutil.copy2(subj_txt, dst_dir / "subject.en.txt")
        for h_item in src_dir.glob("*.h"):
            shutil.copy2(h_item, dst_dir / h_item.name)
        return dst_dir / "subject.en.txt"

    def _remaining_seconds(self) -> int:
        elapsed = int(self._now_ts() - self.start_ts)
        return max(0, self.duration_sec - elapsed)

    def _format_timer(self) -> str:
        rem = self._remaining_seconds()
        h, rem_m = divmod(rem, 3600)
        m, s = divmod(rem_m, 60)
        return f"{h} hours, {m} minutes and {s} seconds"

    def _format_hms(self) -> str:
        rem = self._remaining_seconds()
        h, rem_m = divmod(rem, 3600)
        m, s = divmod(rem_m, 60)
        return f"{h:02d}:{m:02d}:{s:02d}"

    def _rule_line(self, ch: str = "=") -> str:
        if not sys.stdout.isatty() and not os.environ.get("COLUMNS"):
            return ch * 80
        cols, _ = self.theme.term_size()
        return ch * max(40, min(88, cols))

    def emptyline(self) -> bool:
        """Do not repeat the previous command on an empty line."""
        self.last_exit_code = 0
        self._update_prompt()
        return False

    def completenames(self, text: str, *ignored) -> List[str]:
        """Filter Tab-completed command names by active mode."""
        names = super().completenames(text, *ignored)
        if not self.practice:
            return [n for n in names if n in NORMAL_MODE_ALLOWLIST]
        return names

    def onecmd(self, line: str) -> bool:
        """Central command dispatcher enforcing quoting, mode boundaries, viewport rendering, and session expiry."""
        self._update_prompt()
        stripped = line.strip()
        if not stripped:
            res_empty = self.emptyline()
            if self._viewport_active:
                self._render_shell_viewport()
            return res_empty

        ts_tag = self._now_dt().strftime("%H:%M:%S")
        if stripped != "EOF":
            self.cmd_history.append(f"[{ts_tag}] {stripped}")
            if not self._raw_cmd_history or self._raw_cmd_history[-1] != stripped:
                self._raw_cmd_history.append(stripped)

        if stripped == "\x0c" or stripped.lower() in {"clear", "cls"}:
            self.do_clear("")
            self.last_exit_code = 0
            return False

        if stripped != "EOF":
            try:
                tokens = shlex.split(stripped)
            except ValueError as exc:
                self.last_exit_code = 2
                err_msg = self.theme.c(f"Error: Malformed command syntax ({exc}).", "err", "bold")
                if self._viewport_active:
                    self._content_lines = [err_msg]
                    self._render_shell_viewport()
                else:
                    print(err_msg)
                return False
            cmd_name = tokens[0] if tokens else ""
            use_pager = "--pager" in tokens
            clean_tokens = [tok for tok in tokens[1:] if tok != "--pager"]
            arg_str = " ".join(shlex.quote(tok) if " " in tok else tok for tok in clean_tokens)
        else:
            cmd_name = "EOF"
            arg_str = ""
            use_pager = False

        if cmd_name == "?":
            cmd_name = "help"

        # 0. Anti-spoiler & hint blocker (applies in both real and practice modes):
        if cmd_name.lower() in {"solve", "solution", "--solve", "--solution", "hint", "--hint"}:
            self.last_exit_code = 2
            msg = self.theme.c(
                f"Error: Command '{cmd_name}' is restricted in normal exam mode. "
                "Reference solutions and hints are strictly locked in ExamShell to preserve the 42 / 1337 peer-learning methodology. "
                "Use 'subject' and debug from the Deepthought trace.",
                "err",
                "bold",
            )
            if self._viewport_active:
                self._content_lines = [msg]
                self._render_shell_viewport()
            else:
                print(msg)
            return False

        # Central Normal-Mode Allowlist Enforcement (Phase 1)
        if not self.practice:
            if cmd_name not in NORMAL_MODE_ALLOWLIST:
                self.last_exit_code = 2
                if cmd_name in SPECIAL_PRACTICE_COMMANDS or hasattr(self, f"do_{cmd_name}"):
                    msg = self.theme.c(
                        f"Error: Command '{cmd_name}' is restricted in normal exam mode. "
                        "Allowed commands: status, subject, grademe, trace, logs, time, history, clear, clean, finish, help.",
                        "err",
                        "bold",
                    )
                else:
                    msg = self.theme.c(
                        f"Error: Unknown command '{cmd_name}'. Type 'help' or 'status' for available actions.",
                        "warn",
                    )
                if self._viewport_active:
                    self._content_lines = [msg]
                    self._render_shell_viewport()
                else:
                    print(msg)
                return False

        rem_cd = self._cooldown_remaining()
        is_prac_cd_bypass = self.practice and (
            cmd_name in {"cooldown", "remove_grade_time", "force_success", "finish"}
            or (cmd_name == "grademe" and any(t.lower() in {"--now", "now", "--skip", "skip", "--no-wait"} for t in clean_tokens))
        )
        if rem_cd > 0 and not is_prac_cd_bypass:
            t = self.theme
            total_pen = max(rem_cd, self.last_penalty_sec or (max(1, self.attempts) * self.cooldown_step))
            lock_msg = t.c(
                f"  ❌ [COOLDOWN LOCKED]: Command '{cmd_name}' refused! You pushed a wrong solution (Attempt #{self.attempts}). "
                f"You MUST wait {self._format_cooldown_human(rem_cd)} until cooldown finishes — no command can run during cooldown!",
                "err",
                "bold",
            )
            print(lock_msg)
            if sys.stdin.isatty() and self._viewport_active:
                while True:
                    left = self._cooldown_remaining()
                    if left <= 0:
                        break
                    try:
                        m, s = divmod(left, 60)
                        pbar = t.progress_bar(total_pen - left, float(total_pen), width=18)
                        sys.stdout.write(f"\r  {t.warn('⏳ Cooldown Lock:')} {pbar} {t.bold(f'{m:02d}:{s:02d}')} remaining (commands locked until 00:00)   ")
                        sys.stdout.flush()
                        time.sleep(1)
                    except KeyboardInterrupt:
                        left_now = self._cooldown_remaining()
                        sys.stdout.write("\n")
                        print(t.c(f"  ❌ [COOLDOWN LOCKED]: Ctrl+C cannot bypass cooldown! {self._format_cooldown_human(left_now)} remaining.", "err", "bold"))
                sys.stdout.write("\r" + (" " * 96) + "\r")
                sys.stdout.flush()
                print(t.c("  ✓ Cooldown expired! You may now enter commands.", "ok", "bold"))
            self.last_exit_code = 1
            return False

        if cmd_name in {"more", "pager"}:
            self.last_exit_code = 0
            self.do_more(arg_str)
            return False

        self.last_exit_code = 0
        dispatch_line = f"{cmd_name} {arg_str}".strip() if cmd_name != "EOF" else "EOF"
        if self._viewport_active and is_interactive_tty():
            cap = io.StringIO()
            with contextlib.redirect_stdout(cap):
                res = super().onecmd(dispatch_line)
            out_text = cap.getvalue().rstrip("\n")
            if out_text:
                lines_out = out_text.splitlines()
                self._content_lines = lines_out
                self._full_scroll_lines = list(lines_out)
                self._full_scroll_title = f"{cmd_name.upper()} OUTPUT"
            if use_pager and self._content_lines:
                self._run_pager(f"{cmd_name.upper()} VIEW", self._content_lines)
            elif not res:
                self._render_shell_viewport()
            self._update_prompt()
            return bool(res)

        res = super().onecmd(dispatch_line)
        self._update_prompt()
        return bool(res)

    def _build_confirmation_screen_lines(self, cols: int, rows: int, notice: str = "") -> list[str]:
        t = self.theme
        w = max(40, min(cols, 80))
        disp_basedir = "~/exam-basedir" if not self.custom_basedir else str(self.exam_basedir)
        mode_lbl = "PRACTICE / COACHING MODE" if self.practice else "NORMAL EXAM MODE"
        dur_h, dur_rem = divmod(self.duration_sec, 3600)
        dur_m, _ = divmod(dur_rem, 60)
        lines: list[str] = [
            t.c("examshell v0.1.1", "primary", "bold"),
            (
                f"Principal: {t.c(f'{self.login}@1337.MA', 'info', 'bold')} | "
                f"Exam: {t.c(self.pool, 'info', 'bold')} ({dur_h:02d}h {dur_m:02d}m, {len(self.levels)} levels) | "
                f"Mode: {t.c(mode_lbl, 'warn' if self.practice else 'ok', 'bold')}"
            ),
            "",
            t.c("WARNING", "warn", "bold"),
            f"Your exam files will be stored in {t.c(disp_basedir, 'info', 'bold')}",
            t.c("THIS DIRECTORY WILL BE ENTIRELY EMPTIED BEFORE YOU START", "warn", "bold"),
            "So, if you do have important things there, Ctrl-C NOW and back them up",
            "before running this.",
        ]
        if notice:
            lines.append(t.c(notice, "err", "bold"))
        budget = max(6, rows - 2)
        if len(lines) > budget:
            lines = lines[:budget]
        return lines

    def print_boot_header(self, show_banner: bool = True) -> None:
        t = self.theme
        disp_basedir = "~/exam-basedir" if not self.custom_basedir else str(self.exam_basedir)

        if is_interactive_tty():
            if not self.resumed:
                notice = ""
                invalid_tries = 0
                prompt_str = t.c("Confirm? [y/n]: ", "warn", "bold") if not self.use_plain else "Confirm? [y/n]: "
                while True:
                    cols, rows = t.term_size()
                    frame_lines = self._build_confirmation_screen_lines(cols, rows, notice=notice)
                    _write_viewport_frame(frame_lines, prompt_str, cols, rows)
                    try:
                        ans = _read_tty_line(
                            prompt_str,
                            t,
                            redraw_fn=lambda b, p: _write_viewport_frame(
                                self._build_confirmation_screen_lines(*t.term_size(), notice=notice),
                                prompt_str,
                                *t.term_size(),
                            ),
                        ).strip().lower()
                    except (EOFError, KeyboardInterrupt):
                        print(f"\n[examshell] Confirmation cancelled. Existing files in {disp_basedir} were left untouched.")
                        raise SystemExit(0)
                    if not ans:
                        continue
                    if ans in {"y", "yes"}:
                        break
                    if ans in {"n", "no", "q", "quit"}:
                        print(f"[examshell] Confirmation declined. Existing files in {disp_basedir} were left untouched.")
                        raise SystemExit(0)
                    invalid_tries += 1
                    if invalid_tries >= 3:
                        print(f"[examshell] Confirmation not granted. Existing files in {disp_basedir} were left untouched.")
                        raise SystemExit(1)
                    notice = f"Please answer 'y' (yes) to empty {disp_basedir} and begin, or 'n' (no) to cancel."
                self._initialize_fresh_workspace()

            # Transition directly into active examshell viewport without intermediate pause or log flood
            self._viewport_active = True
            cap = io.StringIO()
            with contextlib.redirect_stdout(cap):
                self.do_status("")
            self._content_lines = cap.getvalue().rstrip("\n").splitlines()
            self._full_scroll_lines = list(self._content_lines)
            self._full_scroll_title = "STATUS OVERVIEW"
            self._render_shell_viewport()
            return

        # Non-TTY / redirected execution path (zero terminal-control escape sequences)
        if show_banner:
            print(t.startup_banner(version="v0.1.1", mode="practice" if self.practice else "real"))
        print(t.c("examshell v0.1.1", "primary", "bold"))
        print("")
        if self.resumed:
            self.do_status("")
            return

        print(t.c("WARNING", "warn", "bold"))
        print(f"Your exam files will be stored in {t.c(disp_basedir, 'info')}")
        print(t.c("THIS DIRECTORY WILL BE ENTIRELY EMPTIED BEFORE YOU START", "warn"))
        print("So, if you do have important things there, Ctrl-C NOW and back them up before running this.")
        need_confirm = os.environ.get("EXAMSHELL_REQUIRE_CONFIRM") == "1"
        if need_confirm:
            try:
                _ = input("(Press Enter to continue...)").strip()
            except (EOFError, KeyboardInterrupt):
                print(f"\n[examshell] Cancelled before confirmation. Existing files in {disp_basedir} were left untouched.")
                raise SystemExit(0)
            confirmed = False
            for _attempt in range(3):
                try:
                    ans = input("Confirm? [y/n] ").strip().lower()
                except (EOFError, KeyboardInterrupt):
                    print(f"\n[examshell] Confirmation cancelled. Existing files in {disp_basedir} were left untouched.")
                    raise SystemExit(0)
                if ans in {"y", "yes"}:
                    confirmed = True
                    break
                if ans in {"n", "no", "q", "quit"}:
                    print(f"[examshell] Confirmation declined. Existing files in {disp_basedir} were left untouched.")
                    raise SystemExit(0)
                print(f"Please answer 'y' (yes) to empty {disp_basedir} and begin, or 'n' (no) to cancel.")
            if not confirmed:
                print(f"[examshell] Confirmation not granted. Existing files in {disp_basedir} were left untouched.")
                raise SystemExit(1)
        else:
            print("(Press Enter to continue...)")
            print("Confirm? [y/n] y")

        self._initialize_fresh_workspace()
        if not self._viewport_active:
            print("The following commands are available to you:")
            print(f"  {t.accent('status')}: Displays the status of your session, including information about")
            print("    your current assignment, and the exam history.")
            print(f"  {t.accent('grademe')}: Asks the server to grade your current assignment. If you")
            print("    have done it right, you will gain the points of the current assignment, go")
            print("    up a level, and try the next one. If you fail, however, you will stay on")
            print("    the same assignment of the same level to do. So be sure of yourself before")
            print("    you launch this command !")
            print(f"  {t.accent('finish')}: Tell the server you are finished with your exam.")
            print(f"  {t.accent('tools')}:  Display additional helper commands (subject, trace, logs, time, clean...).")
            print("")
            print("You can log out at any time. If this program tells you you earned points,")
            print("then they will be counted as whatever happens.")
            print("")
        self.do_status("")

    def do_status(self, arg: str) -> None:
        """Display the examshell v0.1.1 status block (wording as in docs/exqm.txt, Step 3)."""
        t = self.theme
        self._refresh_lifecycle_state()
        lvl = self.levels[self.current_idx]
        lvl_num = lvl["level"]
        pts = lvl.get("points", round(100 / max(1, len(self.levels))))
        self._provision_subject_files(self.current_assignment)
        end_dt = self._expires_dt().strftime("%d/%m/%Y %H:%M:%S")

        now_dt = self._now_dt()
        local_clock_str = now_dt.strftime("%d/%m/%Y %H:%M:%S %Z").strip()
        end_dt = self._expires_dt().strftime("%d/%m/%Y %H:%M:%S")
        el_sec = self._elapsed_seconds()
        eh, em_r = divmod(el_sec, 3600)
        em, es = divmod(em_r, 60)
        elapsed_hms = f"{eh:02d}:{em:02d}:{es:02d}"

        cols, rows = t.term_size()
        rule = t.c("=" * 80, "border") if cols >= 80 else t.c("=" * max(40, cols), "border")
        # In the full-screen viewport the persistent header already ends with a rule,
        # and on short terminals blank spacer lines are the first thing to go.
        compact = self._viewport_active and rows < 28
        mode_desc = "practice mode (Your grade does not count)" if self.practice else "real mode (Your grade will be counted)"

        if not self._viewport_active:
            print(rule)
        print(f"You are currently at level {t.c(str(lvl_num), 'info')}")
        print(f"You are running in {t.c(mode_desc, 'warn' if self.practice else 'ok')}")
        print(f"Your current grade is {t.c(str(self.grade), 'info')}/100")
        print("Assignments:")
        by_lvl: dict[int, list[dict]] = {}
        for rec in self.level_records:
            by_lvl.setdefault(int(rec["level"]), []).append(rec)
        all_lvls_shown = sorted(set([*by_lvl.keys(), int(lvl_num)]))
        for l_key in (all_lvls_shown[-2:] if compact else all_lvls_shown):
            print(f"  Level {l_key}:")
            for rec in by_lvl.get(l_key, [])[-2:] if compact else by_lvl.get(l_key, []):
                state_lbl = rec["state"]
                state_col = t.c(f"({state_lbl})", "ok" if state_lbl == "Success" else "err", "bold")
                print(f"    {rec['attempt']}: {t.c(rec['slug'], 'info')} for {t.c(str(rec['points']), 'info')} potential points {state_col}")
            if l_key == int(lvl_num) and self.grade < 100:
                print(f"    {self.attempts}: {t.c(self.current_assignment, 'info')} for {t.c(str(pts), 'info')} potential points {t.c('(Current)', 'warn')}")
        if not compact:
            print("")
        print(f"Your current assignment is {t.c(self.current_assignment, 'info')} for {t.c(str(pts), 'info')} potential points")
        print(f"It is assignment {t.c(str(self.attempts), 'info')} for level {t.c(str(lvl_num), 'info')}")
        print(f"The subject is located at: {t.c(f'~/exam-basedir/subjects/{self.current_assignment}', 'info')}")
        print("You must turn in your files in a subdirectory of your Git repository with the")
        print(f"same name as the assignment ({t.c(f'~/exam-basedir/rendu/{self.current_assignment}', 'info')}).")
        print("Of course, you must still push...")
        if not compact:
            print("")
        print(f"Current local time: {local_clock_str}  (Elapsed: {elapsed_hms})")
        print(f"The end date for this exam is: {t.c(end_dt, 'info')}")
        print(f"You have {t.c(self._format_timer(), 'warn' if self._remaining_seconds() < 1800 else 'ok', 'bold')} remaining ({self._format_hms()})")
        if self.lifecycle_state == "expired":
            print(t.status("error", "Time is up. grademe is locked; run 'finish' to close the session."))
            return
        if not compact:
            print(rule)
            print("You can now work on your assignment. When you are sure you're done with it,")
            print(f'push it to vogsphere, and then use the "{t.c("grademe", "info")}" command to be graded.')
            if not self.practice and not self._viewport_active:
                print(
                    f"{t.muted('Commands:')} {t.accent('status')} | {t.accent('grademe')} | {t.accent('finish')}  "
                    f"{t.muted('(type')} {t.accent('tools')} {t.muted('or')} {t.accent('help')} {t.muted('for extra commands)')}"
                )

    def do_logs(self, arg: str) -> None:
        """Display Vogsphere repository initialization and session infrastructure diagnostics (`logs [--pager]`)."""
        t = self.theme
        if not self.setup_logs:
            self._record_setup_logs(resumed=self.resumed)
        for ln in self.setup_logs:
            if ln.startswith("vogsphere: (INFO)"):
                print(t.c("vogsphere: (INFO)", "info") + ln[len("vogsphere: (INFO)"):])
            elif ln.startswith("Your git repository"):
                print(t.c(ln, "ok"))
            else:
                print(t.c(ln, "muted") if ln.endswith("...") else ln)

    def do_diagnostics(self, arg: str) -> None:
        """Alias for `logs`."""
        self.do_logs(arg)

    def do_more(self, arg: str) -> None:
        """Open the interactive scrollable pager for the most recent command output (`more` / `pager`)."""
        if not self._full_scroll_lines:
            print("No previous command output to page. Run 'subject', 'trace', 'logs', or 'status' first.")
            return
        self._run_pager(self._full_scroll_title, self._full_scroll_lines)

    def do_pager(self, arg: str) -> None:
        """Alias for `more`."""
        self.do_more(arg)

    def do_clear(self, arg: str) -> None:
        """Clear previous command output from the Defined Content Area and redraw the current display without altering files or session state."""
        msg = self.theme.c("[Screen cleared — session state, timer, and workspace files preserved.]", "muted")
        self._content_lines = [msg]
        if self._viewport_active and is_interactive_tty():
            self._render_shell_viewport()
        elif not is_interactive_tty():
            print(msg)

    def do_cls(self, arg: str) -> None:
        """Alias for `clear`."""
        self.do_clear(arg)

    def do_clean(self, arg: str) -> None:
        """Safely remove explicitly defined disposable build/editor artifacts inside rendu/ without touching student source or data files."""
        t = self.theme
        validate_safe_basedir(self.exam_basedir)
        if not self.rendu_dir.exists():
            print(t.c(f"[clean] Turn-in directory '{self.rendu_dir}' does not exist yet (0 artifacts removed).", "muted"))
            return
        if self.rendu_dir.is_symlink():
            self.last_exit_code = 1
            print(t.c(f"Error: Refusing to clean symlinked rendu directory '{self.rendu_dir}'.", "err", "bold"))
            return

        rendu_resolved = self.rendu_dir.resolve()
        dry_run = "--dry-run" in arg.split()
        artifact_names = {"a.out", "core", ".DS_Store", ".gdb_history", "user_bin", "ref_bin", "user_run"}
        artifact_suffixes = {".o", ".obj", ".gch", ".swp", ".swo"}
        protected_suffixes = {".c", ".h", ".cpp", ".hpp", ".sh", ".py", ".txt", ".md", ".yml", ".json", ".out", ".tmp", ".in", ".dat"}

        removed: list[str] = []
        for cand in sorted(self.rendu_dir.rglob("*")):
            if ".git" in cand.parts:
                continue
            if cand.is_symlink() or not cand.is_file():
                continue
            try:
                cand_resolved = cand.resolve()
                cand_resolved.relative_to(rendu_resolved)
            except Exception:
                continue
            if cand.name == "Makefile" or (cand.suffix.lower() in protected_suffixes and cand.name not in artifact_names):
                continue
            is_artifact = (
                cand.name in artifact_names
                or cand.suffix.lower() in artifact_suffixes
                or cand.name.endswith("~")
            )
            if is_artifact:
                rel = str(cand.relative_to(self.rendu_dir))
                if not dry_run:
                    cand.unlink(missing_ok=True)
                removed.append(rel)

        prefix = "[clean --dry-run]" if dry_run else "[clean]"
        if removed:
            print(t.c(f"{prefix} Removed {len(removed)} generated artifact(s) from {self.rendu_dir}: {', '.join(removed)}", "ok", "bold"))
        else:
            print(t.c(f"{prefix} 0 generated artifacts found in {self.rendu_dir}. Student source files and session state untouched.", "ok"))

    def do_time(self, arg: str) -> None:
        """Display current local clock, exam start/end timestamps, elapsed duration, and remaining countdown."""
        t = self.theme
        self._refresh_lifecycle_state()
        now_dt = self._now_dt()
        start_dt = self._start_dt()
        end_dt = self._expires_dt()
        el_sec = self._elapsed_seconds()
        eh, em_r = divmod(el_sec, 3600)
        em, es = divmod(em_r, 60)
        rule = self._rule_line("-")
        print(rule)
        print(f"Current local time   : {now_dt.strftime('%d/%m/%Y %H:%M:%S %Z').strip()}")
        print(f"Exam start time      : {start_dt.strftime('%d/%m/%Y %H:%M:%S')}")
        print(f"The end date for exam: {end_dt.strftime('%d/%m/%Y %H:%M:%S')}")
        print(f"Elapsed session time : {eh:02d}:{em:02d}:{es:02d} ({el_sec}s)")
        print(f"Remaining exam time  : {self._format_timer()} ({self._format_hms()})")
        print(f"Session state        : {t.c(self.lifecycle_state.upper(), 'info', 'bold')}")
        print(rule)

    def do_history(self, arg: str) -> None:
        """Display session command history and grading attempt history."""
        t = self.theme
        rule = self._rule_line("-")
        print(rule)
        print(t.c("SESSION COMMAND & GRADING HISTORY", "primary", "bold"))
        print("Command Log:")
        if self.cmd_history:
            for idx, entry in enumerate(self.cmd_history[-25:], 1):
                print(f"  {idx:>2}. {entry}")
        else:
            print("  (no commands recorded yet)")
        print("Grading Attempts:")
        if self.history:
            for idx, item in enumerate(self.history, 1):
                print(f"  {idx:>2}. {item}")
        else:
            print("  (no grading attempts recorded yet)")
        print(rule)

    def default(self, line: str) -> None:
        """Intercept clear/cls/Ctrl+L and unknown commands gracefully."""
        cmd_lower = line.strip().lower()
        if cmd_lower in {"clear", "cls"} or line.strip() == "\x0c":
            self.do_clear("")
            self.last_exit_code = 0
            return
        self.last_exit_code = 2
        t = self.theme
        print(t.c(f"  Error: Unknown command: {line!r}. Type 'help' or 'status' to see available commands.", "warn"))

    def do_subject(self, arg: str) -> None:
        """Display the current assignment's subject.en.txt with syntax & header highlighting (`subject [--full|--raw]`)."""
        subj_file = self.subjects_dir / self.current_assignment / "subject.en.txt"
        if not subj_file.exists():
            subj_file = self._provision_subject_files(self.current_assignment)
        raw_text = subj_file.read_text(encoding="utf-8", errors="replace")
        flags = arg.strip().lower().split()
        if "--raw" in flags or "raw" in flags or not self.theme.enabled:
            print(raw_text)
            return
        full_flag = "--full" in flags or "full" in flags or "all" in flags
        print(self.theme.render_subject(raw_text, subject_id=self.current_assignment, full=full_flag))

    def do_sub(self, arg: str) -> None:
        """Alias for `subject`."""
        self.do_subject(arg)

    def _scaffold_current_assignment(self) -> Path:
        t = self.theme
        subj_file = self._provision_subject_files(self.current_assignment)
        disk_meta = parse_subject_disk_metadata(subj_file)
        meta_path = KIT_ROOT / "subjects" / "exams" / self.current_assignment / "meta.yml"
        meta = yaml.safe_load(meta_path.read_text(encoding="utf-8")) if meta_path.exists() else {}

        exp_files = meta.get("expected_files") or [
            f.strip() for f in disk_meta["expected_files"].split(",") if f.strip() and f.strip() != "Unknown"
        ]
        if not exp_files:
            exp_files = [f"{self.current_assignment}.c"]

        assign_dir = self.rendu_dir / self.current_assignment
        assign_dir.mkdir(parents=True, exist_ok=True)

        # Copy any helper headers (e.g. ft_list.h) provided by the subject folder
        src_subj_dir = KIT_ROOT / "subjects" / "exams" / self.current_assignment
        for hf in src_subj_dir.glob("*.h"):
            dest_h = assign_dir / hf.name
            if not dest_h.exists():
                shutil.copy2(hf, dest_h)

        primary_file = assign_dir / exp_files[0]
        for fname in exp_files:
            if "*" in fname:
                continue
            fpath = assign_dir / fname
            if fpath.exists():
                print(t.c(f"[init] File already exists (preserved): {fpath}", "warn"))
                continue
            fpath.parent.mkdir(parents=True, exist_ok=True)
            if fname.endswith(".sh"):
                fpath.write_text("#!/bin/sh\n\n", encoding="utf-8")
                os.chmod(fpath, 0o755)
            elif fname.endswith(".h"):
                guard = re.sub(r"[^A-Za-z0-9]", "_", fname).upper()
                fpath.write_text(
                    build_42_header(fname, self.login) + f"#ifndef {guard}\n# define {guard}\n\n#endif\n",
                    encoding="utf-8",
                )
            elif fname.endswith(".c"):
                hdr = build_42_header(fname, self.login)
                allowed = str(disk_meta.get("allowed_functions", ""))
                includes: list[str] = []
                if any(fn in allowed for fn in ("write", "read", "close", "fork", "pipe", "dup2", "execve")):
                    includes.append("#include <unistd.h>")
                if any(fn in allowed for fn in ("malloc", "free", "exit", "atoi")):
                    includes.append("#include <stdlib.h>")
                if any(fn in allowed for fn in ("printf", "fopen", "getline", "perror")):
                    includes.append("#include <stdio.h>")
                if any(fn in allowed for fn in ("open",)):
                    includes.append("#include <fcntl.h>")
                inc_block = ("\n".join(includes) + "\n\n") if includes else ""
                proto = disk_meta.get("prototype", "")
                stype = meta.get("type", "")
                if stype == "c_function" or (proto and not proto.startswith("None") and "main(" not in proto):
                    sig = proto.rstrip(";")
                    body = f"{sig}\n{{\n\t/* TODO: implement {self.current_assignment} */\n}}\n"
                else:
                    body = "int\tmain(int argc, char **argv)\n{\n\t(void)argc;\n\t(void)argv;\n\treturn (0);\n}\n"
                fpath.write_text(hdr + inc_block + body, encoding="utf-8")
            print(t.c(f"[init] Created starter file: {fpath}", "ok", "bold"))

        print(t.c(f"[init] Turn-in directory ready: {assign_dir}", "primary"))
        return primary_file

    def do_init(self, arg: str) -> None:
        """Create turn-in folder `rendu/<assignment>/` and generate starter files with 42 header & prototype."""
        self._scaffold_current_assignment()

    def do_scaffold(self, arg: str) -> None:
        """Alias for `init`."""
        self._scaffold_current_assignment()

    def do_edit(self, arg: str) -> None:
        """Scaffold (if needed) and open the current assignment's source file in your editor ($EDITOR / vim / code / nano)."""
        t = self.theme
        assign_dir = self.rendu_dir / self.current_assignment
        c_files = sorted(assign_dir.glob("*.c")) if assign_dir.exists() else []
        target_file = c_files[0] if c_files else self._scaffold_current_assignment()
        editor = arg.strip() or os.environ.get("EDITOR") or ("vim" if shutil.which("vim") else "nano")
        cmd = [*shlex.split(editor), str(target_file)]
        print(t.c(f"[edit] Opening {' '.join(cmd)} ...", "accent"))
        try:
            subprocess.call(cmd)
        except Exception as exc:
            print(t.c(f"[edit] Could not launch editor '{editor}': {exc}", "err"))
        finally:
            if self._viewport_active and is_interactive_tty():
                self._real_stdout.write("\033[?1049h\033[?25h\033[H\033[2J")
                self._real_stdout.flush()

    def do_vim(self, arg: str) -> None:
        """Open current assignment in vim."""
        self.do_edit("vim")

    def do_nano(self, arg: str) -> None:
        """Open current assignment in nano."""
        self.do_edit("nano")

    def do_code(self, arg: str) -> None:
        """Open current assignment in VS Code (`code`)."""
        self.do_edit("code")

    def do_check(self, arg: str) -> None:
        if not self.practice:
            t = self.theme
            print(t.c("  [examshell] 'check' is only available in practice mode (--mode practice).", "warn"))
            return
        """[Pre-Flight Check] Run the 5-Gate Moulinette pipeline on local `rendu/<assignment>` WITHOUT using a grademe attempt!"""
        t = self.theme
        local_dir = self.rendu_dir / self.current_assignment
        print(t.c(f"=== PRE-FLIGHT CHECK (Zero Penalty): {self.current_assignment} ===", "primary", "bold"))
        if not local_dir.exists() or not any(local_dir.iterdir()):
            print(t.c(f"Turn-in directory is empty: {local_dir}", "err", "bold"))
            print(t.c("Tip: Run `init` or `edit` first to create your starter file!", "accent"))
            return
        res = grade_subject(
            KIT_ROOT,
            f"exams/{self.current_assignment}",
            local_dir,
            is_exam=True,
            strict=False,
            enforce_norm=self.norm_enabled,
        )
        print(render_five_gate_scorecard(res, t, norm_enabled=self.norm_enabled))
        if res.passed:
            print(t.c(f"\n[PRE-FLIGHT OK] All 5 Gates PASSED! Run `grademe` now to claim your points!", "ok", "bold"))
        else:
            print(t.c(f"\n[PRE-FLIGHT KO] Status: {res.status}", "err", "bold"))
            summary = res.format_exam_trace_summary()
            if summary:
                print(summary)
            else:
                tail_lines = "\n".join(res.trace.splitlines()[-15:])
                print(tail_lines)

    def do_test(self, arg: str) -> None:
        """Alias for `check` (runs local 5-Gate pre-flight check without penalty)."""
        self.do_check(arg)

    def do_list(self, arg: str) -> None:
        """List all levels and candidate exercises in the current exam pool."""
        t = self.theme
        print(t.c("=" * 80, "border"))
        print(t.c(f"  EXAM POOL LEVELS & CANDIDATES: {self.pool}", "primary", "bold"))
        print(t.c("-" * 80, "border"))
        for idx, lvl in enumerate(self.levels):
            lnum = lvl.get("level", idx)
            pts = lvl.get("points", round(100 / max(1, len(self.levels))))
            raw_c = lvl.get("candidates") or lvl.get("subjects") or lvl.get("assignments") or []
            c_names = [c["id"] if isinstance(c, dict) else str(c) for c in raw_c]
            marker = t.c(">>", "ok", "bold") if idx == self.current_idx else "  "
            formatted_c = [
                t.c(f"[{c}]", "ok", "bold") if (idx == self.current_idx and c == self.current_assignment) else c
                for c in c_names
            ]
            print(f"{marker} Level {lnum:<2} ({pts:>2} pts): {', '.join(formatted_c)}")
        print(t.c("-" * 80, "border"))
        print(t.c("Tip: Use `assign <slug>`, `level <N>`, or `reroll` to switch exercises.", "muted"))
        print(t.c("=" * 80, "border"))

    def do_level(self, arg: str) -> None:
        """Jump directly to a specific level number (`level 0` .. `level N`)."""
        raw = arg.strip()
        if not raw.isdigit():
            print(f"Usage: level <0..{len(self.levels) - 1}>")
            return
        target_lvl = int(raw)
        for idx, lvl in enumerate(self.levels):
            if int(lvl.get("level", idx)) == target_lvl or idx == target_lvl:
                self.current_idx = idx
                self.attempts = 0
                self._reset_cooldown()
                self.current_assignment = self._pick_assignment()
                self._provision_subject_files(self.current_assignment)
                self._save_session()
                print(self.theme.c(f"Switched to Level {lvl.get('level', idx)}: {self.current_assignment}", "ok", "bold"))
                self.do_status("")
                return
        print(f"Level {target_lvl} not found (valid range: 0..{len(self.levels) - 1}).")

    def do_reroll(self, arg: str) -> None:
        """Draw a different random exercise from the current level."""
        lvl = self.levels[self.current_idx]
        raw_list = lvl.get("assignments") or lvl.get("subjects") or lvl.get("exercises") or lvl.get("candidates") or []
        candidates = [c["id"] if isinstance(c, dict) else str(c) for c in raw_list]
        others = [c for c in candidates if c != self.current_assignment]
        self.current_assignment = random.choice(others) if others else self._pick_assignment()
        self.attempts = 0
        self._reset_cooldown()
        self._provision_subject_files(self.current_assignment)
        self._save_session()
        print(self.theme.c(f"Rerolled Level {lvl['level']} assignment -> {self.current_assignment}", "ok", "bold"))
        self.do_status("")

    def do_next(self, arg: str) -> None:
        """Alias for `reroll`."""
        self.do_reroll(arg)

    def do_theme(self, arg: str) -> None:
        """Switch color theme live (`theme 42-cluster | jcluzet-exam | tokyo-night | gruvbox | plain`)."""
        name = arg.strip().lower()
        if name == "plain":
            self.theme = ThemeEngine("plain")
            self.prompt = "examshell> "
            print("Theme set to: plain")
            return
        if self.theme.set_theme(name):
            self.theme.enabled = True
            self.prompt = self.theme.c("examshell> ", "primary", "bold")
            print(self.theme.c(f"Theme switched to '{name}'!", "ok", "bold"))
        else:
            print(f"Available themes: {', '.join(sorted(PALETTES))} | plain")

    def do_enable(self, arg: str) -> None:
        """Enable optional features such as 42 Norminette enforcement (`enable norm`)."""
        if arg.strip().lower() in {"norm", "norminette"}:
            self.norm_enabled = True
            self._save_session()
            print(self.theme.c("[Norminette Gate] 42 Norm v3/v4 enforcement ENABLED for grademe.", "ok", "bold"))
        else:
            print("Usage: enable norm")

    def do_disable(self, arg: str) -> None:
        """Disable optional features such as 42 Norminette enforcement (`disable norm`)."""
        if arg.strip().lower() in {"norm", "norminette"}:
            self.norm_enabled = False
            self._save_session()
            print(self.theme.c("[Norminette Gate] 42 Norm v3/v4 enforcement DISABLED (default exam mode).", "warn", "bold"))
        else:
            print("Usage: disable norm")

    def do_norm(self, arg: str) -> None:
        """Toggle or set 42 Norminette gate (`norm on` / `norm off`)."""
        sub = arg.strip().lower()
        if sub in {"on", "enable", "1", "true"}:
            self.do_enable("norm")
        elif sub in {"off", "disable", "0", "false"}:
            self.do_disable("norm")
        else:
            if self.norm_enabled:
                self.do_disable("norm")
            else:
                self.do_enable("norm")

    def do_push(self, arg: str) -> None:
        """Stage, commit, and push files in rendu/ to the local Vogsphere Git repository."""
        t = self.theme
        if not self.rendu_dir.exists():
            print(t.c(f"Turn-in directory {self.rendu_dir} does not exist!", "err"))
            return
        subprocess.run(["git", "add", "-A"], cwd=self.rendu_dir, capture_output=True)
        subprocess.run(
            [
                "git",
                "-c", f"user.name={self.login}",
                "-c", f"user.email={self.login}@student.1337.ma",
                "commit",
                "-m",
                f"Submit {self.current_assignment}",
            ],
            cwd=self.rendu_dir,
            capture_output=True,
        )
        p_push = subprocess.run(["git", "push", "origin", "master"], cwd=self.rendu_dir, capture_output=True, text=True)
        if p_push.returncode != 0:
            p_push = subprocess.run(["git", "push", "-u", "origin", "HEAD:master"], cwd=self.rendu_dir, capture_output=True, text=True)
        if p_push.returncode == 0:
            print(t.c(f"[Vogsphere] Successfully pushed '{self.current_assignment}' from {self.rendu_dir}!", "ok", "bold"))
        else:
            print(t.c(f"[Vogsphere] Push warning: {p_push.stderr.strip()}", "warn"))

    def _apply_reference_solution(self) -> None:
