def validate_safe_basedir(basedir: Path | str) -> Path:
    """Validate that an exam-basedir path is safe to initialize or clean.

    Rejects empty paths, '.', '..', filesystem root '/', $HOME, KIT_ROOT,
    ancestors of $HOME or KIT_ROOT, system directories, and symlinks pointing
    to forbidden paths.
    """
    raw_str = str(basedir).strip() if basedir is not None else ""
    if not raw_str or raw_str in {".", ".."}:
        raise ValueError(f"Unsafe exam-basedir {raw_str!r}: path cannot be empty or relative '.'/'..'.")
    expanded = Path(raw_str).expanduser()
    if expanded.is_symlink():
        raise ValueError(f"Unsafe exam-basedir '{expanded}': refusing to use or wipe a symlinked basedir.")
    resolved = expanded.resolve(strict=False)
    home_resolved = Path.home().resolve(strict=False)
    kit_resolved = KIT_ROOT.resolve(strict=False)

    forbidden_exact = {
        Path("/"),
        home_resolved,
        kit_resolved,
        Path("/bin"),
        Path("/sbin"),
        Path("/usr"),
        Path("/etc"),
        Path("/var"),
        Path("/lib"),
        Path("/lib64"),
        Path("/opt"),
        Path("/dev"),
        Path("/proc"),
        Path("/sys"),
        Path("/root"),
        Path("/boot"),
        Path("/run"),
        Path("/tmp"),
    }
    if resolved in forbidden_exact:
        raise ValueError(f"Unsafe exam-basedir '{resolved}': refusing to use protected directory.")
    if resolved in home_resolved.parents or resolved in kit_resolved.parents:
        raise ValueError(f"Unsafe exam-basedir '{resolved}': path is an ancestor of $HOME or repository root.")
    allowed_kit_tmp_roots = (
        (kit_resolved / "build" / "test-homes").resolve(strict=False),
        (kit_resolved / "workspace" / ".tmp_exec").resolve(strict=False),
    )
    if kit_resolved in resolved.parents and not any(r in resolved.parents for r in allowed_kit_tmp_roots):
        raise ValueError(f"Unsafe exam-basedir '{resolved}': basedir cannot be inside the repository tree '{kit_resolved}'.")
    return resolved


def default_clock() -> dt.datetime:
    """Return timezone-aware local datetime, honoring EXAMSHELL_FAKE_NOW for deterministic tests."""
    fake = os.environ.get("EXAMSHELL_FAKE_NOW", "").strip()
    if fake:
        try:
            if fake.replace(".", "", 1).lstrip("-").isdigit():
                return dt.datetime.fromtimestamp(float(fake), tz=dt.timezone.utc).astimezone()
            parsed = dt.datetime.fromisoformat(fake)
            if parsed.tzinfo is None:
                parsed = parsed.replace(tzinfo=dt.datetime.now().astimezone().tzinfo)
            return parsed
        except Exception:
            pass
    return dt.datetime.now().astimezone()


_TTY_RX_BUF = bytearray()
_WINCH_PENDING = False
_ACTIVE_PROMPT_ROW = 1
_REAL_STDOUT = sys.__stdout__ if sys.__stdout__ is not None else sys.stdout


def _on_sigwinch(signum: int, frame: Any) -> None:
    global _WINCH_PENDING
    _WINCH_PENDING = True


def is_interactive_tty() -> bool:
    return bool(sys.stdin.isatty() and _REAL_STDOUT.isatty())


def _write_viewport_frame(lines: Sequence[str], prompt: str, cols: int, rows: int) -> int:
    """Render lines + prompt without blank-line padding and record the active prompt row."""
    global _ACTIVE_PROMPT_ROW
    safe_rows = max(10, rows)
    body_budget = safe_rows - 1
    fitted_count = min(len(lines), body_budget)
    _ACTIVE_PROMPT_ROW = min(safe_rows, fitted_count + 1)
    frame_str = render_viewport_frame(lines, prompt, cols, rows)
    _REAL_STDOUT.write(frame_str)
    _REAL_STDOUT.flush()
    return _ACTIVE_PROMPT_ROW


class TerminalSessionGuard:
    """Context manager managing alternate-screen lifecycle, termios restoration, cursor state, and SIGWINCH."""

    def __init__(self) -> None:
        self.active = is_interactive_tty()
        self.fd: int | None = None
        self.orig_termios: list[Any] | None = None
        self.prev_winch: Any = None

    def __enter__(self) -> "TerminalSessionGuard":
        if not self.active:
            return self
        try:
            self.fd = sys.stdin.fileno()
            self.orig_termios = termios.tcgetattr(self.fd)
        except Exception:
            self.fd = None
            self.orig_termios = None
        try:
            self.prev_winch = signal.getsignal(signal.SIGWINCH)
            signal.signal(signal.SIGWINCH, _on_sigwinch)
        except Exception:
            self.prev_winch = None
        # Enter alternate screen buffer (\033[?1049h) so pre-existing terminal scrollback is never touched
        _REAL_STDOUT.write("\033[?1049h\033[?25h\033[H\033[2J")
        _REAL_STDOUT.flush()
        return self

    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> bool:
        if not self.active:
            return False
        if self.fd is not None and self.orig_termios is not None:
            try:
                termios.tcsetattr(self.fd, termios.TCSADRAIN, self.orig_termios)
            except Exception:
                pass
        if self.prev_winch is not None:
            try:
                signal.signal(signal.SIGWINCH, self.prev_winch)
            except Exception:
                pass
        try:
            _REAL_STDOUT.write("\033[r\033[0m\033[?25h\033[?1049l\033]0;\007")
            _REAL_STDOUT.flush()
        except Exception:
            pass
        return False


def _read_next_tty_byte(fd: int, timeout_s: float = 0.15) -> int | None:
    """Return the next byte from _TTY_RX_BUF or fd within timeout_s."""
    if _TTY_RX_BUF:
        return _TTY_RX_BUF.pop(0)
    try:
        rlist, _, _ = select.select([fd], [], [], timeout_s)
    except InterruptedError:
        return None
    if not rlist:
        return None
    try:
        chunk = os.read(fd, 1024)
    except (OSError, InterruptedError):
        return None
    if not chunk:
        return -1
    _TTY_RX_BUF.extend(chunk)
    return _TTY_RX_BUF.pop(0)


def _draw_bottom_prompt_line(prompt: str, buf_str: str, cursor_pos: int, cols: int, rows: int) -> None:
    safe_cols = max(40, cols)
    safe_rows = max(10, rows)
    prompt_row = min(safe_rows, max(1, _ACTIVE_PROMPT_ROW))
    p_clip = clip_visible(prompt, max(1, safe_cols - 2))
    p_vlen = visible_len(p_clip)
    avail = max(1, safe_cols - p_vlen - 1)
    if len(buf_str) <= avail:
        vis_buf = buf_str
        cur_offset = cursor_pos
    else:
        start = max(0, cursor_pos - avail + 1)
        vis_buf = buf_str[start : start + avail]
        cur_offset = cursor_pos - start
    target_col = min(safe_cols, p_vlen + cur_offset + 1)
    _REAL_STDOUT.write(f"\033[{prompt_row};1H\033[K{p_clip}{vis_buf}\033[{prompt_row};{target_col}H")
    _REAL_STDOUT.flush()


def _read_tty_line(
    prompt: str,
    theme: ThemeEngine,
    redraw_fn: Callable[[str, int], None] | None = None,
    tick_fn: Callable[[], None] | None = None,
    clear_fn: Callable[[str, int], None] | None = None,
    ctrl_c_fn: Callable[[], None] | None = None,
    completer_fn: Callable[[str, int], tuple[str, int]] | None = None,
    history: list[str] | None = None,
    allow_ctrl_c_clear: bool = False,
) -> str:
    """Read a line in interactive TTY mode with line editing, history, Tab completion, SIGWINCH redraw, and live clock tick."""
    global _WINCH_PENDING
    if not is_interactive_tty():
        sys.stdout.write(prompt)
        sys.stdout.flush()
        line = sys.stdin.readline()
        if not line:
            raise EOFError
        return line.rstrip("\r\n")

    fd = sys.stdin.fileno()
    old_attrs = termios.tcgetattr(fd)
    new_attrs = list(old_attrs)
    new_attrs[3] = new_attrs[3] & ~(termios.ICANON | termios.ECHO | termios.ISIG)
    new_attrs[6] = list(old_attrs[6])
    new_attrs[6][termios.VMIN] = 1
    new_attrs[6][termios.VTIME] = 0

    buf: list[str] = []
    cursor_pos = 0
    hist_list = list(history) if history else []
    hist_idx = len(hist_list)
    saved_draft = ""
    last_tick = time.monotonic()

    cols, rows = theme.term_size()
    _draw_bottom_prompt_line(prompt, "", 0, cols, rows)

    try:
        termios.tcsetattr(fd, termios.TCSADRAIN, new_attrs)
        while True:
            if _WINCH_PENDING:
                _WINCH_PENDING = False
                cols, rows = theme.term_size()
                if redraw_fn is not None:
                    redraw_fn("".join(buf), cursor_pos)
                _draw_bottom_prompt_line(prompt, "".join(buf), cursor_pos, cols, rows)

            now_m = time.monotonic()
            if tick_fn is not None and (now_m - last_tick) >= 0.85:
                last_tick = now_m
                tick_fn()

            b = _read_next_tty_byte(fd, timeout_s=0.12)
            if b is None:
                continue
            if b == -1:
                if not buf:
                    if allow_ctrl_c_clear:
                        return "EOF"
                    raise EOFError
                return "".join(buf)

            if b in (10, 13):  # \n or \r
                if b == 13 and _TTY_RX_BUF and _TTY_RX_BUF[0] == 10:
                    _TTY_RX_BUF.pop(0)
                return "".join(buf)

            if b == 3:  # Ctrl+C
                if allow_ctrl_c_clear:
                    buf.clear()
                    cursor_pos = 0
                    if ctrl_c_fn is not None:
                        ctrl_c_fn()
                    cols, rows = theme.term_size()
                    _draw_bottom_prompt_line(prompt, "", 0, cols, rows)
                    continue
                raise KeyboardInterrupt

            if b == 4:  # Ctrl+D
                if not buf:
                    if allow_ctrl_c_clear:
                        return "EOF"
                    raise EOFError
                if cursor_pos < len(buf):
                    buf.pop(cursor_pos)
                    cols, rows = theme.term_size()
                    _draw_bottom_prompt_line(prompt, "".join(buf), cursor_pos, cols, rows)
                continue

            if b == 12:  # Ctrl+L
                cols, rows = theme.term_size()
                if clear_fn is not None:
                    clear_fn("".join(buf), cursor_pos)
                elif redraw_fn is not None:
                    redraw_fn("".join(buf), cursor_pos)
                _draw_bottom_prompt_line(prompt, "".join(buf), cursor_pos, cols, rows)
                continue

            if b in (127, 8):  # Backspace
                if cursor_pos > 0:
                    buf.pop(cursor_pos - 1)
                    cursor_pos -= 1
                    cols, rows = theme.term_size()
                    _draw_bottom_prompt_line(prompt, "".join(buf), cursor_pos, cols, rows)
                continue

            if b == 9:  # Tab
                if completer_fn is not None:
                    new_s, new_pos = completer_fn("".join(buf), cursor_pos)
                    buf = list(new_s)
                    cursor_pos = new_pos
                    cols, rows = theme.term_size()
                    _draw_bottom_prompt_line(prompt, "".join(buf), cursor_pos, cols, rows)
                continue

            if b == 27:  # ESC sequence
                b1 = _read_next_tty_byte(fd, timeout_s=0.03)
                if b1 in (ord("["), ord("O")):
                    b2 = _read_next_tty_byte(fd, timeout_s=0.03)
                    if b2 == ord("A"):  # Up arrow
                        if hist_list and hist_idx > 0:
                            if hist_idx == len(hist_list):
                                saved_draft = "".join(buf)
                            hist_idx -= 1
                            buf = list(hist_list[hist_idx])
                            cursor_pos = len(buf)
                            cols, rows = theme.term_size()
                            _draw_bottom_prompt_line(prompt, "".join(buf), cursor_pos, cols, rows)
                    elif b2 == ord("B"):  # Down arrow
                        if hist_idx < len(hist_list):
                            hist_idx += 1
                            new_val = saved_draft if hist_idx == len(hist_list) else hist_list[hist_idx]
                            buf = list(new_val)
                            cursor_pos = len(buf)
                            cols, rows = theme.term_size()
                            _draw_bottom_prompt_line(prompt, "".join(buf), cursor_pos, cols, rows)
                    elif b2 == ord("C"):  # Right arrow
                        if cursor_pos < len(buf):
                            cursor_pos += 1
                            cols, rows = theme.term_size()
                            _draw_bottom_prompt_line(prompt, "".join(buf), cursor_pos, cols, rows)
                    elif b2 == ord("D"):  # Left arrow
                        if cursor_pos > 0:
                            cursor_pos -= 1
                            cols, rows = theme.term_size()
                            _draw_bottom_prompt_line(prompt, "".join(buf), cursor_pos, cols, rows)
                    elif b2 == ord("H"):  # Home
                        cursor_pos = 0
                        cols, rows = theme.term_size()
                        _draw_bottom_prompt_line(prompt, "".join(buf), cursor_pos, cols, rows)
                    elif b2 == ord("F"):  # End
                        cursor_pos = len(buf)
                        cols, rows = theme.term_size()
                        _draw_bottom_prompt_line(prompt, "".join(buf), cursor_pos, cols, rows)
                    elif b2 == ord("3"):  # Delete (\x1b[3~)
                        _ = _read_next_tty_byte(fd, timeout_s=0.02)
                        if cursor_pos < len(buf):
                            buf.pop(cursor_pos)
                            cols, rows = theme.term_size()
                            _draw_bottom_prompt_line(prompt, "".join(buf), cursor_pos, cols, rows)
                continue

            if b >= 32:
                raw_bytes = bytearray([b])
                if b >= 0xC0:
                    needed = 1 if b < 0xE0 else (2 if b < 0xF0 else 3)
                    for _ in range(needed):
                        nb = _read_next_tty_byte(fd, timeout_s=0.02)
                        if nb is not None and nb >= 0:
                            raw_bytes.append(nb)
                ch = raw_bytes.decode("utf-8", errors="replace")
                buf.insert(cursor_pos, ch)
                cursor_pos += len(ch)
                cols, rows = theme.term_size()
                _draw_bottom_prompt_line(prompt, "".join(buf), cursor_pos, cols, rows)
    finally:
        try:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)
        except Exception:
            pass


def _read_masked_password(prompt: str, theme: ThemeEngine | None = None) -> str:
    """Read a password from sys.stdin with terminal echo disabled, always restoring termios state."""
    if not is_interactive_tty():
        sys.stdout.write(prompt)
        sys.stdout.flush()
        line = sys.stdin.readline()
        sys.stdout.write("\n")
        sys.stdout.flush()
        return line.rstrip("\r\n")
    t = theme or ThemeEngine("plain")
    cols, rows = t.term_size()
    _draw_bottom_prompt_line(prompt, "", 0, cols, rows)
    fd = sys.stdin.fileno()
    old_attrs = termios.tcgetattr(fd)
    new_attrs = list(old_attrs)
    new_attrs[3] = new_attrs[3] & ~(termios.ICANON | termios.ECHO | termios.ISIG)
    new_attrs[6] = list(old_attrs[6])
    new_attrs[6][termios.VMIN] = 1
    new_attrs[6][termios.VTIME] = 0
    chars: list[str] = []
    try:
        termios.tcsetattr(fd, termios.TCSADRAIN, new_attrs)
        while True:
            b = _read_next_tty_byte(fd, timeout_s=0.15)
            if b is None:
                continue
            if b == -1:
                raise EOFError
            if b == 3:
                raise KeyboardInterrupt
            if b in (10, 13):
                if b == 13 and _TTY_RX_BUF and _TTY_RX_BUF[0] == 10:
                    _TTY_RX_BUF.pop(0)
                return "".join(chars)
            if b in (127, 8):
                if chars:
                    chars.pop()
                continue
            if b >= 32:
                chars.append(chr(b))
    finally:
        try:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)
        except Exception:
            pass


